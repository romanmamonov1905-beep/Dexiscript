ExtraState.Extras.UpdateMovementExtras = function(dt)
    local ex = ExtraState.Extras

    if Humanoid then
        if Config.Crouch then
            if Config.CrouchCamera then
                Humanoid.CameraOffset = Vector3.new(0, Config.CrouchOffset, 0)
            end
            Humanoid.HipHeight = math.max(0, Config.HipHeight - 0.8)
        elseif not Config.NoCameraBob then
            Humanoid.HipHeight = Config.HipHeight
        end

        if Config.FastFall and Humanoid:GetState() == Enum.HumanoidStateType.Freefall and Root then
            local v = Root.AssemblyLinearVelocity
            if v.Y > -Config.FastFallSpeed then
                Root.AssemblyLinearVelocity = Vector3.new(v.X, -Config.FastFallSpeed, v.Z)
            end
        end

        local grounded = Humanoid.FloorMaterial ~= Enum.Material.Air
        if Config.LandBoost and grounded and not ex.LastOnGround and Root then
            local dir = Humanoid.MoveDirection
            if dir.Magnitude > 0.05 then
                Root.AssemblyLinearVelocity += dir.Unit * Config.LandBoostPower
            end
        end
        ex.LastOnGround = grounded

        if Config.AirControl and not grounded and Root then
            local dir = Humanoid.MoveDirection
            if dir.Magnitude > 0.05 then
                local v = Root.AssemblyLinearVelocity
                local target = dir.Unit * math.max(v.Magnitude, Config.WalkSpeed)
                Root.AssemblyLinearVelocity = Vector3.new(
                    v.X + (target.X - v.X) * math.clamp(Config.AirControlStrength * dt * 8, 0, 1),
                    v.Y,
                    v.Z + (target.Z - v.Z) * math.clamp(Config.AirControlStrength * dt * 8, 0, 1)
                )
            end
        end

        if Config.StrafeAssist and Root then
            local dir = Humanoid.MoveDirection
            if dir.Magnitude > 0.05 then
                local v = Root.AssemblyLinearVelocity
                local target = dir.Unit * Config.WalkSpeed * Config.StrafeAssistStrength
                Root.AssemblyLinearVelocity = Vector3.new(
                    v.X + (target.X - v.X) * math.clamp(dt * 5, 0, 1),
                    v.Y,
                    v.Z + (target.Z - v.Z) * math.clamp(dt * 5, 0, 1)
                )
            end
        end

        if Config.AntiRagdoll then
            pcall(Humanoid.SetStateEnabled, Humanoid, Enum.HumanoidStateType.Ragdoll, false)
            pcall(Humanoid.SetStateEnabled, Humanoid, Enum.HumanoidStateType.FallingDown, false)
        else
            pcall(Humanoid.SetStateEnabled, Humanoid, Enum.HumanoidStateType.Ragdoll, true)
            pcall(Humanoid.SetStateEnabled, Humanoid, Enum.HumanoidStateType.FallingDown, true)
        end

        if Config.DisableClimbing then
            pcall(Humanoid.SetStateEnabled, Humanoid, Enum.HumanoidStateType.Climbing, false)
        else
            pcall(Humanoid.SetStateEnabled, Humanoid, Enum.HumanoidStateType.Climbing, true)
        end

        if Config.Crouch and Config.CrouchCamera then
            Humanoid.CameraOffset = Vector3.new(0, Config.CrouchOffset, 0)
        elseif Config.Crouch == false and not Config.NoCameraBob then
            Humanoid.CameraOffset = Vector3.zero
        end
    end

    if Config.LocalGravity then
        if ex.OriginalGravity == nil then
            ex.OriginalGravity = Workspace.Gravity
        end
        Workspace.Gravity = Config.GravityValue
    elseif ex.OriginalGravity ~= nil then
        Workspace.Gravity = ex.OriginalGravity
        ex.OriginalGravity = nil
    end
end

ExtraState.Extras.UpdateVisualExtras = function()
    local ex = ExtraState.Extras
    local now = os.clock()

    if not ex.ColorCorrection then
        ex.ColorCorrection = Instance.new("ColorCorrectionEffect")
        ex.ColorCorrection.Name = "DexiColorCorrection"
        ex.ColorCorrection.Parent = Lighting
    end

    ex.ColorCorrection.Saturation = Config.ColorSaturation
    ex.ColorCorrection.Contrast = Config.ColorContrast
    ex.ColorCorrection.Enabled = Config.ColorSaturation ~= 0 or Config.ColorContrast ~= 0

    if Config.AmbientBoost then
        if ex.OriginalAmbient == nil then
            ex.OriginalAmbient = Lighting.Ambient
            ex.OriginalOutdoorAmbient = Lighting.OutdoorAmbient
        end
        local strength = math.clamp(Config.AmbientStrength, 0, 2)
        local value = math.clamp(0.35 + strength * 0.25, 0, 1)
        Lighting.Ambient = Color3.new(value, value, value)
        Lighting.OutdoorAmbient = Color3.new(value, value, value)
    elseif ex.OriginalAmbient then
        Lighting.Ambient = ex.OriginalAmbient
        Lighting.OutdoorAmbient = ex.OriginalOutdoorAmbient
        ex.OriginalAmbient = nil
        ex.OriginalOutdoorAmbient = nil
    end

    if Config.DisablePostFX then
        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") and effect ~= ex.ColorCorrection then
                if ex.OriginalPostFX[effect] == nil then
                    ex.OriginalPostFX[effect] = effect.Enabled
                end
                effect.Enabled = false
            end
        end
    else
        for effect, oldEnabled in pairs(ex.OriginalPostFX) do
            if effect and effect.Parent then
                effect.Enabled = oldEnabled
            end
            ex.OriginalPostFX[effect] = nil
        end
    end

    if Config.RemoveParticles or Config.RemoveTrails then
        if now - ex.LastVisualSweep >= 0.35 then
            ex.LastVisualSweep = now
            for _, object in ipairs(Workspace:GetDescendants()) do
                if Config.RemoveParticles and object:IsA("ParticleEmitter") then
                    if ex.ParticleCache[object] == nil then
                        ex.ParticleCache[object] = object.Enabled
                    end
                    object.Enabled = false
                elseif Config.RemoveTrails and (object:IsA("Trail") or object:IsA("Beam")) then
                    if ex.TrailCache[object] == nil then
                        ex.TrailCache[object] = object.Enabled
                    end
                    object.Enabled = false
                end
            end
        end
    else
        for object, oldEnabled in pairs(ex.ParticleCache) do
            if object and object.Parent then object.Enabled = oldEnabled end
            ex.ParticleCache[object] = nil
        end
        for object, oldEnabled in pairs(ex.TrailCache) do
            if object and object.Parent then object.Enabled = oldEnabled end
            ex.TrailCache[object] = nil
        end
    end

    if not ex.TintFrame then
        ex.TintFrame = Instance.new("Frame")
        ex.TintFrame.Name = "ScreenTint"
        ex.TintFrame.Size = UDim2.fromScale(1, 1)
        ex.TintFrame.BackgroundColor3 = Theme.Accent
        ex.TintFrame.BorderSizePixel = 0
        ex.TintFrame.ZIndex = 8
        ex.TintFrame.Parent = Gui
    end
    ex.TintFrame.Visible = Config.ScreenTint
    ex.TintFrame.BackgroundTransparency = 1 - math.clamp(Config.ScreenTintStrength, 0, 0.95)

    crossUp.BackgroundColor3 = Config.RainbowCrosshair and Color3.fromHSV((os.clock() * 0.2) % 1, 0.8, 1) or Theme.Accent2
    crossDown.BackgroundColor3 = crossUp.BackgroundColor3
    crossLeft.BackgroundColor3 = crossUp.BackgroundColor3
    crossRight.BackgroundColor3 = crossUp.BackgroundColor3

    local function clearBillboardMap(map)
        for player, object in pairs(map) do
            if player == nil or object == nil or not object.Parent then
                if object then object:Destroy() end
                map[player] = nil
            end
        end
    end

    if not Config.HeadDots and not Config.HealthBars then
        for player, object in pairs(ex.HealthBars) do
            if object then object:Destroy() end
            ex.HealthBars[player] = nil
        end
        for player, object in pairs(ex.HeadDots) do
            if object then object:Destroy() end
            ex.HeadDots[player] = nil
        end
        return
    end

    if now - (ex.LastBillboardSweep or 0) >= 0.15 then
        ex.LastBillboardSweep = now
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                local head = character:FindFirstChild("Head")
                local humanoid = character:FindFirstChildOfClass("Humanoid")

                if Config.HeadDots and head then
                    local gui = ex.HeadDots[player]
                    if not gui or not gui.Parent or gui.Adornee ~= head then
                        if gui then gui:Destroy() end
                        gui = Instance.new("BillboardGui")
                        gui.Name = "DexiHeadDot"
                        gui.Size = UDim2.fromOffset(10, 10)
                        gui.StudsOffset = Vector3.new(0, 0.15, 0)
                        gui.AlwaysOnTop = true
                        gui.Adornee = head
                        gui.Parent = head
                        local dot = Instance.new("Frame")
                        dot.Size = UDim2.fromScale(1, 1)
                        dot.BackgroundColor3 = Theme.Accent2
                        dot.BorderSizePixel = 0
                        dot.Parent = gui
                        local corner = Instance.new("UICorner")
                        corner.CornerRadius = UDim.new(1, 0)
                        corner.Parent = dot
                        ex.HeadDots[player] = gui
                    end
                    local dot = gui:FindFirstChildOfClass("Frame")
                    if dot then dot.BackgroundColor3 = Config.RainbowESP and Color3.fromHSV((os.clock() * 0.12) % 1, 0.8, 1) or Theme.Accent2 end
                    gui.Enabled = Config.ESP and (not Config.ESPTeamCheck or player.Team ~= LocalPlayer.Team)
                elseif ex.HeadDots[player] then
                    ex.HeadDots[player].Enabled = false
                end

                if Config.HealthBars and head and humanoid then
                    local gui = ex.HealthBars[player]
                    if not gui or not gui.Parent or gui.Adornee ~= head then
                        if gui then gui:Destroy() end
                        gui = Instance.new("BillboardGui")
                        gui.Name = "DexiHealthBar"
                        gui.Size = UDim2.fromOffset(42, 6)
                        gui.StudsOffset = Vector3.new(0, 3.0, 0)
                        gui.AlwaysOnTop = true
                        gui.Adornee = head
                        gui.Parent = head
                        local bg = Instance.new("Frame")
                        bg.Name = "BG"
                        bg.Size = UDim2.fromScale(1, 1)
                        bg.BackgroundColor3 = Theme.Background
                        bg.BorderSizePixel = 0
                        bg.Parent = gui
                        local bgCorner = Instance.new("UICorner")
                        bgCorner.CornerRadius = UDim.new(0, 3)
                        bgCorner.Parent = bg
                        local fill = Instance.new("Frame")
                        fill.Name = "Fill"
                        fill.Size = UDim2.fromScale(1, 1)
                        fill.BackgroundColor3 = Theme.Green
                        fill.BorderSizePixel = 0
                        fill.Parent = bg
                        local fillCorner = Instance.new("UICorner")
                        fillCorner.CornerRadius = UDim.new(0, 3)
                        fillCorner.Parent = fill
                        ex.HealthBars[player] = gui
                    end
                    local bg = gui:FindFirstChild("BG")
                    local fill = bg and bg:FindFirstChild("Fill")
                    local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
                    if fill then
                        fill.Size = UDim2.fromScale(ratio, 1)
                        fill.BackgroundColor3 = Color3.fromRGB(
                            math.floor(255 * (1 - ratio)),
                            math.floor(220 * ratio),
                            80
                        )
                    end
                    gui.Enabled = Config.ESP and (not Config.ESPTeamCheck or player.Team ~= LocalPlayer.Team)
                elseif ex.HealthBars[player] then
                    ex.HealthBars[player].Enabled = false
                end
            end
        end
    end
end

ExtraState.Extras.UpdateCameraExtras = function(dt)
    local ex = ExtraState.Extras
    local camera = getCamera()
    if not camera then return end

    if Config.LockFirstPerson then
        if ex.OriginalCameraMode == nil then
            ex.OriginalCameraMode = LocalPlayer.CameraMode
        end
        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
    elseif ex.OriginalCameraMode ~= nil then
        LocalPlayer.CameraMode = ex.OriginalCameraMode
        ex.OriginalCameraMode = nil
    end

    if Config.DisableZoomLimits then
        if ex.OriginalZoom == nil then
            ex.OriginalZoom = {LocalPlayer.CameraMinZoomDistance, LocalPlayer.CameraMaxZoomDistance}
        end
        LocalPlayer.CameraMinZoomDistance = Config.ZoomMin
        LocalPlayer.CameraMaxZoomDistance = math.max(Config.ZoomMax, Config.ZoomMin)
    elseif ex.OriginalZoom then
        LocalPlayer.CameraMinZoomDistance = ex.OriginalZoom[1]
        LocalPlayer.CameraMaxZoomDistance = ex.OriginalZoom[2]
        ex.OriginalZoom = nil
    end

    if Config.ShoulderCamera and not Config.FreeCamera and not Config.OrbitCamera then
        camera.CFrame = camera.CFrame * CFrame.new(Config.ShoulderOffset, 0, 0)
    end

    if Config.CameraSmoothing and not Config.FreeCamera and not Config.OrbitCamera then
        if ex.CameraCFrame then
            local alpha = math.clamp(Config.CameraSmoothness, 0.02, 0.8)
            ex.CameraCFrame = ex.CameraCFrame:Lerp(camera.CFrame, alpha)
            camera.CFrame = ex.CameraCFrame
        else
            ex.CameraCFrame = camera.CFrame
        end
    else
        ex.CameraCFrame = camera.CFrame
    end

    if Config.AntiSeat and Humanoid and Humanoid.Sit then
        Humanoid.Sit = false
    end

    if Config.AutoUnequipTools and Humanoid then
        Humanoid:UnequipTools()
    end
end

