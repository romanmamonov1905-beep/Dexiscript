function ManageState(state, disable)
	local flags = ExtraState.Extras.StateFlags
	if disable and not flags[state] then
		flags[state] = true
		pcall(function()
			Humanoid:SetStateEnabled(state, false)
		end)
	elseif not disable and flags[state] then
		flags[state] = nil
