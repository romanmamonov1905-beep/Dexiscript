local function SelfDestruct()
	for _, c in pairs(Connections) do
		if type(c) == "table" then for _, v in ipairs(c) do v:Disconnect() end
		elseif c then c:Disconnect() end
	end
	local hrp, hum = GetRoot(), GetHum()
	if hrp and hrp:FindFirstChild("DexiFly") then hrp.DexiFly:Destroy() end
	if hrp and hrp:FindFirstChild("DexiSpin") then hrp.DexiSpin:Destroy() end
	if hum then hum.PlatformStand = false end
	Lighting.Ambient = Color3.fromRGB(128, 128, 128)
	ScreenGui:Destroy()
end

