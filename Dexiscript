--============================================================

local TracerGui = Instance.new("Frame")
TracerGui.Name = "Tracers"
TracerGui.Size = UDim2.fromScale(1, 1)
TracerGui.BackgroundTransparency = 1
TracerGui.Parent = Gui

local function UpdateTracers()
    if not Config.ESP or not Config.ESPTracers then
        for _, line in pairs(Tracers) do
            line.Visible = false
        end

        return
    end

    local viewport = Camera.ViewportSize

    local startPoint =
        Vector2.new(
            viewport.X / 2,
            viewport.Y
        )

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not Tracers[player] then
                local line = Instance.new("Frame")
                line.Name = "Tracer"
                line.AnchorPoint =
                    Vector2.new(0, 0.5)
                line.BackgroundColor3 =
                    Theme.Accent2
                line.BorderSizePixel = 0
                line.Visible = false
                line.Parent = TracerGui

                Tracers[player] = line
            end

            local line = Tracers[player]

            local character = player.Character

            local targetRoot =
                character
                and character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if targetRoot and Root then
                local distance =
                    (
                        Root.Position -
                        targetRoot.Position
                    ).Magnitude

                local point, visible =
                    Camera:WorldToViewportPoint(
                        targetRoot.Position
                    )

                if visible
                    and distance <=
                        Config.ESPMaxDistance
                then
                    local endPoint =
                        Vector2.new(
                            point.X,
                            point.Y
                        )

                    local delta =
                        endPoint -
                        startPoint

                    line.Position =
                        UDim2.fromOffset(
                            startPoint.X,
                            startPoint.Y
                        )

                    line.Size =
                        UDim2.fromOffset(
                            delta.Magnitude,
                            2
                        )

                    line.Rotation =
                        math.deg(
                            math.atan2(
                                delta.Y,
                                delta.X
                            )
                        )

                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        end
    end
end

