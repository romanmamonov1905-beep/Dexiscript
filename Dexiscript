RunService.RenderStepped:Connect(function(dt)
    FrameCounter += 1

    local now = os.clock()

    if now - LastFPSUpdate >= 1 then
        FPS = FrameCounter
        FrameCounter = 0
        LastFPSUpdate = now
    end

    if Humanoid then
        Humanoid.JumpPower =
            Config.JumpPower

        Humanoid.HipHeight =
            Config.HipHeight

        Humanoid.AutoRotate =
            Config.AutoRotate

        Humanoid.PlatformStand =
            Config.PlatformStand

        if not Config.Fly then
            Humanoid.WalkSpeed =
                Config.WalkSpeed
        end

        Humanoid:SetAttribute(
            "DexiAnimationSpeed",
            Config.AnimationSpeed
        )
    end

    if Config.FreezeCharacter
        and Root
    then
        Root.AssemblyLinearVelocity =
            Vector3.zero
        Root.AssemblyAngularVelocity =
            Vector3.zero
    end

    UpdateFly()
    UpdateNoclip()
    UpdateBunnyHop()
    UpdateAutoJump()
    UpdateGlide()
    UpdateHover()
    UpdateAirWalk()
    UpdateSpinBot(dt)
    UpdateAim()
    UpdateAutoFire()

    if Config.TargetFling then
        if not IsValidTargetPlayer(SelectedTarget) then
            Config.TargetFling = false
        else
            -- Repeated local ram while Target Fling is enabled.
            LocalTargetFling()
        end
    end

    UpdateWorld()
    UpdateLocalInvisible()
    UpdateCrosshair()
    UpdateFreeCamera(dt)
    UpdateOrbitCamera(dt)
    UpdateRadar()

    if now % 0.1 < dt then
        pcall(UpdateESP)
        pcall(UpdateTracers)
    end

    if now % 0.2 < dt then
        pcall(UpdateHomeInfo)
        pcall(UpdateActiveInfo)
        pcall(UpdateCharacterInfo)
        pcall(UpdateWaypoints)
        pcall(UpdateDebugInfo)
    end
end)

