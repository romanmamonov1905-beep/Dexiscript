	IsKeyboardDevice = UIS.KeyboardEnabled
	IsGamepadDevice = UIS.GamepadEnabled

	if IsTouchDevice and not IsKeyboardDevice then
		DeviceMode = "Mobile"
	elseif IsTouchDevice and IsKeyboardDevice then
		DeviceMode = "Tablet"
	elseif IsGamepadDevice and not IsKeyboardDevice then
		DeviceMode = "Controller"
	else
		DeviceMode = "PC"
	end
end

