	Root = character:WaitForChild("HumanoidRootPart")

	Humanoid.WalkSpeed = Config.WalkSpeed
	Humanoid.JumpPower = Config.JumpPower
	Humanoid.HipHeight = Config.HipHeight
	Humanoid.AutoRotate = Config.AutoRotate
end

