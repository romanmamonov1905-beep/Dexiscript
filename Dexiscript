TargetButton = nil

function RefreshTargetMenu()
    if not TargetMenu then
        return
    end

    local list = TargetMenu:FindFirstChild("PlayerList")
    if not list then
        return
    end

    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextButton")
            or child:IsA("TextLabel")
        then
            child:Destroy()
        end
    end

    local players = GetPlayerList()

    if #players == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -4, 0, 28)
        empty.BackgroundTransparency = 1
        empty.Text = "No other players"
        empty.TextColor3 = Theme.Muted
        empty.Font = Enum.Font.GothamMedium
        empty.TextSize = 8
        empty.ZIndex = 52
        empty.Parent = list
        return
    end

    for index, player in ipairs(players) do
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, -4, 0, 28)
        row.BackgroundColor3 = Theme.Card
        row.BorderSizePixel = 0
        row.AutoButtonColor = false
        row.Text =
            player.Name
            .. "  ["
            .. player.DisplayName
            .. "]"
        row.TextColor3 =
            player == SelectedTarget
            and Theme.Accent2
            or Theme.Text
        row.Font = Enum.Font.GothamMedium
        row.TextSize = 8
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.LayoutOrder = index
        row.ZIndex = 52
        row.Parent = list

        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 8)
        pad.Parent = row

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = row

        row.MouseEnter:Connect(function()
            row.BackgroundColor3 = Theme.CardHover
        end)

        row.MouseLeave:Connect(function()
            row.BackgroundColor3 = Theme.Card
        end)

        row.MouseButton1Click:Connect(function()
            SelectedTarget = player

            TargetButton.Text =
                "[TARGET]  " ..
                SelectedTargetText()

            TargetMenu.Visible = false

            Notify(
                "Target",
                "Selected " .. player.Name,
                2
            )
        end)
    end

    local layout =
        list:FindFirstChildOfClass("UIListLayout")

    if layout then
        list.CanvasSize = UDim2.fromOffset(
            0,
            layout.AbsoluteContentSize.Y + 5
        )
    end
end

function CreateTargetMenu()
