local function RemoveESP(playerName)
	if Db.EspCache[playerName] then
		Db.EspCache[playerName]:Destroy()
		Db.EspCache[playerName] = nil
	end

	if Db.BoxCache[playerName] then
		Db.BoxCache[playerName]:Destroy()
		Db.BoxCache[playerName] = nil
	end

	if Db.LinesCache[playerName] then
		Db.LinesCache[playerName]:Destroy()
		Db.LinesCache[playerName] = nil
	end
end

local function RenderVisuals(player)
	if player == LocalPlayer then
		return
	end

	RemoveESP(player.Name)

	local function Init(character)
		if not Db.States.EspCore then
			return
		end

		local head = character:FindFirstChild("Head")

		if not head then
			head = character:WaitForChild("Head", 5)
		end

		if not head then
			return
		end

		if not Db.States.EspCore then
			return
		end

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "DexiOverEsp"
		billboard.Adornee = head
		billboard.Size = UDim2.new(0, 150, 0, 50)
		billboard.AlwaysOnTop = true
		billboard.Parent = head

		local label = Instance.new("TextLabel")
		label.Parent = billboard
		label.Size = UDim2.new(1, 0, 0, 20)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(155, 65, 255)
		label.Font = Enum.Font.GothamBold
		label.TextSize = 10

		local healthBackground = Instance.new("Frame")
		healthBackground.Parent = billboard
		healthBackground.Size = UDim2.new(0, 80, 0, 4)
		healthBackground.Position = UDim2.new(0.5, -40, 0, 22)
		healthBackground.BackgroundColor3 = Color3.fromRGB(30, 15, 35)
		healthBackground.BorderSizePixel = 0

		local healthFill = Instance.new("Frame")
		healthFill.Parent = healthBackground
		healthFill.Size = UDim2.new(1, 0, 1, 0)
		healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
		healthFill.BorderSizePixel = 0

		Db.EspCache[player.Name] = billboard

		local boxFrame = Instance.new("Frame")
		boxFrame.Name = "DexiESPBox"
		boxFrame.Parent = OverlayGui
		boxFrame.BackgroundTransparency = 1
		boxFrame.BorderSizePixel = 0
		boxFrame.Visible = false

		local boxStroke = Instance.new("UIStroke")
		boxStroke.Parent = boxFrame
		boxStroke.Color = Color3.fromRGB(140, 40, 255)
		boxStroke.Thickness = 1

		Db.BoxCache[player.Name] = boxFrame

		local lineFrame = Instance.new("Frame")
		lineFrame.Name = "DexiESPLine"
		lineFrame.Parent = OverlayGui
		lineFrame.BackgroundColor3 = Color3.fromRGB(140, 40, 255)
		lineFrame.BorderSizePixel = 0
		lineFrame.AnchorPoint = Vector2.new(0.5, 0.5)
		lineFrame.Visible = false

		Db.LinesCache[player.Name] = lineFrame

		local connection

		connection = RunService.RenderStepped:Connect(function()
			if Destroyed then
				connection:Disconnect()
				return
			end

			if not Db.States.EspCore
				or not character.Parent
				or not character:FindFirstChildOfClass("Humanoid") then

				connection:Disconnect()
				RemoveESP(player.Name)
				return
			end

			local root = character:FindFirstChild("HumanoidRootPart")
			local localRoot = GetRoot()
			local humanoid = character:FindFirstChildOfClass("Humanoid")

			if not root or not localRoot then
				return
			end

			local distance = math.floor(
				(root.Position - localRoot.Position).Magnitude
			)

			if distance > Db.SliderValues.EspDistance then
				billboard.Enabled = false
				boxFrame.Visible = false
				lineFrame.Visible = false
				return
			end

			billboard.Enabled = true

			label.Text = string.format(
				"%s (%dm)",
				player.Name,
				distance
			)

			local healthPercent = 0

			if humanoid.MaxHealth > 0 then
				healthPercent = math.clamp(
					humanoid.Health / humanoid.MaxHealth,
					0,
					1
				)
			end

			healthFill.Size = UDim2.new(
				healthPercent,
				0,
				1,
				0
			)

			local rootPosition, onScreen = Camera:WorldToViewportPoint(
				root.Position
			)

			if onScreen and rootPosition.Z > 0 and Db.States.EspBox then
				local sizeX = math.clamp(2000 / rootPosition.Z, 20, 500)
				local sizeY = math.clamp(3500 / rootPosition.Z, 30, 700)

				boxFrame.Size = UDim2.new(0, sizeX, 0, sizeY)
				boxFrame.Position = UDim2.new(
					0,
					rootPosition.X - sizeX / 2,
					0,
					rootPosition.Y - sizeY / 2
				)

				boxFrame.Visible = true
			else
				boxFrame.Visible = false
			end

			if onScreen and rootPosition.Z > 0 and Db.States.EspLines then
				local startX = Camera.ViewportSize.X / 2
				local startY = Camera.ViewportSize.Y

				local endX = rootPosition.X
				local endY = rootPosition.Y

				local deltaX = endX - startX
				local deltaY = endY - startY

				local lineLength = math.sqrt(
					deltaX * deltaX + deltaY * deltaY
				)

				lineFrame.Size = UDim2.new(
					0,
					lineLength,
					0,
					1
				)

				lineFrame.Position = UDim2.new(
					0,
					(startX + endX) / 2,
					0,
					(startY + endY) / 2
				)

				lineFrame.Rotation = math.deg(
					math.atan2(deltaY, deltaX)
				)

				lineFrame.Visible = true
			else
				lineFrame.Visible = false
			end
		end)

		Db.Connections["ESP_" .. player.Name] = connection
	end

	if player.Character then
		task.spawn(Init, player.Character)
	end

	local characterConnection

	characterConnection = player.CharacterAdded:Connect(function(character)
		if Db.States.EspCore then
			task.spawn(Init, character)
		end
	end)

	Db.Connections["ESPCharacter_" .. player.Name] = characterConnection
end

