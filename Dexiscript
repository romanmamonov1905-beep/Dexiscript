-- NOTIFICATIONS
--============================================================

local function Notify(title, message, duration)
	if not Config.Notifications then
		return
	end

	if not UINotifications then
		return
	end

	local box = Instance.new("Frame")
	box.Size = UDim2.fromOffset(270, 58)
	box.BackgroundColor3 = Theme.Card
	box.BorderSizePixel = 0
	box.LayoutOrder = os.clock() * 100
	box.Parent = UINotifications

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = box

	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Accent
	stroke.Thickness = 1
	stroke.Parent = box

	local titleLabel = Instance.new("TextLabel")
	titleLabel.BackgroundTransparency = 1
	titleLabel.Position = UDim2.fromOffset(10, 6)
	titleLabel.Size = UDim2.new(1, -20, 0, 17)
	titleLabel.Text = title
	titleLabel.TextColor3 = Theme.Accent2
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 11
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = box

	local messageLabel = Instance.new("TextLabel")
	messageLabel.BackgroundTransparency = 1
	messageLabel.Position = UDim2.fromOffset(10, 24)
	messageLabel.Size = UDim2.new(1, -20, 0, 28)
	messageLabel.Text = message
	messageLabel.TextColor3 = Theme.Muted
	messageLabel.Font = Enum.Font.Gotham
	messageLabel.TextSize = 9
	messageLabel.TextWrapped = true
	messageLabel.TextXAlignment = Enum.TextXAlignment.Left
	messageLabel.Parent = box

	task.delay(duration or 3, function()
		if box and box.Parent then
			box:Destroy()
		end
	end)
end

