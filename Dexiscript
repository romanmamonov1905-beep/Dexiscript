local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()

local Window = Library.CreateLib("Dexi | Lucky Blocks Battleground", "Ocean")

--MAIN--
local Main = Window.NewTab("Main")
local Section = Main:NewSection("Player")

-- Слайдер для изменения скорости ( WalkSpeed )
-- Параметры: Название, Описание, Максимум, Минимум, Функция
Section:NewSlider("Player Speed", "Adjust your movement speed", 750, 16, function(value)
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    humanoid.WalkSpeed = value
    print("Speed changed to: " .. tostring(value))
end)

-- Слайдер для изменения силы прыжка ( JumpPower )
Section:NewSlider("Player Jump Power", "Adjust your jump power", 500, 50, function(value)
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    -- Включаем использование JumpPower, если в игре использовался JumpHeight
    humanoid.UseJumpPower = true 
    humanoid.JumpPower = value
    print("Jump Power changed to: " .. tostring(value))
end)

Section:NewButton("Fling|(K)", "Spin with 12000% power", function()
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")

	local player = Players.LocalPlayer

	local rotating = false
	local speed = 24000 -- градусов в секунду

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end

		if input.KeyCode == Enum.KeyCode.K then
			rotating = not rotating
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if not rotating then return end

		local character = player.Character
			if not character then return end
	
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root then return end

		root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(speed) * dt, 0)
	end)
end)
Section:NewButton("Inf Jumps", "Jump while mid air", function()
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")

	local player = Players.LocalPlayer

	-- Меняй это значение из своего GUI:
	local infiniteJump = true

	UserInputService.JumpRequest:Connect(function()
		if not infiniteJump then
			return
		end

		local character = player.Character
		if not character then return end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
end)
Section:NewButton("Teleport|(V)", "Teleports you in your direction", function()
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")

	local player = Players.LocalPlayer
	local distance = 25

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end

		if input.KeyCode == Enum.KeyCode.V then
			local character = player.Character
			if not character then return end

			local root = character:FindFirstChild("HumanoidRootPart")
			if not root then return end

			root.CFrame = root.CFrame + root.CFrame.LookVector * distance
		end
	end)
end)

Section:NewDropdown("Lucky Block Spawner", "Spawns Lucky Blocks (NOT VISUALS)", {"SpawnLuckyBlock", "SpawnSuperBlock", "SpawnDiamondBlock", "SpawnRainbowBlock", "SpawnGalaxyBlock"}, function(currentOption)
    local Event = game:GetService("ReplicatedStorage")[currentOption]:FireServer()
    Event:FireServer()
end)


--Visual--
local Main = Window.NewTab("Visuals")
local Section = Main:NewSection("Main Visuals")

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")

	local localPlayer = Players.LocalPlayer
	
	-- Создаем или находим скрытую техническую папку в Workspace для хранения кубов нашего ESP
	local espFolder = workspace:FindFirstChild("Dexi_PlayerESP_Folder")
	if not espFolder then
		espFolder = Instance.new("Folder")
		espFolder.Name = "Dexi_PlayerESP_Folder"
		espFolder.Parent = workspace
	end

	-- Переменная для контроля бесконечного цикла (должна быть строго СНАРУЖИ тумблера)
	local playerEspConnection = nil 

	-- Создаем тумблер в Kavo UI
	Section:NewToggle("Player ESP", "Toggle red parts on players", function(state)
		if state then
			-- === КОД ВКЛЮЧЕНИЯ ===
			if playerEspConnection then
				playerEspConnection:Disconnect()
				playerEspConnection = nil
			end

			-- Запускаем цикл отрисовки
			playerEspConnection = RunService.RenderStepped:Connect(function()
				for _, targetPlayer in pairs(Players:GetPlayers()) do
					if targetPlayer ~= localPlayer and targetPlayer.Character then
						local character = targetPlayer.Character
						local rootPart = character:FindFirstChild("HumanoidRootPart")
						
						if rootPart and rootPart:IsA("BasePart") then
							-- Ищем куб по уникальному имени (имя игрока + суффикс) внутри нашей изолированной папки
							local espPart = espFolder:FindFirstChild(targetPlayer.Name .. "_ESP")
							
							if not espPart then
								-- Создаем красный неоновый блок
								espPart = Instance.new("Part")
								espPart.Name = targetPlayer.Name .. "_ESP"
								espPart.Size = Vector3.new(4, 6, 4) -- Полностью покрывает хитбокс
								espPart.Color = Color3.fromRGB(255, 0, 0)
								espPart.Transparency = 0.5
								espPart.Material = Enum.Material.Neon
								
								-- Строгие настройки физики, чтобы блоки не падали и не толкались
								espPart.CanCollide = false
								espPart.Anchored = true
								espPart.CastShadow = false
								
								espPart.Parent = espFolder
							end
							
							-- Привязываем координаты куба к позиции игрока
							espPart.CFrame = rootPart.CFrame
						end
					end
				end
				
				-- Авто-очистка: если игрок вышел с сервера, удаляем его куб из нашей папки
				for _, child in pairs(espFolder:GetChildren()) do
					local pName = child.Name:gsub("_ESP", "")
					if not Players:FindFirstChild(pName) then
						child:Destroy()
					end
				end
			end)
			print("Player ESP: АКТИВИРОВАН")
		else
			-- === КОД ВЫКЛЮЧЕНИЯ ===
			-- 1. Полностью разрываем и убиваем фоновый цикл в памяти
			if playerEspConnection then
				playerEspConnection:Disconnect()
				playerEspConnection = nil
			end

			-- 2. Мгновенно очищаем всю нашу изолированную папку (все кубы исчезнут разом)
			espFolder:ClearAllChildren()
			print("Player ESP: ДЕАКТИВИРОВАН И ОЧИЩЕН")
		end
	end)

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")

	local player = Players.LocalPlayer
	local invisibilityConnection = nil
	local cloneModel = nil

	-- Создаем тумблер (Toggle) в вашем Kavo UI
	Section:NewToggle("Invisibility", "Makes your character invisible to others", function(state)
		local character = player.Character
		if not character then return end
		
		local root = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid then return end

		if state then
			-- === КОД ВКЛЮЧЕНИЯ (state = true) ===
			-- Создаем локальный клон персонажа, чтобы вы видели себя
			character.Archivable = true
			cloneModel = character:Clone()
			cloneModel.Name = "LocalGhost"
			
			-- Делаем клон полупрозрачным призраком
			for _, part in pairs(cloneModel:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Transparency = 0.5
					part.CanCollide = false
				elseif part:IsA("Decal") then
					part.Transparency = 0.5
				end
			end
			
			cloneModel.Parent = workspace
			character.Archivable = false

			-- Прячем настоящий оригинал тела от других игроков на сервере
			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
					part.Transparency = 1
				elseif part:IsA("Decal") then
					part.Transparency = 1
				end
			end

			-- Синхронизируем движения призрака с вашим невидимым телом
			invisibilityConnection = RunService.RenderStepped:Connect(function()
				if character and cloneModel and root then
					local ghostRoot = cloneModel:FindFirstChild("HumanoidRootPart")
					if ghostRoot then
						ghostRoot.CFrame = root.CFrame
					end
				end
			end)
			print("Invisibility: ON")
		else
			-- === КОД ВЫКЛЮЧЕНИЯ (state = false) ===
			-- 1. Полностью останавливаем цикл синхронизации
			if invisibilityConnection then
				invisibilityConnection:Disconnect()
				invisibilityConnection = nil
			end

			-- 2. Удаляем клон-призрак с карты
			if cloneModel then
				cloneModel:Destroy()
				cloneModel = nil
			end

			-- 3. Возвращаем полную видимость вашему настоящему персонажу
			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Transparency = 0
				elseif part:IsA("Decal") then
					part.Transparency = 0
				end
			end
			
			-- Технический корень хитбокса всегда должен оставаться невидимым в Roblox
			if root then root.Transparency = 1 end
			print("Invisibility: OFF")
		end
	end)
