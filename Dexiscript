local function AddSlider(tab, name, minValue, maxValue, default, key, callback)
	local parent = Db.Tabs[tab]

	if not parent then
		warn("Dexi Hub: tab not found:", tab)
		return
	end

	local bg = Instance.new("Frame")
	bg.Parent = parent
	bg.Size = UDim2.new(1, -5, 0, 44)
	bg.BackgroundColor3 = Color3.fromRGB(25, 19, 35)

	local corner = Instance.new("UICorner")
	corner.Parent = bg
	corner.CornerRadius = UDim.new(0, 6)

	local label = Instance.new("TextLabel")
	label.Parent = bg
	label.Size = UDim2.new(1, -16, 0, 18)
	label.Position = UDim2.new(0, 8, 0, 2)
	label.BackgroundTransparency = 1
	label.Text = name .. ": " .. tostring(default)
	label.TextColor3 = Color3.fromRGB(170, 160, 180)
	label.Font = Enum.Font.GothamSemibold
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left

	local track = Instance.new("Frame")
	track.Parent = bg
	track.Size = UDim2.new(1, -16, 0, 4)
	track.Position = UDim2.new(0, 8, 0, 28)
	track.BackgroundColor3 = Color3.fromRGB(45, 35, 55)
	track.BorderSizePixel = 0

	local fillPercent = 0

	if maxValue ~= minValue then
		fillPercent = math.clamp(
			(default - minValue) / (maxValue - minValue),
			0,
			1
		)
	end

	local fill = Instance.new("Frame")
	fill.Parent = track
	fill.Size = UDim2.new(fillPercent, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(140, 40, 255)
	fill.BorderSizePixel = 0

	local dragging = false

	local function Update(input)
		local width = track.AbsoluteSize.X

		if width <= 0 then
			return
		end

		local relativeX = math.clamp(
			(input.Position.X - track.AbsolutePosition.X) / width,
			0,
			1
		)

		fill.Size = UDim2.new(relativeX, 0, 1, 0)

		local value = math.floor(
			minValue + (maxValue - minValue) * relativeX + 0.5
		)

		Db.SliderValues[key] = value
		label.Text = name .. ": " .. tostring(value)

		pcall(callback, value)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			Update(input)
		end
	end)

	track.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			Notify(name .. " -> " .. tostring(Db.SliderValues[key]))
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			Update(input)
		end
	end)

	Db.SliderValues[key] = default
end

