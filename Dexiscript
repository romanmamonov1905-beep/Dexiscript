function GetMouseTarget()
	local cam = getCamera()
	if not cam then
		return nil
	end

	local mouse = UIS:GetMouseLocation()
	local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)
	return Workspace:Raycast(ray.Origin, ray.Direction * 2000, CharacterRaycastParams())
end

function DoClickDelete()
	local result = GetMouseTarget()
	local part = result and result.Instance

	if not part or part:IsA("Terrain") then
		return
	end

	local model = part:FindFirstAncestorOfClass("Model")
	if model and Players:GetPlayerFromCharacter(model) then
		Notify("Click Delete", "Player characters cannot be deleted.", 2)
		return
	end

	table.insert(DeletedParts, {Part = part, Parent = part.Parent})
	part.Parent = nil
	Notify("Click Delete", "Removed " .. part.Name .. " (only for you).", 1.5)
end

function RestoreDeletedParts()
	local count = 0

	for index = #DeletedParts, 1, -1 do
		local entry = DeletedParts[index]
		local ok = pcall(function()
			entry.Part.Parent = entry.Parent
		end)
		if ok then
			count += 1
		end
		DeletedParts[index] = nil
	end

	Notify("Click Delete", "Restored " .. count .. " part(s).", 2)
end

