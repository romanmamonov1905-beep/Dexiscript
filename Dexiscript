    local clock = frame:FindFirstChild("Clock")
    local session = frame:FindFirstChild("Session")
    local players = frame:FindFirstChild("Players")
    local server = frame:FindFirstChild("Server")

    if Config.ClockOverlay and clock then
        clock.Text = os.date("%H:%M:%S")
