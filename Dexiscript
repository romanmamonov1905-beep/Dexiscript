        local speed = Root and Root.AssemblyLinearVelocity.Magnitude or 0
        local target = Config.FOV + math.clamp(speed * 0.05 * Config.DynamicFOVStrength, 0, 25)
        camera.FieldOfView = camera.FieldOfView + (target - camera.FieldOfView) * math.clamp(dt * 8, 0, 1)
    else
        camera.FieldOfView = Config.FOV
    end

    if Config.CameraTilt and Root then
        local side = camera.CFrame.RightVector:Dot(Root.AssemblyLinearVelocity)
        local tilt = math.clamp(-side * 0.01 * Config.CameraTiltStrength, -8, 8)
        camera.CFrame = camera.CFrame * CFrame.Angles(0, 0, math.rad(tilt))
    end
end

function UpdateExtraOverlay()
    local lines = {}

    if Config.WatermarkOverlay then
        table.insert(lines, "DEXI SCRIPT  |  LOCAL")
    end

    if Config.DeathCounterOverlay then
        table.insert(lines, "DEATHS       " .. tostring(ExtraState.DeathCount))
    end

    if Config.ToolInfoOverlay then
        local tool = Character and Character:FindFirstChildOfClass("Tool")
        table.insert(lines, "TOOL         " .. (tool and tool.Name or "None"))
    end

    if Config.ServerTimeOverlay then
        table.insert(lines, "TIME         " .. os.date("%H:%M:%S"))
    end

    if ExtraState.Extras.Diagnostics and ExtraState.Extras.Diagnostics ~= "" then
        for line in string.gmatch(ExtraState.Extras.Diagnostics, "[^\n]+") do
            table.insert(lines, line)
        end
    end

    ExtraOverlay.Visible = #lines > 0
    ExtraOverlay:ClearAllChildren()

    if #lines == 0 then
        return
    end

    local label = Instance.new("TextLabel")
    label.BackgroundColor3 = Theme.Window
    label.BackgroundTransparency = 0.12
    label.BorderSizePixel = 0
    label.Size = UDim2.fromOffset(250, 20 + (#lines * 17))
    label.Text = table.concat(lines, "\n")
    label.TextColor3 = Theme.Text
    label.Font = Enum.Font.Code
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.ZIndex = 11
    label.Parent = ExtraOverlay

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = label

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 9)
    padding.PaddingTop = UDim.new(0, 6)
    padding.Parent = label
end

function UpdateRespawnState()
    if not Humanoid then
        return
    end

    local dead = Humanoid.Health <= 0

    if dead and not ExtraState.LastCharacterWasDead then
        ExtraState.DeathCount += 1

        if Config.AutoRespawn then
            task.delay(0.15, function()
                if LocalPlayer and LocalPlayer.Character == Character then
                    LocalPlayer:LoadCharacter()
                end
            end)
        end
    end

    ExtraState.LastCharacterWasDead = dead
end


