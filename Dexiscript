function UpdateVisualExtras()
	local ex = ExtraState.Extras
	local now = os.clock()

	if not ex.ColorCorrection or not ex.ColorCorrection.Parent then
		ex.ColorCorrection = Instance.new("ColorCorrectionEffect")
		ex.ColorCorrection.Name = "DexiColorCorrection"
		ex.ColorCorrection.Parent = Lighting
	end

	ex.ColorCorrection.Saturation = Config.ColorSaturation
	ex.ColorCorrection.Contrast = Config.ColorContrast
	ex.ColorCorrection.Enabled = Config.ColorSaturation ~= 0 or Config.ColorContrast ~= 0

	-- Particles and trails restore independently (before, turning off only
	-- one of the two toggles restored nothing).
	local function restore(cache)
		for object, oldEnabled in pairs(cache) do
			if object.Parent then
				object.Enabled = oldEnabled
			end
			cache[object] = nil
		end
	end

	if not Config.RemoveParticles then
		restore(ex.ParticleCache)
	end
	if not Config.RemoveTrails then
		restore(ex.TrailCache)
	end

	if (Config.RemoveParticles or Config.RemoveTrails) and now - ex.LastVisualSweep >= 1 then
		ex.LastVisualSweep = now
		for _, object in ipairs(Workspace:GetDescendants()) do
			if Config.RemoveParticles and object:IsA("ParticleEmitter") then
				if ex.ParticleCache[object] == nil then
					ex.ParticleCache[object] = object.Enabled
				end
				object.Enabled = false
			elseif Config.RemoveTrails and (object:IsA("Trail") or object:IsA("Beam")) then
				if ex.TrailCache[object] == nil then
					ex.TrailCache[object] = object.Enabled
				end
				object.Enabled = false
			end
		end
	end

	if not ex.TintFrame then
		ex.TintFrame = Instance.new("Frame")
		ex.TintFrame.Name = "ScreenTint"
		ex.TintFrame.Size = UDim2.fromScale(1, 1)
		ex.TintFrame.BackgroundColor3 = Theme.Accent
		ex.TintFrame.BorderSizePixel = 0
		ex.TintFrame.Active = false
		ex.TintFrame.ZIndex = 1
		ex.TintFrame.Parent = Gui
	end
	ex.TintFrame.Visible = Config.ScreenTint
	ex.TintFrame.BackgroundTransparency = 1 - math.clamp(Config.ScreenTintStrength, 0, 0.95)

	if not Config.HeadDots then
		for player, object in pairs(ex.HeadDots) do
			object:Destroy()
			ex.HeadDots[player] = nil
		end
		return
	end

	if now - ex.LastBillboardSweep < 0.15 then
		return
	end
	ex.LastBillboardSweep = now

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local character = player.Character
			local head = character:FindFirstChild("Head")
			-- Previously used "player.Team ~= LocalPlayer.Team", which hid
			-- everyone in games without teams (nil == nil).
			local shown = not IsTeamBlocked(player)

			if head then
				local gui = ex.HeadDots[player]
				if not gui or not gui.Parent or gui.Adornee ~= head then
					if gui then
						gui:Destroy()
					end
					gui = Instance.new("BillboardGui")
					gui.Name = "DexiHeadDot"
					gui.Size = UDim2.fromOffset(10, 10)
					gui.StudsOffset = Vector3.new(0, 0.15, 0)
					gui.AlwaysOnTop = true
					gui.Adornee = head
					gui.Parent = head

					local dot = Instance.new("Frame")
					dot.Size = UDim2.fromScale(1, 1)
					dot.BackgroundColor3 = Theme.Accent2
					dot.BorderSizePixel = 0
					dot.Parent = gui

					local corner = Instance.new("UICorner")
					corner.CornerRadius = UDim.new(1, 0)
					corner.Parent = dot

					ex.HeadDots[player] = gui
				end

				local dot = gui:FindFirstChildOfClass("Frame")
				if dot then
					dot.BackgroundColor3 = Config.RainbowESP
						and Color3.fromHSV((os.clock() * 0.12) % 1, 0.8, 1)
						or Theme.Accent2
				end
				gui.Enabled = shown
			end
		end
	end
end

