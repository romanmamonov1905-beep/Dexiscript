local function Notify(message)
	if Destroyed then
		return
	end

	local Card = Instance.new("Frame")
	Card.Parent = NotifContainer
	Card.Size = UDim2.new(0, 0, 0, 38)
	Card.BackgroundColor3 = Color3.fromRGB(12, 8, 16)

	local CardCorner = Instance.new("UICorner")
	CardCorner.Parent = Card
	CardCorner.CornerRadius = UDim.new(0, 6)

	local CardStroke = Instance.new("UIStroke")
	CardStroke.Parent = Card
	CardStroke.Color = Color3.fromRGB(140, 40, 255)
	CardStroke.Thickness = 1
	CardStroke.Enabled = false

	local Text = Instance.new("TextLabel")
	Text.Parent = Card
	Text.Size = UDim2.new(1, -20, 1, 0)
	Text.Position = UDim2.new(0, 10, 0, 0)
	Text.BackgroundTransparency = 1
	Text.Text = tostring(message)
	Text.TextColor3 = Color3.fromRGB(225, 210, 255)
	Text.Font = Enum.Font.GothamMedium
	Text.TextSize = 11
	Text.TextXAlignment = Enum.TextXAlignment.Left
	Text.Visible = false

	TweenService:Create(
		Card,
		TweenInfo.new(0.25),
		{Size = UDim2.new(0, 280, 0, 38)}
	):Play()

	task.wait(0.05)

	if not Card.Parent then
		return
	end

	Text.Visible = true
	CardStroke.Enabled = true

	task.spawn(function()
		task.wait(3.5)

		if Card and Card.Parent then
			Text.Visible = false
			CardStroke.Enabled = false

			local closeTween = TweenService:Create(
				Card,
				TweenInfo.new(0.2),
				{Size = UDim2.new(0, 0, 0, 0)}
			)

			closeTween:Play()
			closeTween.Completed:Wait()

			if Card then
				Card:Destroy()
			end
		end
	end)
end

