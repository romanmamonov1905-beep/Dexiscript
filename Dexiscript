-- ESP
--============================================================

ESP = {}

function DestroyESPObjects(data)
    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
        data.Highlight = nil
    end

    if data.Billboard then
        data.Billboard:Destroy()
        data.Billboard = nil
        data.Info = nil
    end
end

function GetESPAnchor(character)
    return character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChildWhichIsA("BasePart")
end

function GetESPData(player)
    local data = ESP[player]

    if not data then
        data = {
            Character = nil,
            Highlight = nil,
            Billboard = nil,
            Info = nil,
        }
        ESP[player] = data
    end

    return data
end

function EnsureESPObjects(player, character)
    if player == LocalPlayer or not character then
        return nil
    end

    local data = GetESPData(player)

    if data.Character ~= character then
        DestroyESPObjects(data)
        data.Character = character
    end

    if not data.Highlight then
        local highlight = Instance.new("Highlight")
        highlight.Name = "DexiESP"
        highlight.FillColor = Theme.Accent
        highlight.OutlineColor = Theme.Accent2
        highlight.FillTransparency = 0.65
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = character
        highlight.Parent = character
        data.Highlight = highlight
    end

    local anchor = GetESPAnchor(character)

    if anchor and not data.Billboard then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "DexiInfo"
        billboard.Size = UDim2.fromOffset(160, 55)
        billboard.StudsOffset = Vector3.new(0, 3.3, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = Config.ESPMaxDistance
        billboard.Adornee = anchor
        billboard.Parent = anchor

        local info = Instance.new("TextLabel")
        info.Name = "Info"
        info.Size = UDim2.fromScale(1, 1)
        info.BackgroundTransparency = 1
        info.TextColor3 = Theme.Text
        info.TextStrokeTransparency = 0.2
        info.Font = Enum.Font.GothamBold
        info.TextSize = 9
        info.TextWrapped = true
        info.Parent = billboard

        data.Billboard = billboard
        data.Info = info
    elseif anchor and data.Billboard then
        data.Billboard.Adornee = anchor
        data.Billboard.Parent = anchor
        data.Billboard.MaxDistance = Config.ESPMaxDistance
    end

    return data
end

function RemoveESP(player)
    local data = ESP[player]

    if data then
        if data.CharacterConnection then
            data.CharacterConnection:Disconnect()
            data.CharacterConnection = nil
        end
        DestroyESPObjects(data)
        ESP[player] = nil
    end
end

function UpdateESPPlayer(player)
    if player == LocalPlayer then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local data = EnsureESPObjects(player, character)

    if not data then
        return
    end

    local teamBlocked =
        Config.ESPTeamCheck
        and LocalPlayer.Team
        and player.Team == LocalPlayer.Team

    -- Highlight stays active for the entire lifetime of the character.
    -- Distance only affects the text/tracer layer, so distant players
    -- remain visibly highlighted as requested.
    if data.Highlight then
        data.Highlight.Enabled =
            Config.ESP
            and not teamBlocked

        if Config.RainbowESP then
            data.Highlight.FillColor =
                Color3.fromHSV((os.clock() * 0.12) % 1, 0.80, 1)
            data.Highlight.OutlineColor =
                Color3.fromHSV((os.clock() * 0.12 + 0.15) % 1, 0.55, 1)
        else
            data.Highlight.FillColor = Theme.Accent
            data.Highlight.OutlineColor = Theme.Accent2
        end
    end

    local targetRoot =
        character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Head")
        or character:FindFirstChildWhichIsA("BasePart")

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not targetRoot or not Root then
        if data.Info then
            data.Info.Visible = false
        end
        return
    end

    local distance =
        (Root.Position - targetRoot.Position).Magnitude

    local inRange = distance <= Config.ESPMaxDistance

    if data.Info then
        local lines = {}

        if Config.ESPNames then
            table.insert(lines, player.DisplayName)
        end

        if Config.ESPDistance then
            table.insert(lines, math.floor(distance) .. " studs")
        end

        if Config.ESPHealth and humanoid then
            table.insert(
                lines,
                "HP " ..
                math.floor(humanoid.Health) ..
                "/" ..
                math.floor(humanoid.MaxHealth)
            )
        end

        data.Info.Text = table.concat(lines, "\n")
        data.Info.Visible =
            Config.ESP
            and not teamBlocked
            and inRange

        if data.Billboard then
            data.Billboard.MaxDistance = Config.ESPMaxDistance
        end
    end
end

function UpdateESP()
    if not Config.ESP then
        for player in pairs(ESP) do
            local data = ESP[player]
            if data then
                if data.Highlight then
                    data.Highlight.Enabled = false
                end
                if data.Info then
                    data.Info.Visible = false
                end
            end
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            UpdateESPPlayer(player)
        end
    end
end

function BindESPPlayer(player)
    if player == LocalPlayer then
        return
    end

    local data = GetESPData(player)

    if data.CharacterConnection then
        data.CharacterConnection:Disconnect()
        data.CharacterConnection = nil
    end

    data.CharacterConnection = player.CharacterAdded:Connect(function(character)
        -- Rebuild immediately and retry after the character has finished
        -- assembling its parts. This fixes ESP disappearing on respawn.
        task.defer(function()
            if not ESP[player] or player.Character ~= character then
                return
            end
            EnsureESPObjects(player, character)
        end)

        task.delay(0.15, function()
            if not ESP[player] or player.Character ~= character then
                return
            end
            EnsureESPObjects(player, character)
        end)
    end)

    if player.Character then
        EnsureESPObjects(player, player.Character)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        BindESPPlayer(player)
    end
end

Players.PlayerAdded:Connect(function(player)
    BindESPPlayer(player)
end)

Players.PlayerRemoving:Connect(function(player)
    RemoveESP(player)

    if Tracers[player] then
        Tracers[player]:Destroy()
        Tracers[player] = nil
    end
end)

