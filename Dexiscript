--============================================================

local function GetEquippedTool()
    if not Character then
        return nil
    end

    return Character:FindFirstChildOfClass("Tool")
end

local function UpdateAutoFire()
    if not Config.AutoFire then
        return
    end

    -- Auto Fire follows the active Aim Assist target.
    if not Config.AimAssist then
        return
    end

    if not CurrentTarget then
        return
    end

    if not IsValidTargetPlayer(CurrentTarget) then
        CurrentTarget = nil
        return
    end

    local tool = GetEquippedTool()

    if not tool then
        return
    end

    local now = os.clock()

    if now - LastAutoFire <
        Config.AutoFireDelay
    then
        return
    end

    -- Tool:Activate() is the local Tool activation API.
    -- Actual shooting/damage depends on how the experience's
    -- Tool is implemented; this does not call a server remote.
    pcall(function()
        tool:Activate()
    end)

    LastAutoFire = now
end

