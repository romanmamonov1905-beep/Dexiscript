    Character = character
    Humanoid = character:WaitForChild("Humanoid")
    Root = character:WaitForChild("HumanoidRootPart")

    Humanoid.WalkSpeed = Config.WalkSpeed
    Humanoid.JumpPower = Config.JumpPower
    Humanoid.HipHeight = Config.HipHeight
    Humanoid.AutoRotate = Config.AutoRotate
end

SetupCharacter(LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait())

LocalPlayer.CharacterAdded:Connect(function(character)
    task.wait(0.1)
    SetupCharacter(character)
    SavedCollision = {}
    SavedTransparency = {}
    ExtraState.SelfChamCache = {}
    ExtraState.LastCharacterWasDead = false
    ExtraState.PreviousOnGround = true

    if Config.RespawnAtSpawn and Root then
        task.delay(0.15, function()
            local spawn = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
            if spawn and Root and Character == character then
                Root.CFrame = spawn.CFrame + Vector3.new(0, 4, 0)
            end
        end)
    end

    ConnectTargetTouchFling(character)
end)

