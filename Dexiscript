local FreeCameraPosition
local FreeCameraRotation = Vector2.zero

local function StartFreeCamera()
	local camera = getCamera()

	FreeCameraPosition =
		camera.CFrame.Position

	local x, y, z =
		camera.CFrame:ToOrientation()

	FreeCameraRotation =
		Vector2.new(
			math.deg(y),
			math.deg(x)
		)

	camera.CameraType =
		Enum.CameraType.Scriptable
end

local function StopFreeCamera()
	local camera = getCamera()

	camera.CameraType =
		Enum.CameraType.Custom

	FreeCameraPosition = nil
end

local function UpdateFreeCamera(dt)
	if not Config.FreeCamera then
		if FreeCameraPosition then
			StopFreeCamera()
		end

		return
	end

	if not FreeCameraPosition then
		StartFreeCamera()
	end

	local camera = getCamera()

	local direction = Vector3.zero

	if UIS:IsKeyDown(Enum.KeyCode.W) then
		direction += camera.CFrame.LookVector
	end

	if UIS:IsKeyDown(Enum.KeyCode.S) then
		direction -= camera.CFrame.LookVector
	end

	if UIS:IsKeyDown(Enum.KeyCode.D) then
		direction += camera.CFrame.RightVector
	end

	if UIS:IsKeyDown(Enum.KeyCode.A) then
		direction -= camera.CFrame.RightVector
	end

	if UIS:IsKeyDown(Enum.KeyCode.Space) then
		direction += Vector3.yAxis
	end

	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
		direction -= Vector3.yAxis
	end

	if direction.Magnitude > 0 then
		direction = direction.Unit
	end

	local speed =
		Config.FreeCameraSpeed

	if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
		speed *= Config.FreeCameraBoost
	end

	FreeCameraPosition +=
		direction *
		speed *
		dt

	camera.CFrame =
		CFrame.new(
			FreeCameraPosition
		) *
		CFrame.Angles(
			math.rad(FreeCameraRotation.Y),
			math.rad(FreeCameraRotation.X),
			0
		)
end

local function UpdateOrbitCamera(dt)
	if not Config.OrbitCamera
		or not Root
	then
		return
	end

	local camera = getCamera()

	local center = Root.Position
	local radius = Config.CameraDistance

	local angle =
		os.clock() *
		math.rad(Config.OrbitSpeed)

	local offset =
		Vector3.new(
			math.cos(angle) * radius,
			radius * 0.4,
			math.sin(angle) * radius
		)

	camera.CFrame =
		CFrame.lookAt(
			center + offset,
			center
		)
end

