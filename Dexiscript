UIS.InputBegan:Connect(function(input, processed)
    -- Global GUI keybind capture ALWAYS gets first priority.
    -- The captured key is consumed and therefore cannot also
    -- open/close the panel during the same InputBegan event.
    if CapturingGlobalKeybind then
        if input.UserInputType ==
            Enum.UserInputType.Keyboard
        then
            if input.KeyCode ==
                Enum.KeyCode.Escape
            then
                CapturingGlobalKeybind = nil

                OpenKeyButton.Text =
                    "[KEY]  Open Key: " ..
                    Config.OpenKey.Name

                PanicKeyButton.Text =
                    "[PANIC]  Panic Key: " ..
                    Config.PanicKey.Name

                return
            end

            if CapturingGlobalKeybind ==
                "OpenKey"
            then
                Config.OpenKey = input.KeyCode
                MarkConfigDirty()

                OpenKeyButton.Text =
                    "[KEY]  Open Key: " ..
                    Config.OpenKey.Name

                CapturingGlobalKeybind = nil
                return
            end

            if CapturingGlobalKeybind ==
                "PanicKey"
            then
                Config.PanicKey = input.KeyCode
                MarkConfigDirty()

                PanicKeyButton.Text =
                    "[PANIC]  Panic Key: " ..
                    Config.PanicKey.Name

                CapturingGlobalKeybind = nil
                return
            end
        end

        return
    end

    -- Feature keybind capture uses its own dispatcher below.
    if CapturingKeybind then
        return
    end

    if processed then
        return
    end

    if input.UserInputType ==
        Enum.UserInputType.Keyboard
    then
        if input.KeyCode ==
            Config.OpenKey
        then
            Main.Visible =
                not Main.Visible
        end

        if input.KeyCode ==
            Config.PanicKey
        then
            Main.Visible = false
            AimCircle.Visible = false
            CrosshairGui.Visible = false
            Radar.Visible = false
        end
    end
end)

