function NormalizeSkyId(value)
	value = tostring(value or "")
	value = value:gsub("^%s+", ""):gsub("%s+$", "")

	if value == "" then
		return ""
	end

	local fromQuery = value:match("[?&]id=(%d+)")
	if fromQuery then
		return "rbxassetid://" .. fromQuery
	end

	local fromPath = value:match("/library/(%d+)") or value:match("/asset/(%d+)")
	if fromPath then
		return "rbxassetid://" .. fromPath
	end

	local numeric = value:match("^(%d+)$")
	if numeric then
		return "rbxassetid://" .. numeric
	end

	if value:match("^rbxassetid://") or value:match("^rbxasset://") then
		return value
	end

	return ""
end

SkyFaces = {"SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp"}

-- Every ID the user types is resolved once (in the background) into:
--   {Kind = "Image", Content = "rbxassetid://..."}  image, or decal -> its image
--   {Kind = "Sky", Faces = {...}, Props = {...}}     skybox model from the store
--   {Kind = "Error", Message = "..."}
SkyAssetCache = {}
SkyAssetLoading = {}

-- Sky settings copied from skybox models (besides the six faces).
SkyCopyProps = {
	"CelestialBodiesShown",
	"StarCount",
	"SunAngularSize",
	"MoonAngularSize",
	"SunTextureId",
	"MoonTextureId",
	"SkyboxOrientation",
}

ModelAssetTypes = {[10] = true, [32] = true} -- Model, Package

function GetAssetInfo(assetId)
	local ok, result = pcall(function()
		return game:GetService("MarketplaceService"):GetProductInfo(assetId, Enum.InfoType.Asset)
	end)
	return ok and result or nil
end

function ReadSkyObject(sky)
	local result = {Kind = "Sky", Faces = {}, Props = {}}

	for _, face in ipairs(SkyFaces) do
		result.Faces[face] = sky[face]
	end

	for _, property in ipairs(SkyCopyProps) do
		pcall(function()
			result.Props[property] = sky[property]
		end)
	end

	return result
end

-- Skybox library: ReplicatedStorage.DexiSkies holds Sky objects that were
-- imported in Studio (see DexiSkyImport.lua). A live game is not allowed to
-- load other creators' models, but anything saved in the place can be read
-- by the client. A Sky matches an ID by its AssetId attribute or its name
-- (the Sky's own name or the name of the model it is in).
function FindLibrarySky(key)
	local library = game:GetService("ReplicatedStorage"):FindFirstChild("DexiSkies")
	if not library then
		return nil
	end

	key = string.lower(tostring(key))

	for _, object in ipairs(library:GetDescendants()) do
		if object:IsA("Sky") then
			local holder = object.Parent ~= library and object.Parent or nil
			local tagged = object:GetAttribute("AssetId") or (holder and holder:GetAttribute("AssetId"))

			if (tagged and tostring(tagged) == key)
				or string.lower(object.Name) == key
				or (holder and string.lower(holder.Name) == key)
			then
				return object
			end
		end
	end

	return nil
end

-- Asks the DexiSkyServer script (ServerScriptService) to read the skybox
-- model. The server never parents the model anywhere; it only returns the
-- face IDs and sky settings, so the sky stays local to this player.
function LoadSkyFromServer(assetId)
	local remote = game:GetService("ReplicatedStorage"):FindFirstChild("DexiSkyLoader")
	if not remote or not remote:IsA("RemoteFunction") then
		return nil, nil
	end

	local ok, result = pcall(function()
		return remote:InvokeServer(assetId)
	end)

	if not ok or type(result) ~= "table" then
		return nil, "Sky server error: " .. tostring(result)
	end

	if result.Error then
		if result.NotAuthorized then
			return nil, "Roblox only lets a game load models owned by its creator. "
				.. "Import this skybox once in Studio with DexiSkyImport.lua."
		end
		return nil, tostring(result.Error)
	end

	if type(result.Faces) ~= "table" then
		return nil, "Sky server returned no faces."
	end

	return {Kind = "Sky", Faces = result.Faces, Props = result.Props or {}}
end

-- Toolbox skyboxes are Models with a Sky inside. A LocalScript in a live game
-- cannot load models by ID, so the sources are tried in order:
--   0. DexiSkies library      - skyboxes imported into the place in Studio
--   1. game:GetObjects        - executors, Studio command bar, plugins
--   2. DexiSkyServer remote   - only models owned by the game's creator
--   3. InsertService          - contexts that allow it
function LoadSkyFromModel(assetId)
	local librarySky = FindLibrarySky(assetId)
	if librarySky then
		return ReadSkyObject(librarySky)
	end

	local roots

	local ok = pcall(function()
		roots = game:GetObjects("rbxassetid://" .. assetId)
	end)

	if not ok or type(roots) ~= "table" or #roots == 0 then
		local sky, serverError = LoadSkyFromServer(assetId)
		if sky then
			return sky
		end
		if serverError then
			return nil, serverError
		end

		ok = pcall(function()
			roots = {game:GetService("InsertService"):LoadAsset(assetId)}
		end)
	end

	if not ok or type(roots) ~= "table" or #roots == 0 then
		return nil, "Can't load this skybox here. Import it once in Studio with DexiSkyImport.lua."
	end

	local result

	for _, root in ipairs(roots) do
		if typeof(root) == "Instance" then
			if not result then
				local sky = root:IsA("Sky") and root or root:FindFirstChildWhichIsA("Sky", true)
				if sky then
					result = ReadSkyObject(sky)
				end
			end
			root:Destroy()
		end
	end

	if not result then
		return nil, "Model " .. assetId .. " has no Sky object inside."
	end

	return result
end

-- A decal points to an image uploaded right before it by the same creator.
function FindDecalImage(decalId, decalInfo)
	local creatorId = decalInfo.Creator and decalInfo.Creator.Id

	for offset = 1, 25 do
		local candidate = GetAssetInfo(decalId - offset)
		if candidate
			and candidate.AssetTypeId == 1
			and (not creatorId or (candidate.Creator and candidate.Creator.Id == creatorId))
		then
			return decalId - offset
		end
	end

	return nil
end

-- Returns the asset table plus an optional message for the user.
function ResolveSkyAsset(assetId)
	local info = GetAssetInfo(assetId)

	if not info then
		-- Could not verify (network / rate limit / private asset). Try it as
		-- a skybox model first, then fall back to using it as an image.
		local sky = LoadSkyFromModel(assetId)
		if sky then
			return sky, "Loaded skybox model " .. assetId
		end
		return {Kind = "Image", Content = "rbxassetid://" .. assetId, Retry = true},
			"Could not verify ID " .. assetId .. ", trying it as an image."
	end

	local typeId = info.AssetTypeId

	if typeId == 1 then
		return {Kind = "Image", Content = "rbxassetid://" .. assetId}
	end

	if typeId == 13 then
		local imageId = FindDecalImage(assetId, info)
		if imageId then
			return {Kind = "Image", Content = "rbxassetid://" .. imageId},
				"Decal " .. assetId .. " -> image " .. imageId
		end
		return {Kind = "Image", Content = "rbxassetid://" .. (assetId - 1)},
			"Image for decal " .. assetId .. " not found, guessing " .. (assetId - 1)
	end

	if ModelAssetTypes[typeId] then
		local sky, err = LoadSkyFromModel(assetId)
		if sky then
			return sky, "Loaded skybox: " .. tostring(info.Name)
		end
		return {Kind = "Error", Message = err}, err
	end

	local message = "ID " .. assetId .. " is not an image, decal or skybox (asset type " .. tostring(typeId) .. ")."
	return {Kind = "Error", Message = message}, message
end

-- Returns "empty", "invalid", "loading", or "ok" plus the asset table.
function GetSkyAsset(raw)
	local content = NormalizeSkyId(raw)

	if content == "" then
		local text = string.match(tostring(raw or ""), "^%s*(.-)%s*$")
		if text == "" then
			return "empty"
		end

		-- Not an ID: maybe the name of a skybox in the DexiSkies library.
		local named = FindLibrarySky(text)
		if named then
			return "ok", ReadSkyObject(named)
		end
		return "invalid"
	end

	local assetId = tonumber(string.match(content, "^rbxassetid://(%d+)$"))
	if not assetId then
		return "ok", {Kind = "Image", Content = content} -- rbxasset:// path
	end

	-- The library is checked before the cache, so a skybox imported after
	-- a failed attempt works right away.
	local librarySky = FindLibrarySky(assetId)
	if librarySky then
		return "ok", ReadSkyObject(librarySky)
	end

	local cached = SkyAssetCache[assetId]
	if cached then
		return "ok", cached
	end

	if not SkyAssetLoading[assetId] then
		SkyAssetLoading[assetId] = true

		task.spawn(function()
			local ok, asset, message = pcall(ResolveSkyAsset, assetId)
			if not ok then
				asset = {Kind = "Error", Message = tostring(asset)}
				message = asset.Message
			end

			SkyAssetCache[assetId] = asset
			SkyAssetLoading[assetId] = nil
			SkyboxForceRefresh = true

			if message then
				Notify("Local Skybox", message, 4)
			end

			-- Unverified results and errors are retried later instead of
			-- being kept forever.
			if asset.Retry or asset.Kind == "Error" then
				task.delay(30, function()
					if SkyAssetCache[assetId] == asset then
						SkyAssetCache[assetId] = nil
					end
				end)
			end
		end)
	end

	return "loading"
end

function GetGameSky()
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") and child ~= CreatedSky then
			return child
		end
	end
	return nil
end

-- Changing the faces of a Sky that is already in Lighting does not reliably
-- redraw the skybox (that is why only the FIRST change used to show up).
-- Every new image therefore gets a brand-new Sky: it is built off-screen,
-- its textures are preloaded, and only then is it parented to Lighting.
-- While it is active, the game's own Sky objects are moved out of Lighting
-- (locally) so there is never more than one Sky competing.
StashedSkies = {}
CreatedSkyId = nil
PendingSkyId = nil

function StashGameSkies()
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") and child ~= CreatedSky then
			table.insert(StashedSkies, child)
			child.Parent = nil
		end
	end
end

function RestoreGameSkies()
	for _, sky in ipairs(StashedSkies) do
		pcall(function()
			sky.Parent = Lighting
		end)
	end
	table.clear(StashedSkies)
end

function DestroyCreatedSky()
	if CreatedSky then
		CreatedSky:Destroy()
	end
	CreatedSky = nil
	CreatedSkyId = nil
end

SkyFaceConfigKeys = {
	SkyboxUp = "SkyFaceUp",
	SkyboxDn = "SkyFaceDn",
	SkyboxFt = "SkyFaceFt",
	SkyboxBk = "SkyFaceBk",
	SkyboxLf = "SkyFaceLf",
	SkyboxRt = "SkyFaceRt",
}

-- Combines the main Sky ID, the per-face overrides and the sun/moon/stars
-- settings into one description of the sky.
-- Returns spec (or nil) plus a status note.
function GatherSkySpec()
	local spec = {Faces = {}, Props = {}}
	local loading = false
	local problem = nil

	local function use(raw, apply)
		local state, asset = GetSkyAsset(raw)
		if state == "loading" then
			loading = true
		elseif state == "invalid" then
			problem = problem or ("INVALID ID: " .. tostring(raw))
		elseif state == "ok" then
			if asset.Kind == "Error" then
				problem = problem or asset.Message
			else
				apply(asset)
			end
		end
	end

	-- Main ID: one image for all faces, or a whole skybox model.
	use(Config.SkyDecalId, function(asset)
		if asset.Kind == "Sky" then
			for face, value in pairs(asset.Faces) do
				spec.Faces[face] = value
			end
			for property, value in pairs(asset.Props) do
				spec.Props[property] = value
			end
		else
			for _, face in ipairs(SkyFaces) do
				spec.Faces[face] = asset.Content
			end
		end
	end)

	-- Per-face overrides (work everywhere, including plain LocalScripts).
	for _, face in ipairs(SkyFaces) do
		use(Config[SkyFaceConfigKeys[face]], function(asset)
			spec.Faces[face] = asset.Kind == "Sky" and asset.Faces[face] or asset.Content
		end)
	end

	if Config.SkyCustomCelestial then
		spec.Props.StarCount = Config.SkyStarCount
		spec.Props.SunAngularSize = Config.SkySunSize
		spec.Props.MoonAngularSize = Config.SkyMoonSize
		spec.Props.SkyboxOrientation = Vector3.new(0, Config.SkyRotation, 0)

		use(Config.SkySunTexture, function(asset)
			if asset.Kind == "Image" then
				spec.Props.SunTextureId = asset.Content
			end
		end)

		use(Config.SkyMoonTexture, function(asset)
			if asset.Kind == "Image" then
				spec.Props.MoonTextureId = asset.Content
			end
		end)
	end

	if loading then
		return nil, "LOADING..."
	end

	if not next(spec.Faces) and not next(spec.Props) then
		return nil, problem or "ENTER ID"
	end

	return spec, problem
end

-- Faces need a brand-new Sky to show up; other properties (stars, sun size,
-- rotation...) update live. So the rebuild key contains the face textures
-- and only the NAMES of the extra properties, not their values.
function SkySpecKey(spec)
	local parts = {}
	for _, face in ipairs(SkyFaces) do
		table.insert(parts, tostring(spec.Faces[face]))
	end

	local names = {}
	for property in pairs(spec.Props) do
		table.insert(names, property)
	end
	table.sort(names)

	for _, name in ipairs(names) do
		if name == "CelestialBodiesShown" then
			table.insert(parts, name .. "=" .. tostring(spec.Props[name]))
		else
			table.insert(parts, name)
		end
	end

	return table.concat(parts, "|")
end

function ApplySkyProps(sky, props)
	for property, value in pairs(props) do
		-- CelestialBodiesShown is set once at build time; afterwards it
		-- belongs to Hide Sun / Moon.
		if property ~= "CelestialBodiesShown" then
			pcall(function()
				if sky[property] ~= value then
					sky[property] = value
				end
			end)
		end
	end
end

function BuildSky(spec)
	-- Copy the game's sky settings (sun, moon, stars, faces not overridden).
	local template = StashedSkies[1] or GetGameSky()
	local sky = template and template:Clone() or nil
	if not sky then
		sky = Instance.new("Sky")
	elseif template then
		-- Use the game's real setting, not a value Hide Sun / Moon put there.
		sky.CelestialBodiesShown = GetOriginal(template, "CelestialBodiesShown") ~= false
	end

	sky.Name = "DexiSky"

	for face, value in pairs(spec.Faces) do
		sky[face] = value
	end

	if spec.Props.CelestialBodiesShown ~= nil then
		sky.CelestialBodiesShown = spec.Props.CelestialBodiesShown
	end
	ApplySkyProps(sky, spec.Props)

	return sky
end

function UpdateSkybox()
	local spec, note = nil, nil
	if Config.LocalSkybox then
		spec, note = GatherSkySpec()

		-- Keep showing the current sky while a new ID is being looked up.
		if not spec and note == "LOADING..." then
			SkyboxStatus = note
			return
		end
	end

	if not spec then
		PendingSkyId = nil
		if CreatedSkyId ~= "plain" then
			DestroyCreatedSky()
		end
		RestoreGameSkies()

		-- Hide Sun / Moon needs some Sky object; use a plain default one
		-- when the game has none.
		local needPlain = Config.HideCelestialBodies and not GetGameSky()
		if needPlain and not CreatedSky then
			CreatedSky = Instance.new("Sky")
			CreatedSky.Name = "DexiSky"
			CreatedSkyId = "plain"
			CreatedSky.Parent = Lighting
		elseif not needPlain and CreatedSky then
			DestroyCreatedSky()
		end

		SetManaged(CreatedSky or GetGameSky(), "CelestialBodiesShown", Config.HideCelestialBodies, false)
		SkyboxForceRefresh = false
		SkyboxStatus = Config.LocalSkybox and (note or "ENTER ID") or "OFF"
		return
	end

	local skyId = SkySpecKey(spec)

	-- The game can add a Sky at any time (day/night scripts etc).
	StashGameSkies()

	if CreatedSkyId == "plain" then
		DestroyCreatedSky()
	end

	if SkyboxForceRefresh then
		SkyboxForceRefresh = false
		CreatedSkyId = nil -- rebuild even if the id is unchanged
	end

	local intact = CreatedSky
		and CreatedSky.Parent == Lighting
		and CreatedSkyId == skyId

	if intact then
		for face, value in pairs(spec.Faces) do
			if CreatedSky[face] ~= value then
				intact = false
				break
			end
		end
	end

	if intact then
		ApplySkyProps(CreatedSky, spec.Props)
		SetManaged(CreatedSky, "CelestialBodiesShown", Config.HideCelestialBodies, false)
		SkyboxStatus = note and ("READY  |  " .. note) or "READY"
		return
	end

	if PendingSkyId == skyId then
		return -- this sky is already being loaded
	end

	PendingSkyId = skyId
	SkyboxStatus = "LOADING IMAGE..."

	local newSky = BuildSky(spec)

	task.spawn(function()
		-- Preload only to warm up the texture so the sky does not pop in.
		-- Its fetch status is NOT used as an error: it reports false
		-- "Failure" results for sky textures that actually display fine.
		-- Invalid IDs are detected earlier in ResolveSkyAsset instead.
		pcall(function()
			game:GetService("ContentProvider"):PreloadAsync({newSky})
		end)

		-- A newer image was entered (or the skybox was turned off) meanwhile.
		if PendingSkyId ~= skyId then
			newSky:Destroy()
			return
		end
		PendingSkyId = nil

		DestroyCreatedSky()
		CreatedSky = newSky
		CreatedSkyId = skyId
		newSky.Parent = Lighting
	end)
end

--============================================================
-- WORLD / LIGHTING
-- Every override goes through SetManaged, so turning a feature off restores
-- the game's value once instead of freezing the game's lighting forever.
--============================================================

function UpdateWorld()
	SafeCall("Skybox", UpdateSkybox)

	SetManaged(Lighting, "Brightness", Config.Fullbright, Config.LightingBrightness)
	SetManaged(Lighting, "GlobalShadows", Config.Fullbright or Config.NoShadows, false)
	SetManaged(Lighting, "OutdoorAmbient", Config.Fullbright, Color3.new(1, 1, 1))
	SetManaged(Lighting, "Ambient", Config.Fullbright, Color3.fromRGB(150, 150, 150))
	SetManaged(Lighting, "FogEnd", Config.RemoveFog, 100000)
	SetManaged(Lighting, "ClockTime", Config.CustomTime, Config.TimeOfDay)

	for _, object in ipairs(Lighting:GetChildren()) do
		if object:IsA("Atmosphere") then
			SetManaged(object, "Density", Config.DisableAtmosphere, 0)
			SetManaged(object, "Haze", Config.DisableAtmosphere, 0)
			SetManaged(object, "Glare", Config.DisableAtmosphere, 0)
		elseif object:IsA("PostEffect")
			and object.Name ~= "DexiNightVision"
			and object.Name ~= "DexiColorCorrection"
		then
			SetManaged(object, "Enabled", Config.DisablePostFX, false)
		end
	end

	local nightVision = Lighting:FindFirstChild("DexiNightVision")
	if Config.NightVision then
		if not nightVision then
			nightVision = Instance.new("ColorCorrectionEffect")
			nightVision.Name = "DexiNightVision"
			nightVision.Brightness = 0.14
			nightVision.Contrast = 0.10
			nightVision.Saturation = -0.05
			nightVision.TintColor = Color3.fromRGB(210, 255, 225)
			nightVision.Parent = Lighting
		end
	elseif nightVision then
		nightVision:Destroy()
	end

	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		-- Decoration is not writable from every context; SetManaged pcalls it.
		SetManaged(terrain, "Decoration", Config.LowGraphics, false)
		SetManaged(terrain, "WaterWaveSize", Config.LowGraphics, 0)
		SetManaged(terrain, "WaterWaveSpeed", Config.LowGraphics, 0)
		SetManaged(terrain, "WaterReflectance", Config.LowGraphics, 0)
	end
end

--============================================================
-- AIM
--============================================================

function IsLocallyTransparent(part)
	if not part or not part:IsA("BasePart") then
		return false
	end
	return part.Transparency >= 0.99 or part.LocalTransparencyModifier >= 0.99
end

function HasLocalObstruction(cam, character, worldPoint)
	local ignore = {}
	if Character then
		table.insert(ignore, Character)
	end

	local obscuring = cam:GetPartsObscuringTarget({worldPoint}, ignore)

	for _, blocker in ipairs(obscuring) do
		if blocker.Parent
			and not blocker:IsDescendantOf(character)
			and not IsLocallyTransparent(blocker)
		then
			return true
		end
	end

	return false
end

function IsVisible(character, part)
	local cam = getCamera()
	if not cam or not character or not part or not part:IsDescendantOf(character) then
		return false
	end

	local point, onScreen = cam:WorldToViewportPoint(part.Position)
	if not onScreen or point.Z <= 0 then
		return false
	end

	if HasLocalObstruction(cam, character, part.Position) then
		return false
	end

	local origin = cam.CFrame.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = Character and {Character} or {}
	params.IgnoreWater = true

	local result = Workspace:Raycast(origin, part.Position - origin, params)

	return not result
		or result.Instance:IsDescendantOf(character)
		or IsLocallyTransparent(result.Instance)
end

function IsCharacterLocallyVisible(character)
	for _, name in ipairs({"Head", "HumanoidRootPart", "UpperTorso", "Torso", "LowerTorso"}) do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") and IsVisible(character, part) then
			return true
		end
	end
	return false
end

R6AimParts = {"Head", "HumanoidRootPart", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}
R15AimParts = {
	"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso",
	"LeftUpperArm", "LeftLowerArm", "LeftHand",
	"RightUpperArm", "RightLowerArm", "RightHand",
	"LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
	"RightUpperLeg", "RightLowerLeg", "RightFoot",
}

-- Random body part valid for the rig. visibleOnly limits it to visible parts.
function GetRandomAimPart(character, humanoid, visibleOnly)
	if not character or not humanoid then
		return nil
	end

	local candidates = humanoid.RigType == Enum.HumanoidRigType.R6 and R6AimParts or R15AimParts
	local valid = {}

	for _, name in ipairs(candidates) do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") and (not visibleOnly or IsVisible(character, part)) then
			table.insert(valid, part)
		end
	end

	if #valid == 0 then
		if visibleOnly then
			return nil
		end
		return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	end

	return valid[math.random(1, #valid)]
end

function GetConfiguredAimPart(character, humanoid)
	if Config.AimPart == "Random" then
		return GetRandomAimPart(character, humanoid, false)
	end

	-- Fall back for parts that do not exist on this rig (e.g. UpperTorso on R6).
	return character:FindFirstChild(Config.AimPart)
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("HumanoidRootPart")
end

function FindAimTarget()
	local cam = getCamera()
	if not Root or not cam then
		return nil
	end

	local viewport = cam.ViewportSize
	local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	local closest
	local closestDistance = Config.AimFOV

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer
			and not (Config.AimTeamCheck and SameTeam(LocalPlayer, player))
		then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")

			if humanoid and humanoid.Health > 0 and root
				and (Root.Position - root.Position).Magnitude <= Config.AimMaxDistance
			then
				local acquirePart
				if Config.AimPart == "Random" then
					acquirePart = character:FindFirstChild("Head") or root
				else
					acquirePart = GetConfiguredAimPart(character, humanoid)
				end

				if acquirePart then
					local point, onScreen = cam:WorldToViewportPoint(acquirePart.Position)

					if onScreen then
						local screenDistance = (Vector2.new(point.X, point.Y) - center).Magnitude

						if screenDistance <= closestDistance then
							local visible = true

							if Config.AimVisibleCheck then
								if Config.AimPart == "Random" then
									visible = IsCharacterLocallyVisible(character)
								else
									visible = IsVisible(character, acquirePart)
								end
							end

							if visible then
								closest = {
									Player = player,
									Character = character,
									Part = acquirePart,
								}
								closestDistance = screenDistance
							end
						end
					end
				end
			end
		end
	end

	return closest
end

function AimActive()
	if not Config.AimHold then
		return true
	end

	local key = Config.AimKey
	if typeof(key) ~= "EnumItem" then
		-- No key assigned: hold mode is effectively always active.
		return true
	end

	if key.EnumType == Enum.UserInputType then
		return UIS:IsMouseButtonPressed(key)
	end

	return not IsTyping() and UIS:IsKeyDown(key)
end

function ClearAimTarget()
	CurrentTarget = nil
	RandomAimPartLock = nil
	RandomAimTargetPlayer = nil
end

function UpdateAim(dt)
	if not Config.AimAssist or Config.FreeCamera or Config.OrbitCamera or not AimActive() then
		ClearAimTarget()
		return
	end

	if not Config.AimSticky or not CurrentTarget then
		local previousPlayer = CurrentTarget and CurrentTarget.Player
		local foundTarget = FindAimTarget()

		if not foundTarget then
			ClearAimTarget()
			return
		end

		if Config.AimPart == "Random" then
			if previousPlayer ~= foundTarget.Player
				or RandomAimTargetPlayer ~= foundTarget.Player
				or not RandomAimPartLock
				or not RandomAimPartLock.Parent
			then
				local humanoid = foundTarget.Character:FindFirstChildOfClass("Humanoid")
				RandomAimPartLock = GetRandomAimPart(foundTarget.Character, humanoid, Config.AimVisibleCheck)
				RandomAimTargetPlayer = foundTarget.Player
			end

			foundTarget.Part = RandomAimPartLock or foundTarget.Part
		else
			RandomAimPartLock = nil
			RandomAimTargetPlayer = nil
		end

		CurrentTarget = foundTarget
	end

	local character = CurrentTarget.Character
	local part = CurrentTarget.Part
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	-- Sticky targets are dropped when they die, despawn or leave.
	if not character
		or not character.Parent
		or not part
		or not part.Parent
		or not humanoid
		or humanoid.Health <= 0
		or CurrentTarget.Player.Character ~= character
	then
		ClearAimTarget()
		return
	end

	if Config.AimVisibleCheck and not IsVisible(character, part) then
		ClearAimTarget()
		return
	end

	local cam = getCamera()
	local desired = CFrame.lookAt(cam.CFrame.Position, part.Position)

	-- Frame-rate independent smoothing (same feel as before at 60 FPS).
	local smoothness = math.clamp(Config.AimSmoothness, 0.01, 1)
	local alpha = 1 - (1 - smoothness) ^ (dt * 60)

	cam.CFrame = cam.CFrame:Lerp(desired, math.clamp(alpha, 0, 1))
end

--============================================================
-- CAMERA
--============================================================

FreeCameraPosition = nil
FreeCameraYaw = 0
FreeCameraPitch = 0

function UpdateCameraType()
	local cam = getCamera()
	SetManaged(cam, "CameraType", Config.FreeCamera or Config.OrbitCamera, Enum.CameraType.Scriptable)
end

function StopFreeCamera()
	FreeCameraPosition = nil
	UIS.MouseBehavior = Enum.MouseBehavior.Default
end

function UpdateFreeCamera(dt)
	local cam = getCamera()

	if not Config.FreeCamera or not cam then
		if FreeCameraPosition then
			StopFreeCamera()
		end
		return
	end

	if not FreeCameraPosition then
		FreeCameraPosition = cam.CFrame.Position
		local pitch, yaw = cam.CFrame:ToOrientation()
		FreeCameraPitch = math.deg(pitch)
		FreeCameraYaw = math.deg(yaw)
	end

	-- Hold right mouse button to look around (the camera could not be
	-- rotated at all before).
	if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		local delta = UIS:GetMouseDelta()
		FreeCameraYaw -= delta.X * 0.3
		FreeCameraPitch = math.clamp(FreeCameraPitch - delta.Y * 0.3, -89, 89)
	else
		UIS.MouseBehavior = Enum.MouseBehavior.Default
	end

	-- fromOrientation applies yaw before pitch (CFrame.Angles did not).
	local rotation = CFrame.fromOrientation(math.rad(FreeCameraPitch), math.rad(FreeCameraYaw), 0)

	local direction = Vector3.zero
	if not IsTyping() then
		if UIS:IsKeyDown(Enum.KeyCode.W) then direction += rotation.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then direction -= rotation.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then direction += rotation.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then direction -= rotation.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then
			direction += Vector3.yAxis
		end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) then
			direction -= Vector3.yAxis
		end
	end

	direction = safeUnit(direction)

	local speed = Config.FreeCameraSpeed
	if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
		speed *= Config.FreeCameraBoost
	end

	FreeCameraPosition += direction * speed * dt
	cam.CFrame = CFrame.new(FreeCameraPosition) * rotation
end

function UpdateOrbitCamera()
	if not Config.OrbitCamera or Config.FreeCamera or not Root then
		return
	end

	local cam = getCamera()
	local center = Root.Position
	local radius = Config.CameraDistance
	local angle = os.clock() * math.rad(Config.OrbitSpeed)

	local offset = Vector3.new(
		math.cos(angle) * radius,
		radius * 0.4,
		math.sin(angle) * radius
	)

	cam.CFrame = CFrame.lookAt(center + offset, center)
end

-- Third Person, Disable Zoom Limits and Lock First Person all write the
-- same player properties; they are combined here with a clear priority so
-- they no longer fight or restore each other's values.
function UpdateZoomAndMode()
	local minValue, maxValue

	if Config.ThirdPerson then
		local originalMax = GetOriginal(LocalPlayer, "CameraMaxZoomDistance") or 128
		minValue = Config.CameraDistance
		maxValue = math.max(Config.CameraDistance, Config.DisableZoomLimits and Config.ZoomMax or originalMax)
	elseif Config.DisableZoomLimits then
		minValue = Config.ZoomMin
		maxValue = math.max(Config.ZoomMax, Config.ZoomMin)
	end

	local active = minValue ~= nil
	SetManaged(LocalPlayer, "CameraMaxZoomDistance", active, maxValue)
	SetManaged(LocalPlayer, "CameraMinZoomDistance", active, minValue)

	local mode
	if Config.LockFirstPerson then
		mode = Enum.CameraMode.LockFirstPerson
	elseif Config.ThirdPerson then
		mode = Enum.CameraMode.Classic
	end
	SetManaged(LocalPlayer, "CameraMode", mode ~= nil, mode)
end

function UpdateCameraOffset()
	if not Humanoid then
		return
	end

	local crouchCamera = Config.Crouch and Config.CrouchCamera
	local offset = crouchCamera and Vector3.new(0, Config.CrouchOffset, 0) or Vector3.zero

	SetManaged(Humanoid, "CameraOffset", crouchCamera or Config.NoCameraBob, offset)
end

function UpdateCameraMotion(dt)
	local cam = getCamera()
	if not cam then
		return
	end

	-- FOV is only overridden when changed from the default or Dynamic FOV is
	-- on, so game zoom effects (scopes, sprint FOV) keep working otherwise.
	local zooming = Config.ZoomKey and not IsTyping() and UIS:IsKeyDown(Enum.KeyCode.C)

	if zooming or Config.DynamicFOV or Config.FOV ~= 70 then
		local target = Config.FOV
		if zooming then
			target = Config.ZoomKeyFOV
		elseif Config.DynamicFOV then
			local speed = Root and Root.AssemblyLinearVelocity.Magnitude or 0
			target = Config.FOV + math.clamp(speed * 0.05 * Config.DynamicFOVStrength, 0, 25)
		end

		local value = target
		if zooming or Config.DynamicFOV then
			value = cam.FieldOfView + (target - cam.FieldOfView) * math.clamp(dt * 10, 0, 1)
		end
		SetManaged(cam, "FieldOfView", true, value)
	else
		SetManaged(cam, "FieldOfView", false)
	end

	if Config.CameraTilt and Root and not Config.FreeCamera then
		local side = cam.CFrame.RightVector:Dot(Root.AssemblyLinearVelocity)
		local tilt = math.clamp(-side * 0.01 * Config.CameraTiltStrength, -8, 8)
		cam.CFrame = cam.CFrame * CFrame.Angles(0, 0, math.rad(tilt))
	end
end

function UpdateCameraExtras()
	local ex = ExtraState.Extras
	local cam = getCamera()
	if not cam then
		return
	end

	local scripted = Config.FreeCamera or Config.OrbitCamera

	if Config.ShoulderCamera and not scripted then
		cam.CFrame = cam.CFrame * CFrame.new(Config.ShoulderOffset, 0, 0)
	end

	if Config.CameraSmoothing and not scripted and ex.CameraCFrame then
		local alpha = math.clamp(Config.CameraSmoothness, 0.02, 0.8)
		ex.CameraCFrame = ex.CameraCFrame:Lerp(cam.CFrame, alpha)
		cam.CFrame = ex.CameraCFrame
	else
		ex.CameraCFrame = cam.CFrame
	end

	if Humanoid then
		if Config.AntiSeat and Humanoid.SeatPart then
			Humanoid.Sit = false
			Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end

		if Config.AutoUnequipTools and Character and Character:FindFirstChildOfClass("Tool") then
			Humanoid:UnequipTools()
		end
	end
end

