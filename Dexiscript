function CharacterRaycastParams()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = Character and {Character} or {}
	return params
end

-- Last grounded position, used by Respawn Point = "Death Point".
function UpdateGroundTracking()
	if Humanoid and Root and IsGrounded() then
		ExtraState.LastGroundCFrame = Root.CFrame
	end
end

function DoDash()
	if not Config.Dash or not isAlive() then
		return
	end

	local now = os.clock()
	if now - ExtraState.LastDash < 0.6 then
		return
	end
	ExtraState.LastDash = now

	local direction = Humanoid.MoveDirection
	if direction.Magnitude < 0.05 then
		local cam = getCamera()
		direction = safeUnit(Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z))
	else
		direction = direction.Unit
	end

	local velocity = Root.AssemblyLinearVelocity
	Root.AssemblyLinearVelocity = Vector3.new(
		direction.X * Config.DashPower,
		math.max(velocity.Y, 5),
		direction.Z * Config.DashPower
	)
end

function UpdateWallClimb()
	if not Config.WallClimb or Config.Fly or not Root or not Humanoid then
		return
	end

	local direction = Humanoid.MoveDirection
	if direction.Magnitude < 0.05 then
		return
	end

	local result = Workspace:Raycast(Root.Position, direction.Unit * 2.5, CharacterRaycastParams())

	-- Only near-vertical surfaces count as walls.
	if result and math.abs(result.Normal.Y) < 0.5 then
		local velocity = Root.AssemblyLinearVelocity
		Root.AssemblyLinearVelocity = Vector3.new(velocity.X, Config.WallClimbSpeed, velocity.Z)
	end
end

-- Auto Walk runs right after the default control script (priority Input),
-- so its Move() call is not overwritten by the "no input" Move(0).
pcall(function()
	RunService:UnbindFromRenderStep("DexiAutoWalk")
end)

RunService:BindToRenderStep("DexiAutoWalk", Enum.RenderPriority.Input.Value + 1, function()
	if not Config.AutoWalk or Config.FreeCamera or not Humanoid or Humanoid.Health <= 0 then
		return
	end

	if Humanoid.MoveDirection.Magnitude > 0.05 then
		return -- the player is steering manually
	end

	local cam = getCamera()
	if cam then
		local flatLook = safeUnit(Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z))
		Humanoid:Move(flatLook, false)
	end
end)

-- Target player helpers ----------------------------------------------------

function GetTargetRoot()
	if IsValidTargetPlayer(SelectedTarget) then
		return SelectedTarget.Character:FindFirstChild("HumanoidRootPart")
	end
	return nil
end

function TeleportToTarget()
	local targetRoot = GetTargetRoot()
	if not targetRoot then
		Notify("Target", "Select a valid player first.", 2)
		return
	end

	TeleportCharacter(targetRoot.CFrame * CFrame.new(0, 0, 3))
	Notify("Target", "Teleported to " .. SelectedTarget.DisplayName, 2)
end

function UpdateSpectate()
	local cam = getCamera()
	if not cam then
		return
	end

	local targetHumanoid = IsValidTargetPlayer(SelectedTarget)
		and SelectedTarget.Character:FindFirstChildOfClass("Humanoid")
		or nil

	local active = Config.SpectateTarget
		and targetHumanoid ~= nil
		and not Config.FreeCamera
		and not Config.OrbitCamera

	SetManaged(cam, "CameraSubject", active, targetHumanoid)

	if active then
		ExtraState.Spectating = true
	elseif ExtraState.Spectating then
		ExtraState.Spectating = false
		-- The saved subject may be the humanoid of a previous (dead) character.
		local subject = cam.CameraSubject
		if Humanoid and (not subject or not subject.Parent) then
			cam.CameraSubject = Humanoid
		end
	end
end

function UpdateFollow()
	if not Config.FollowTarget or Config.Fly or not Root then
		return
	end

	local targetRoot = GetTargetRoot()
	if not targetRoot then
		return
	end

	Root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, Config.FollowDistance)
	Root.AssemblyLinearVelocity = Vector3.zero
end

-- Other players (local only) ------------------------------------------------

function UpdateOtherPlayersVisibility()
	if not Config.HideOtherPlayers and next(HiddenPlayerCache) then
		for object, original in pairs(HiddenPlayerCache) do
			if object.Parent then
				object.Transparency = original
			end
			HiddenPlayerCache[object] = nil
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		local character = player ~= LocalPlayer and player.Character
		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				SetManaged(
					humanoid,
					"DisplayDistanceType",
					Config.HideNametags or Config.HideOtherPlayers,
					Enum.HumanoidDisplayDistanceType.None
				)
			end

			for _, object in ipairs(character:GetDescendants()) do
				if object:IsA("BillboardGui") and string.sub(object.Name, 1, 4) ~= "Dexi" then
					-- Custom nametags made by the game.
					SetManaged(object, "Enabled", Config.HideNametags or Config.HideOtherPlayers, false)
				elseif Config.HideOtherPlayers and (object:IsA("BasePart") or object:IsA("Decal")) then
					if HiddenPlayerCache[object] == nil then
						HiddenPlayerCache[object] = object.Transparency
					end
					object.Transparency = 1
				end
			end
		end
	end
end

-- Anti-Fling: other players cannot push you (their parts stop colliding on
-- your client) and sudden spin from outside is cancelled.
function UpdateAntiFling()
	if Config.AntiFling then
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player ~= LocalPlayer and player.Character
			if character then
				for _, object in ipairs(character:GetDescendants()) do
					if object:IsA("BasePart") then
						if OtherCollisionCache[object] == nil then
							OtherCollisionCache[object] = object.CanCollide
						end
						object.CanCollide = false
					end
				end
			end
		end

		if Root
			and not Config.SpinBot
			and not Config.TargetFling
			and Root.AssemblyAngularVelocity.Magnitude > 60
		then
			Root.AssemblyAngularVelocity = Vector3.zero
		end
	elseif next(OtherCollisionCache) then
		for object, original in pairs(OtherCollisionCache) do
			if object.Parent then
				object.CanCollide = original
			end
			OtherCollisionCache[object] = nil
		end
	end
end

-- World tools ---------------------------------------------------------------

function RestoreCache(cache, apply)
	for object, original in pairs(cache) do
		if object.Parent then
			pcall(apply, object, original)
		end
		cache[object] = nil
	end
end

function UpdateWorldSweep()
	if not Config.XRay and next(XRayCache) then
		RestoreCache(XRayCache, function(object, original)
			object.LocalTransparencyModifier = original
		end)
	end

	if not Config.LowGraphics and next(LowGraphicsCache) then
		RestoreCache(LowGraphicsCache, function(object, original)
			for property, value in pairs(original) do
				object[property] = value
			end
		end)
	end

	if not Config.XRay and not Config.LowGraphics then
		return
	end

	local now = os.clock()
	if now - LastWorldSweep < 2 then
		return
	end
	LastWorldSweep = now

	-- Player characters are never touched.
	local characters = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			characters[player.Character] = true
		end
	end

	for _, object in ipairs(Workspace:GetDescendants()) do
		local top = object
		while top.Parent and top.Parent ~= Workspace do
			top = top.Parent
		end

		if not characters[top] then
			if object:IsA("BasePart") and not object:IsA("Terrain") then
				if Config.XRay then
					if XRayCache[object] == nil then
						XRayCache[object] = object.LocalTransparencyModifier
					end
					object.LocalTransparencyModifier = Config.XRayStrength
				end

				if Config.LowGraphics then
					if not LowGraphicsCache[object] then
						LowGraphicsCache[object] = {
							Material = object.Material,
							Reflectance = object.Reflectance,
							CastShadow = object.CastShadow,
						}
					end
					object.Material = Enum.Material.SmoothPlastic
					object.Reflectance = 0
					object.CastShadow = false
				end
			elseif Config.LowGraphics and (object:IsA("Decal") or object:IsA("Texture")) then
				if not LowGraphicsCache[object] then
					LowGraphicsCache[object] = {Transparency = object.Transparency}
				end
				object.Transparency = 1
			end
		end
	end
end

function UpdateMuteSounds()
	if not Config.MuteSounds then
		if next(MutedSounds) then
			for sound in pairs(MutedSounds) do
				SetManaged(sound, "Volume", false)
				MutedSounds[sound] = nil
			end
		end
		return
	end

	local now = os.clock()
	if now - LastSoundSweep < 1 then
		return
	end
	LastSoundSweep = now

	for _, container in ipairs({Workspace, game:GetService("SoundService"), PlayerGui}) do
		for _, object in ipairs(container:GetDescendants()) do
			if object:IsA("Sound") then
				MutedSounds[object] = true
				SetManaged(object, "Volume", true, 0)
			end
		end
	end
end

function UpdateSelfTrail()
	if Config.SelfTrail and Root then
		if not SelfTrail or SelfTrail.Parent ~= Root then
			if SelfTrail then
				SelfTrail:Destroy()
			end

			local top = Instance.new("Attachment")
			top.Name = "DexiTrailTop"
			top.Position = Vector3.new(0, 1, 0)
			top.Parent = Root

			local bottom = Instance.new("Attachment")
			bottom.Name = "DexiTrailBottom"
			bottom.Position = Vector3.new(0, -1, 0)
			bottom.Parent = Root

			local trail = Instance.new("Trail")
			trail.Name = "DexiTrail"
			trail.Attachment0 = top
			trail.Attachment1 = bottom
			trail.Lifetime = 0.6
			trail.LightEmission = 0.6
			trail.Color = ColorSequence.new(Theme.Accent2, Theme.Accent)
			trail.Transparency = NumberSequence.new(0.2, 1)
			trail.Parent = Root

			-- Attachments are cleaned up together with the trail.
			trail.Destroying:Connect(function()
				top:Destroy()
				bottom:Destroy()
			end)

			SelfTrail = trail
		end
	elseif SelfTrail then
		SelfTrail:Destroy()
		SelfTrail = nil
	end
end

