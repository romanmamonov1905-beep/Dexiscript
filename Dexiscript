    title.Font = Enum.Font.GothamBold
    title.TextSize = 9
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.ZIndex = 51
    title.Parent = TargetMenu

    local refresh = Instance.new("TextButton")
    refresh.Size = UDim2.fromOffset(65, 20)
    refresh.Position = UDim2.new(1, -75, 0, 6)
    refresh.BackgroundColor3 = Theme.Card
    refresh.BorderSizePixel = 0
    refresh.Text = "[REFRESH]"
    refresh.TextColor3 = Theme.Text
    refresh.Font = Enum.Font.GothamMedium
    refresh.TextSize = 7
