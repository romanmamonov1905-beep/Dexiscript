	end

	humanoid.WalkSpeed = Db.SliderValues.Speed

	if Db.SliderValues.Jump > 50 then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = Db.SliderValues.Jump
	end

	if Db.States.Noclip then
		for _, part in ipairs(character:GetChildren()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end
end)

