function UpdateHumanoidProperties()
	if not Humanoid then
		return
	end

	local speed = Config.WalkSpeed
	if Config.FreeCamera then
		speed = 0 -- the character must not walk while the free camera moves
	elseif Config.SprintKey
		and not Config.Fly
		and not IsTyping()
		and UIS:IsKeyDown(Enum.KeyCode.LeftShift)
