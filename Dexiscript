local function Notify(message)
	local Card = Instance.new("Frame")
	Card.Name = "Notification"
	Card.Size = UDim2.new(0, 0, 0, 38)
	Card.BackgroundColor3 = Color3.fromRGB(14, 10, 20)
	Card.BackgroundTransparency = 0.1
	Card.BorderSizePixel = 0
	Card.Parent = NotifContainer

	local CardCorner = Instance.new("UICorner")
	CardCorner.Parent = Card
	CardCorner.CornerRadius = UDim.new(0, 6)

	local CardStroke = Instance.new("UIStroke")
	CardStroke.Parent = Card
	CardStroke.Color = Color3.fromRGB(140, 40, 255)
	CardStroke.Thickness = 1
	CardStroke.Enabled = false

	local Text = Instance.new("TextLabel")
	Text.Parent = Card
	Text.Size = UDim2.new(1, -20, 1, 0)
	Text.Position = UDim2.new(0, 10, 0, 0)
	Text.BackgroundTransparency = 1
	Text.Text = tostring(message)
	Text.TextColor3 = Color3.fromRGB(225, 210, 255)
	Text.Font = Enum.Font.GothamMedium
	Text.TextSize = 11
	Text.TextXAlignment = Enum.TextXAlignment.Left
	Text.Visible = false

	local openTween = TweenService:Create(
		Card,
		TweenInfo.new(
			0.25,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.new(0, 280, 0, 38)
		}
	)

	openTween:Play()

	openTween.Completed:Connect(function()
		if Card.Parent then
			Text.Visible = true
			CardStroke.Enabled = true
		end
	end)

	task.delay(3, function()
		if not Card.Parent then
			return
		end

		Text.Visible = false
		CardStroke.Enabled = false

		local closeTween = TweenService:Create(
			Card,
			TweenInfo.new(
				0.2,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			),
			{
				Size = UDim2.new(0, 0, 0, 0)
			}
		)

		closeTween:Play()

		closeTween.Completed:Wait()

		if Card.Parent then
			Card:Destroy()
		end
	end)
end

