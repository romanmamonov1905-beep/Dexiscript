local function AddButton(tab, text, key, callback)
	local parent = Db.Tabs[tab]

	if not parent then
		warn("Dexi Hub: tab not found:", tab)
		return
	end

	Db.States[key] = false

	local row = Instance.new("Frame")
	row.Parent = parent
	row.Size = UDim2.new(1, -5, 0, 36)
	row.BackgroundTransparency = 1

	local button = Instance.new("TextButton")
