function Toggle(page, text, getter, setter)
    local featureId = page.Name .. "::" .. text

    local button = Instance.new("TextButton")
    button.Name = "Toggle"
    button.Size = UDim2.new(1, -6, 0, 35)
    button.BackgroundColor3 = Theme.Card
    button.BorderSizePixel = 0
    button.Text = ""
    button.AutoButtonColor = false
    button.LayoutOrder = orderFor(page)
    button.Parent = page

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = button

    local accent = Instance.new("Frame")
    accent.Position = UDim2.fromOffset(0, 4)
    accent.Size = UDim2.fromOffset(2, 27)
    accent.BackgroundColor3 = Theme.Accent
    accent.BackgroundTransparency = 1
    accent.BorderSizePixel = 0
    accent.Parent = button

    local accentCorner = Instance.new("UICorner")
    accentCorner.CornerRadius = UDim.new(1, 0)
    accentCorner.Parent = accent

    local label = Instance.new("TextLabel")
    label.Position = UDim2.fromOffset(11, 0)
    label.Size = UDim2.new(1, -112, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Theme.Text
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 9
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = button

    local state = Instance.new("TextLabel")
    state.AnchorPoint = Vector2.new(1, 0.5)
    state.Position = UDim2.new(1, -62, 0.5, 0)
    state.Size = UDim2.fromOffset(28, 18)
    state.BackgroundTransparency = 1
    state.TextColor3 = Theme.Muted
    state.Font = Enum.Font.GothamBold
    state.TextSize = 7
    state.Parent = button

    local keyButton = Instance.new("TextButton")
    keyButton.AnchorPoint = Vector2.new(1, 0.5)
    keyButton.Position = UDim2.new(1, -7, 0.5, 0)
    keyButton.Size = UDim2.fromOffset(48, 20)
    keyButton.BackgroundColor3 = Theme.Background
    keyButton.BorderSizePixel = 0
    keyButton.TextColor3 = Theme.Muted
    keyButton.Font = Enum.Font.GothamBold
    keyButton.TextSize = 7
    keyButton.AutoButtonColor = false
    keyButton.Parent = button

    local keyCorner = Instance.new("UICorner")
    keyCorner.CornerRadius = UDim.new(0, 5)
    keyCorner.Parent = keyButton

    local keyStroke = Instance.new("UIStroke")
    keyStroke.Color = Color3.fromRGB(49, 34, 63)
    keyStroke.Thickness = 1
    keyStroke.Parent = keyButton

    local function refresh(animated)
        local enabled = getter()
        local targetBackground = enabled and Theme.CardActive or Theme.Card
        local targetKeyBackground = enabled
            and Color3.fromRGB(40, 21, 62)
            or Theme.Background

        state.Text = enabled and "ON" or "OFF"
        state.TextColor3 = enabled and Theme.Accent2 or Theme.Muted

        local key = Keybinds[featureId]
        keyButton.Text = key and key.Name or "-"

        if animated then
            TweenService:Create(
                button,
                TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {BackgroundColor3 = targetBackground}
            ):Play()

            TweenService:Create(
                accent,
                TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {BackgroundTransparency = enabled and 0 or 1}
            ):Play()

            TweenService:Create(
                keyButton,
                TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {BackgroundColor3 = targetKeyBackground}
            ):Play()
        else
            button.BackgroundColor3 = targetBackground
            accent.BackgroundTransparency = enabled and 0 or 1
            keyButton.BackgroundColor3 = targetKeyBackground
        end
    end

    ToggleControllers[featureId] = {
        Getter = getter,
        Setter = setter,
        Refresh = refresh,
        Button = button,
        KeyButton = keyButton,
    }

    button.MouseEnter:Connect(function()
        if not getter() then
            TweenService:Create(
                button,
                TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {BackgroundColor3 = Theme.CardHover}
            ):Play()
        end
    end)

    button.MouseLeave:Connect(function()
        refresh(true)
    end)

    button.MouseButton1Click:Connect(function()
        setter(not getter())
        MarkConfigDirty()
        refresh(true)
    end)

    keyButton.MouseEnter:Connect(function()
        TweenService:Create(
            keyStroke,
            TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Color = Theme.AccentDark}
        ):Play()
    end)

    keyButton.MouseLeave:Connect(function()
        TweenService:Create(
            keyStroke,
            TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Color = Color3.fromRGB(49, 34, 63)}
        ):Play()
    end)

    keyButton.MouseButton1Click:Connect(function()
        CapturingKeybind = featureId
        keyButton.Text = "PRESS"
        keyButton.TextColor3 = Theme.Accent2
        Notify(
            "Keybind",
            "Press a key for " .. text .. ". Backspace clears it.",
            3
        )
    end)

    refresh(false)

    return button, refresh
end

function Slider(page, text, minValue, maxValue, value, callback)
    local holder = Instance.new("Frame")
    holder.Name = "Slider"
    holder.Size = UDim2.new(1, -6, 0, 50)
    holder.BackgroundColor3 = Theme.Card
    holder.BorderSizePixel = 0
    holder.LayoutOrder = orderFor(page)
    holder.Parent = page

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = holder

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Position = UDim2.fromOffset(11, 5)
    label.Size = UDim2.new(1, -22, 0, 16)
    label.BackgroundTransparency = 1
    label.TextColor3 = Theme.Text
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 9
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local bar = Instance.new("Frame")
    bar.Name = "Bar"
    bar.Position = UDim2.new(0, 11, 0, 32)
    bar.Size = UDim2.new(1, -22, 0, 5)
    bar.BackgroundColor3 = Theme.Background
    bar.BorderSizePixel = 0
    bar.Parent = holder

    local barCorner = Instance.new("UICorner")
    barCorner.CornerRadius = UDim.new(1, 0)
    barCorner.Parent = bar

    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.Parent = bar

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = fill

    local function refresh(v)
        local pct =
            math.clamp(
                (v - minValue) /
                (maxValue - minValue),
                0,
                1
            )

        fill.Size = UDim2.new(pct, 0, 1, 0)
        label.Text =
            text .. ": " .. tostring(v)
    end

    refresh(value)

    local sliderDragging = false

    local function setFromX(x)
        local pct =
            math.clamp(
                (x - bar.AbsolutePosition.X) /
                bar.AbsoluteSize.X,
                0,
                1
            )

        local newValue =
            minValue +
            (maxValue - minValue) * pct

        if maxValue - minValue <= 5 then
            newValue =
                math.floor(newValue * 100) / 100
        else
            newValue =
                math.floor(newValue + 0.5)
        end

        refresh(newValue)
        callback(newValue)
        MarkConfigDirty()
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
        then
            sliderDragging = true
            setFromX(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if sliderDragging
            and input.UserInputType ==
                Enum.UserInputType.MouseMovement
        then
            setFromX(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
        then
            sliderDragging = false
        end
    end)

    return holder
end

function Dropdown(page, text, values, current, callback)
    local button = Instance.new("TextButton")
    button.Name = "Dropdown"
    button.Size = UDim2.new(1, -6, 0, 35)
    button.BackgroundColor3 = Theme.Card
    button.BorderSizePixel = 0
    button.TextColor3 = Theme.Text
    button.Font = Enum.Font.GothamMedium
    button.TextSize = 9
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.LayoutOrder = orderFor(page)
    button.Parent = page

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 11)
    padding.Parent = button

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = button

    local index = 1

    for i, value in ipairs(values) do
        if value == current then
            index = i
        end
    end

    local function refresh()
        button.Text =
            text .. ": " .. tostring(values[index])
    end

    button.MouseEnter:Connect(function()
        button.BackgroundColor3 = Theme.CardHover
    end)

    button.MouseLeave:Connect(function()
        button.BackgroundColor3 = Theme.Card
    end)

    button.MouseButton1Click:Connect(function()
        index += 1

        if index > #values then
            index = 1
        end

        callback(values[index])
        MarkConfigDirty()
        refresh()
    end)

    refresh()
    return button
end

