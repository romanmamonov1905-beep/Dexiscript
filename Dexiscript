local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()

local Window = Library.CreateLib("Dexi | Lucky Blocks Battleground", "Ocean")

--MAIN--
local Main = Window.NewTab("Main")
local Section = Main:NewSection("Player")

-- Слайдер для изменения скорости ( WalkSpeed )
-- Параметры: Название, Описание, Максимум, Минимум, Функция
Section:NewSlider("Player Speed", "Adjust your movement speed", 750, 16, function(value)
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    humanoid.WalkSpeed = value
    print("Speed changed to: " .. tostring(value))
end)

-- Слайдер для изменения силы прыжка ( JumpPower )
Section:NewSlider("Player Jump Power", "Adjust your jump power", 500, 50, function(value)
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    -- Включаем использование JumpPower, если в игре использовался JumpHeight
    humanoid.UseJumpPower = true 
    humanoid.JumpPower = value
    print("Jump Power changed to: " .. tostring(value))
end)

Section:NewButton("Fling|(K)", "Spin with 12000% power", function()
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")

	local player = Players.LocalPlayer

	local rotating = false
	local speed = 24000 -- градусов в секунду

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end

		if input.KeyCode == Enum.KeyCode.K then
			rotating = not rotating
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if not rotating then return end

		local character = player.Character
			if not character then return end
	
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root then return end

		root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(speed) * dt, 0)
	end)
end)
Section:NewButton("Inf Jumps", "Jump while mid air", function()
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")

	local player = Players.LocalPlayer

	-- Меняй это значение из своего GUI:
	local infiniteJump = true

	UserInputService.JumpRequest:Connect(function()
		if not infiniteJump then
			return
		end

		local character = player.Character
		if not character then return end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
end)
Section:NewButton("Teleport|(V)", "Teleports you in your direction", function()
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")

	local player = Players.LocalPlayer
	local distance = 25

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end

		if input.KeyCode == Enum.KeyCode.V then
			local character = player.Character
			if not character then return end

			local root = character:FindFirstChild("HumanoidRootPart")
			if not root then return end

			root.CFrame = root.CFrame + root.CFrame.LookVector * distance
		end
	end)
end)

Section:NewDropdown("Lucky Block Spawner", "Spawns Lucky Blocks (NOT VISUALS)", {"SpawnLuckyBlock", "SpawnSuperBlock", "SpawnDiamondBlock", "SpawnRainbowBlock", "SpawnGalaxyBlock"}, function(currentOption)
    local Event = game:GetService("ReplicatedStorage")[currentOption]:FireServer()
    Event:FireServer()
end)


--Visual--
local Main = Window.NewTab("Visuals")
local Section = Main:NewSection("Main Visuals")

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")

	local localPlayer = Players.LocalPlayer
	
	-- Создаем или находим скрытую техническую папку в Workspace для хранения кубов нашего ESP
	local espFolder = workspace:FindFirstChild("Dexi_PlayerESP_Folder")
	if not espFolder then
		espFolder = Instance.new("Folder")
		espFolder.Name = "Dexi_PlayerESP_Folder"
		espFolder.Parent = workspace
	end

	-- Переменная для контроля бесконечного цикла (должна быть строго СНАРУЖИ тумблера)
	local playerEspConnection = nil 

	-- Создаем тумблер в Kavo UI
	Section:NewToggle("Player ESP", "Toggle red parts on players", function(state)
		if state then
			-- === КОД ВКЛЮЧЕНИЯ ===
			if playerEspConnection then
				playerEspConnection:Disconnect()
				playerEspConnection = nil
			end

			-- Запускаем цикл отрисовки
			playerEspConnection = RunService.RenderStepped:Connect(function()
				for _, targetPlayer in pairs(Players:GetPlayers()) do
					if targetPlayer ~= localPlayer and targetPlayer.Character then
						local character = targetPlayer.Character
						local rootPart = character:FindFirstChild("HumanoidRootPart")
						
						if rootPart and rootPart:IsA("BasePart") then
							-- Ищем куб по уникальному имени (имя игрока + суффикс) внутри нашей изолированной папки
							local espPart = espFolder:FindFirstChild(targetPlayer.Name .. "_ESP")
							
							if not espPart then
								-- Создаем красный неоновый блок
								espPart = Instance.new("Part")
								espPart.Name = targetPlayer.Name .. "_ESP"
								espPart.Size = Vector3.new(4, 6, 4) -- Полностью покрывает хитбокс
								espPart.Color = Color3.fromRGB(255, 0, 0)
								espPart.Transparency = 0.5
								espPart.Material = Enum.Material.Neon
								
								-- Строгие настройки физики, чтобы блоки не падали и не толкались
								espPart.CanCollide = false
								espPart.Anchored = true
								espPart.CastShadow = false
								
								espPart.Parent = espFolder
							end
							
							-- Привязываем координаты куба к позиции игрока
							espPart.CFrame = rootPart.CFrame
						end
					end
				end
				
				-- Авто-очистка: если игрок вышел с сервера, удаляем его куб из нашей папки
				for _, child in pairs(espFolder:GetChildren()) do
					local pName = child.Name:gsub("_ESP", "")
					if not Players:FindFirstChild(pName) then
						child:Destroy()
					end
				end
			end)
			print("Player ESP: АКТИВИРОВАН")
		else
			-- === КОД ВЫКЛЮЧЕНИЯ ===
			-- 1. Полностью разрываем и убиваем фоновый цикл в памяти
			if playerEspConnection then
				playerEspConnection:Disconnect()
				playerEspConnection = nil
			end

			-- 2. Мгновенно очищаем всю нашу изолированную папку (все кубы исчезнут разом)
			espFolder:ClearAllChildren()
			print("Player ESP: ДЕАКТИВИРОВАН И ОЧИЩЕН")
		end
	end)

		local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Lighting = game:GetService("Lighting")

	local localPlayer = Players.LocalPlayer
	local camera = workspace.CurrentCamera

	-- Глобальные переменные контроля (ОБЯЗАТЕЛЬНО должны стоять выше тумблеров)
	local tracersEnabled = false
	local toolEspEnabled = false
	local fullBrightEnabled = false

	-- Папка для хранения физических кубов подсветки оружия (изолированная архитектура)
	local toolEspFolder = workspace:FindFirstChild("Dexi_ToolESP_Folder")
	if not toolEspFolder then
		toolEspFolder = Instance.new("Folder")
		toolEspFolder.Name = "Dexi_ToolESP_Folder"
		toolEspFolder.Parent = workspace
	end

	-- Таблица для хранения линий трасеров
	local tracersTable = {}

	-- Сохраняем стандартные настройки графики игры, чтобы вернуть их при выключении FullBright
	local origAmbient = Lighting.Ambient
	local origOutdoorAmbient = Lighting.OutdoorAmbient
	local origBrightness = Lighting.Brightness
	local origClockTime = Lighting.ClockTime

	-- ЕДИНЫЙ фоновый цикл для отрисовки Трасеров и Оружия
	RunService.RenderStepped:Connect(function()
		-- --- 1. ЛОГИКА ТРАСЕРОВ ---
		if tracersEnabled then
			for _, targetPlayer in pairs(Players:GetPlayers()) do
				if targetPlayer ~= localPlayer and targetPlayer.Character then
					local rootPart = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
					
					if rootPart then
						-- Переводим 3D координаты игрока в 2D координаты экрана камеры
						local screenPos, onScreen = camera:WorldToViewportPoint(rootPart.Position)
						
						if onScreen then
							-- Если линии для этого игрока еще нет, создаем её через встроенные Drawing (CoreGui)
							local line = tracersTable[targetPlayer.Name]
							if not line then
								line = Drawing.new("Line")
								line.Thickness = 1.5
								line.Color = Color3.fromRGB(255, 0, 0) -- Красный цвет линий
								line.Transparency = 0.7
								tracersTable[targetPlayer.Name] = line
							end
							
							-- Точка старта линии — центр нижней части экрана
							line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
							-- Точка конца линии — координаты хитбокса врага
							line.To = Vector2.new(screenPos.X, screenPos.Y)
							line.Visible = true
						else
							if tracersTable[targetPlayer.Name] then tracersTable[targetPlayer.Name].Visible = false end
						end
					end
				end
			end
		else
			-- Очистка всех трасеров при выключении
			for name, line in pairs(tracersTable) do
				line.Visible = false
				line:Remove()
				tracersTable[name] = nil
			end
		end

		-- --- 2. ЛОГИКА ПОДСВЕТКИ ОРУЖИЯ (TOOLS) ---
		if toolEspEnabled then
			for _, object in pairs(workspace:GetDescendants()) do
				if object:IsA("Tool") then
					-- Проверяем, что оружие просто лежит на земле, а не находится в руках игрока
					local isEquipped = object:FindFirstAncestorOfClass("Model") and object.Parent:FindFirstChildOfClass("Humanoid")
					
					if not isEquipped then
						local handle = object:FindFirstChild("Handle") or object:FindFirstChildWhichIsA("BasePart")
						if handle and handle:IsA("BasePart") then
							-- Создаем уникальный ID для куба на основе адреса памяти оружия
							local cubeName = tostring(object) .. "_Cube"
							local toolCube = toolEspFolder:FindFirstChild(cubeName)
							
							if not toolCube then
								toolCube = Instance.new("Part")
								toolCube.Name = cubeName
								toolCube.Size = handle.Size + Vector3.new(0.6, 0.6, 0.6)
								toolCube.Color = Color3.fromRGB(0, 150, 255) -- Ярко-синий цвет предметов
								toolCube.Transparency = 0.5
								toolCube.Material = Enum.Material.Neon
								
								toolCube.CanCollide = false
								toolCube.Anchored = true
								toolCube.CastShadow = false
								
								toolCube.Parent = toolEspFolder
							end
							toolCube.CFrame = handle.CFrame
						end
					end
				end
			end
			
			-- Очистка синих кубов, если предмет удалили с карты (кто-то подобрал или он деспавнился)
			for _, cube in pairs(toolEspFolder:GetChildren()) do
				local originalName = cube.Name:gsub("_Cube", "")
				local found = false
				for _, obj in pairs(workspace:GetDescendants()) do
					if obj:IsA("Tool") and tostring(obj) == originalName then
						local isEquipped = obj:FindFirstAncestorOfClass("Model") and obj.Parent:FindFirstChildOfClass("Humanoid")
						if not isEquipped then found = true break end
					end
				end
				if not found then cube:Destroy() end
			end
		else
			toolEspFolder:ClearAllChildren()
		end

		-- --- 3. ЛОГИКА FULLBRIGHT (НОЧНОЕ ЗРЕНИЕ) ---
		if fullBrightEnabled then
			Lighting.Ambient = Color3.fromRGB(255, 255, 255)
			Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
			Lighting.Brightness = 3
			Lighting.ClockTime = 14 -- Всегда солнечный день
		end
	end)

	-- Авто-очистка трасеров, если игрок ливнул
	Players.PlayerRemoving:Connect(function(targetPlayer)
		if tracersTable[targetPlayer.Name] then
			tracersTable[targetPlayer.Name].Visible = false
			tracersTable[targetPlayer.Name]:Remove()
			tracersTable[targetPlayer.Name] = nil
		end
	end)


	-- ==================== СОЗДАНИЕ ТУМБЛЕРОВ В KAVO UI ====================

	-- 1. Тумблер Трасеров (Линий к игрокам)
	Section:NewToggle("Player Tracers", "Draws laser lines to all players", function(state)
		tracersEnabled = state
		print("Tracers status:", state)
	end)

	-- 2. Тумблер подсветки Оружия
	Section:NewToggle("Item & Tool ESP", "Spawns a blue glow on dropped items", function(state)
		toolEspEnabled = state
		print("Tool ESP status:", state)
	end)

	-- 3. Тумблер Ночного зрения
	Section:NewToggle("FullBright", "Disables darkness and shadows", function(state)
		fullBrightEnabled = state
		if not state then
			-- Когда выключаем, принудительно возвращаем оригинальную графику карты обратно
			Lighting.Ambient = origAmbient
			Lighting.OutdoorAmbient = origOutdoorAmbient
			Lighting.Brightness = origBrightness
			Lighting.ClockTime = origClockTime
		end
		print("FullBright status:", state)
	end)


	local Players = game:GetService("Players")

	local player = Players.LocalPlayer
	local localHighlight = nil

	-- Создаем тумблер (Toggle) в вашем Kavo UI
	Section:NewToggle("Invisibility", "Makes your character invisible to others", function(state)
		local character = player.Character
		if not character then return end
		
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root then return end

		if state then
			-- === КОД ВКЛЮЧЕНИЯ ===
			-- 1. Полностью скрываем настоящее тело от других игроков на сервере
			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
					part.Transparency = 1
				elseif part:IsA("Decal") then
					part.Transparency = 1
				end
			end

			-- 2. Создаем локальную подсветку-силуэт (Highlight) только для ваших глаз
			if not localHighlight then
				localHighlight = Instance.new("Highlight")
				localHighlight.Name = "LocalGhostHighlight"
				localHighlight.FillColor = Color3.fromRGB(0, 150, 255) -- Синеватый неоновый призрак
				localHighlight.FillTransparency = 0.6 -- Прозрачность тела
				localHighlight.OutlineColor = Color3.fromRGB(255, 255, 255) -- Белая аккуратная обводка
				localHighlight.OutlineTransparency = 0.2
				localHighlight.Adornee = character
				localHighlight.Parent = character
			end
			print("Invisibility: ON (No-Clone Method)")
		else
			-- === КОД ВЫКЛЮЧЕНИЯ ===
			-- 1. Уничтожаем подсветку призрака
			if localHighlight then
				localHighlight:Destroy()
				localHighlight = nil
			end

			-- 2. Возвращаем стандартную видимость вашему настоящему персонажу
			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Transparency = 0
				elseif part:IsA("Decal") then
					part.Transparency = 0
				end
			end
			
			-- Технический хитбокс должен снова стать невидимым
			if root then root.Transparency = 1 end
			print("Invisibility: OFF")
		end
	end)
