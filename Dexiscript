local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()

local Window = Library.CreateLib("Dexi | Lucky Blocks Battleground", "Ocean")

--MAIN--
local Main = Window.NewTab("Main")
local Section = Main:NewSection("Player")

-- Слайдер для изменения скорости ( WalkSpeed )
-- Параметры: Название, Описание, Максимум, Минимум, Функция
Section:NewSlider("Player Speed", "Adjust your movement speed", 750, 16, function(value)
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    humanoid.WalkSpeed = value
    print("Speed changed to: " .. tostring(value))
end)

-- Слайдер для изменения силы прыжка ( JumpPower )
Section:NewSlider("Player Jump Power", "Adjust your jump power", 500, 50, function(value)
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    -- Включаем использование JumpPower, если в игре использовался JumpHeight
    humanoid.UseJumpPower = true 
    humanoid.JumpPower = value
    print("Jump Power changed to: " .. tostring(value))
end)

Section:NewButton("Fling|(K)", "Spin with 12000% power", function()
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")

	local player = Players.LocalPlayer

	local rotating = false
	local speed = 12000 -- градусов в секунду

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end

		if input.KeyCode == Enum.KeyCode.K then
			rotating = not rotating
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if not rotating then return end

		local character = player.Character
			if not character then return end
	
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root then return end

		root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(speed) * dt, 0)
	end)
end)
Section:NewButton("Inf Jumps", "Jump while mid air", function()
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")

	local player = Players.LocalPlayer

	-- Меняй это значение из своего GUI:
	local infiniteJump = true

	UserInputService.JumpRequest:Connect(function()
		if not infiniteJump then
			return
		end

		local character = player.Character
		if not character then return end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
end)
Section:NewButton("Teleport|(V)", "Teleports you in your direction", function()
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")

	local player = Players.LocalPlayer
	local distance = 25

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end

		if input.KeyCode == Enum.KeyCode.V then
			local character = player.Character
			if not character then return end

			local root = character:FindFirstChild("HumanoidRootPart")
			if not root then return end

			root.CFrame = root.CFrame + root.CFrame.LookVector * distance
		end
	end)
end)

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")

	local localPlayer = Players.LocalPlayer
	
	-- ВАЖНО: Эта переменная ОБЯЗАТЕЛЬНО должна стоять СНАРУЖИ тумблера, в самом верху секции
	local playerEspConnection = nil 

	-- Создаем тумблер в Kavo UI
	Section:NewToggle("Player ESP", "Toggle red parts on players", function(state)
		if state then
			-- === КОД ВКЛЮЧЕНИЯ ===
			-- Защита: если цикл уже почему-то работал, сначала отключаем его
			if playerEspConnection then
				playerEspConnection:Disconnect()
				playerEspConnection = nil
			end

			-- Запускаем бесконечный цикл подсветки
			playerEspConnection = RunService.RenderStepped:Connect(function()
				for _, targetPlayer in pairs(Players:GetPlayers()) do
					if targetPlayer ~= localPlayer and targetPlayer.Character then
						local character = targetPlayer.Character
						local rootPart = character:FindFirstChild("HumanoidRootPart")
						
						if rootPart and rootPart:IsA("BasePart") then
							local espPart = rootPart:FindFirstChild("EspRedPart")
							
							if not espPart then
								espPart = Instance.new("Part")
								espPart.Name = "EspRedPart"
								espPart.Size = Vector3.new(4, 6, 4)
								espPart.Color = Color3.fromRGB(255, 0, 0)
								espPart.Transparency = 0.5
								espPart.Material = Enum.Material.Neon
								
								espPart.CanCollide = false
								espPart.Anchored = true
								espPart.CastShadow = false
								
								espPart.Parent = rootPart
							end
							
							espPart.CFrame = rootPart.CFrame
						end
					end
				end
			end)
			print("Player ESP: ON")
		else
			-- === КОД ВЫКЛЮЧЕНИЯ ===
			-- 1. Гарантированно ломаем цикл в памяти игры
			if playerEspConnection then
				playerEspConnection:Disconnect()
				playerEspConnection = nil
			end

			-- 2. Стираем все оставшиеся красные кубы со всех игроков
			for _, targetPlayer in pairs(Players:GetPlayers()) do
				if targetPlayer.Character then
					local rootPart = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
					if rootPart then
						local espPart = rootPart:FindFirstChild("EspRedPart")
						if espPart then
							espPart:Destroy()
						end
					end
				end
			end
			print("Player ESP: OFF")
		end
	end)



