function SameTeam(a, b)
    return
        a.Team ~= nil
        and a.Team == b.Team
end

function IsVisible(character, part)
    local origin =
        Camera.CFrame.Position

    local direction =
        part.Position - origin

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances =
        {Character}

    params.IgnoreWater = true

    local result =
        Workspace:Raycast(
            origin,
            direction,
            params
        )

    if not result then
        return true
    end

    return result.Instance:IsDescendantOf(
        character
    )
end

-- Pick a rig-valid random body part.
-- R6 excludes R15-only parts such as UpperTorso/LowerTorso;
-- R15 uses its own body-part names instead.
GetRandomAimPart = function(character, humanoid)
    if not character or not humanoid then
        return nil
    end

    local candidates

    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        candidates = {
            "Head",
            "HumanoidRootPart",
            "Torso",
            "Left Arm",
            "Right Arm",
            "Left Leg",
            "Right Leg"
        }
    else
        candidates = {
            "Head",
            "HumanoidRootPart",
            "UpperTorso",
            "LowerTorso",
            "LeftUpperArm",
            "LeftLowerArm",
            "LeftHand",
            "RightUpperArm",
            "RightLowerArm",
            "RightHand",
            "LeftUpperLeg",
            "LeftLowerLeg",
            "LeftFoot",
            "RightUpperLeg",
            "RightLowerLeg",
            "RightFoot"
        }
    end

    local valid = {}

    for _, name in ipairs(candidates) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            valid[#valid + 1] = part
        end
    end

    if #valid == 0 then
        return character:FindFirstChild("Head")
            or character:FindFirstChild("HumanoidRootPart")
    end

    return valid[math.random(1, #valid)]
end

GetConfiguredAimPart = function(character, humanoid)
    if Config.AimPart == "Random" then
        return GetRandomAimPart(character, humanoid)
    end

    return character:FindFirstChild(Config.AimPart)
end

FindAimTarget = function()
    if not Root then
        return nil
    end

    local viewport =
        Camera.ViewportSize

    local center =
        Vector2.new(
            viewport.X / 2,
            viewport.Y / 2
        )

    local closest
    local closestDistance =
        Config.AimFOV

    for _, player in ipairs(
        Players:GetPlayers()
    ) do
        if player ~= LocalPlayer then
            if not (
                Config.AimTeamCheck
                and SameTeam(
                    LocalPlayer,
                    player
                )
            ) then
                local character =
                    player.Character

                local humanoid =
                    character
                    and character:
                        FindFirstChildOfClass(
                            "Humanoid"
                        )

                local root =
                    character
                    and character:
                        FindFirstChild(
                            "HumanoidRootPart"
                        )

                local part =
                    character
                    and GetConfiguredAimPart(
                        character,
                        humanoid
                    )

                if humanoid
                    and humanoid.Health > 0
                    and root
                    and part
                then
                    local worldDistance =
                        (
                            Root.Position -
                            root.Position
                        ).Magnitude

                    if worldDistance <=
                        Config.AimMaxDistance
                    then
                        local point, onScreen =
                            Camera:
                                WorldToViewportPoint(
                                    part.Position
                                )

                        if onScreen then
                            local screenDistance =
                                (
                                    Vector2.new(
                                        point.X,
                                        point.Y
                                    ) -
                                    center
                                ).Magnitude

                            if screenDistance <=
                                closestDistance
                            then
                                if
                                    not Config.AimVisibleCheck
                                    or IsVisible(
                                        character,
                                        part
                                    )
                                then
                                    closest = {
                                        Player = player,
                                        Character = character,
                                        Part = part
                                    }

                                    closestDistance =
                                        screenDistance
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return closest
end

function AimActive()
    if not Config.AimHold then
        return true
    end

    -- No assigned Aim Key means Aim Hold is effectively always active.
    if not Config.AimKey then
        return true
    end

    return UIS:IsKeyDown(
        Config.AimKey
    )
end

function UpdateAim()
    AimCircle.Visible =
        Config.AimAssist

    AimCircle.Size =
        UDim2.fromOffset(
            Config.AimFOV * 2,
            Config.AimFOV * 2
        )

    if not Config.AimAssist then
        CurrentTarget = nil
        return
    end

    if not AimActive() then
        if not Config.AimSticky then
            CurrentTarget = nil
        end

        return
    end

    if not Config.AimSticky
        or not CurrentTarget
    then
        local previousTarget = CurrentTarget
        local foundTarget =
            FindAimTarget()

        -- With Random, reroll the body part when the target changes,
        -- but keep the chosen part stable while the same target remains
        -- under the crosshair. This avoids visible aim jitter.
        if Config.AimPart == "Random"
            and previousTarget
            and foundTarget
            and previousTarget.Player == foundTarget.Player
            and previousTarget.Part
            and previousTarget.Part.Parent
        then
            foundTarget.Part = previousTarget.Part
        end

        CurrentTarget = foundTarget
    end

    if not CurrentTarget then
        return
    end

    local character =
        CurrentTarget.Character

    local part =
        CurrentTarget.Part

    if not character
        or not part
        or not part.Parent
    then
        CurrentTarget = nil
        return
    end

    local desired =
        CFrame.lookAt(
            Camera.CFrame.Position,
            part.Position
        )

    Camera.CFrame =
        Camera.CFrame:Lerp(
            desired,
            Config.AimSmoothness
        )
end

