		if not label then
			return
		end
		label.Visible = enabled
		if enabled then
			label.Text = text()
			visibleCount += 1
		end
	end

	set("Clock", Config.ClockOverlay, function()
		return os.date("%H:%M:%S")
	end)

	set("Session", Config.SessionTimer, function()
		local elapsed = math.floor(os.clock() - SessionStart)
		return string.format(
			"Session %02d:%02d:%02d",
			math.floor(elapsed / 3600),
			math.floor((elapsed % 3600) / 60),
			elapsed % 60
		)
	end)

	set("Players", Config.PlayerCountOverlay, function()
		return "Players  " .. tostring(#Players:GetPlayers())
	end)

	frame.Visible = visibleCount > 0
