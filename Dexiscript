--============================================================
-- TARGET SELECTION / LOCAL TARGET PHYSICS
--============================================================

local function GetPlayerList()
    local list = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(list, player)
        end
    end

    table.sort(list, function(a, b)
        return a.DisplayName:lower() < b.DisplayName:lower()
    end)

    return list
end

local function IsValidTargetPlayer(player)
    if not player or player == LocalPlayer then
        return false
    end

    local character = player.Character
    local humanoid =
        character
        and character:FindFirstChildOfClass("Humanoid")

    local targetRoot =
        character
        and character:FindFirstChild("HumanoidRootPart")

    return
        character ~= nil
        and humanoid ~= nil
        and humanoid.Health > 0
        and targetRoot ~= nil
end

local function SelectNextTarget()
    local list = GetPlayerList()

    if #list == 0 then
        SelectedTarget = nil
        return nil
    end

    local currentIndex = 0

    if SelectedTarget then
        for index, player in ipairs(list) do
            if player == SelectedTarget then
                currentIndex = index
                break
            end
        end
    end

    currentIndex += 1

    if currentIndex > #list then
        currentIndex = 1
    end

    SelectedTarget = list[currentIndex]

    return SelectedTarget
end

local function SelectedTargetText()
    if IsValidTargetPlayer(SelectedTarget) then
        return SelectedTarget.DisplayName
            .. " ["
            .. SelectedTarget.Name
            .. "]"
    end

    return "No target selected"
end

local function LocalTargetFling()
    -- A LocalScript cannot reliably take ownership of another
    -- player's character. This routine therefore uses local
    -- character physics to ram the selected target. Whether the
    -- target actually receives the impulse depends on the game's
    -- physics ownership/network setup.
    if not isAlive() then
        return
    end

    if not IsValidTargetPlayer(SelectedTarget) then
        Notify(
            "Target Fling",
            "Select a valid player first.",
            3
        )
        return
    end

    local targetCharacter = SelectedTarget.Character
    local targetRoot =
        targetCharacter:FindFirstChild("HumanoidRootPart")

    if not targetRoot then
        return
    end

    local delta =
        targetRoot.Position -
        Root.Position

    local direction =
        safeUnit(delta)

    if direction.Magnitude <= 0 then
        return
    end

    -- Local ram.
    Root.AssemblyLinearVelocity =
        (
            direction *
            Config.TargetFlingSpeed
        )
        +
        Vector3.new(
            0,
            Config.TargetFlingPower * 0.35,
            0
        )

    Root.AssemblyAngularVelocity =
        Vector3.new(
            0,
            Config.TargetFlingPower,
            0
        )

    -- Best-effort local impulse if the target assembly is
    -- currently client-simulatable. This may be ignored by Roblox
    -- when the server owns the target assembly.
    pcall(function()
        targetRoot:ApplyImpulse(
            direction *
            targetRoot.AssemblyMass *
            Config.TargetFlingPower
        )
    end)
end

local function LocalTouchFlingTarget(targetPlayer)
    if not Config.TouchFlingOther then
        return
    end

    if TouchFlingDebounce then
        return
    end

    if not IsValidTargetPlayer(targetPlayer) then
        return
    end

    if not Root then
        return
    end

    TouchFlingDebounce = true

    local targetRoot =
        targetPlayer.Character:
        FindFirstChild("HumanoidRootPart")

    if targetRoot then
        local direction =
            safeUnit(
                targetRoot.Position -
                Root.Position
            )

        if direction.Magnitude > 0 then
            Root.AssemblyLinearVelocity =
                (
                    direction *
                    Config.TouchFlingPower *
                    -1
                )
                +
                Vector3.new(
                    0,
                    Config.TouchFlingPower * 0.25,
                    0
                )

            pcall(function()
                targetRoot:ApplyImpulse(
                    direction *
                    targetRoot.AssemblyMass *
                    Config.TouchFlingPower
                )
            end)
        end
    end

    task.delay(0.25, function()
        TouchFlingDebounce = false
    end)
end

local function ConnectTargetTouchFling(character)
    if not character then
        return
    end

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            object.Touched:Connect(function(hit)
                if not Config.TouchFlingOther then
                    return
                end

                local otherCharacter =
                    hit and hit:FindFirstAncestorOfClass("Model")

                if not otherCharacter then
                    return
                end

                local otherHumanoid =
                    otherCharacter:
                    FindFirstChildOfClass("Humanoid")

                if not otherHumanoid then
                    return
                end

                local player =
                    Players:GetPlayerFromCharacter(
                        otherCharacter
                    )

                if player and player ~= LocalPlayer then
                    LocalTouchFlingTarget(player)
                end
            end)
        end
    end
end

