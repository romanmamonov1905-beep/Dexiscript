local function RemoveESP(playerName)
	local esp = Db.EspCache[playerName]
	local box = Db.BoxCache[playerName]
	local line = Db.LinesCache[playerName]

	DestroyInstance(esp)
	DestroyInstance(box)
	DestroyInstance(line)

	Db.EspCache[playerName] = nil
	Db.BoxCache[playerName] = nil
	Db.LinesCache[playerName] = nil
end

local function RenderVisuals(player)
	if player == LocalPlayer then
		return
	end

	RemoveESP(player.Name)

	local characterConnection

	local function InitCharacter(character)
		RemoveESP(player.Name)

		local head =
			character:WaitForChild("Head", 5)

		local humanoid =
			character:FindFirstChildOfClass("Humanoid")

		if not head or not humanoid then
			return
		end

		local billboard =
			Instance.new("BillboardGui")

		billboard.Name = "DexiOverEsp"
		billboard.Adornee = head
		billboard.Size =
			UDim2.new(0, 150, 0, 50)

		billboard.AlwaysOnTop = true
		billboard.Parent = head

		local label =
			Instance.new("TextLabel")

		label.Parent = billboard
		label.Size =
			UDim2.new(1, 0, 0, 20)

		label.BackgroundTransparency = 1
		label.TextColor3 =
			Color3.fromRGB(155, 65, 255)

		label.Font = Enum.Font.GothamBold
		label.TextSize = 10

		local healthBackground =
			Instance.new("Frame")

		healthBackground.Parent = billboard
		healthBackground.Size =
			UDim2.new(0, 80, 0, 4)

		healthBackground.Position =
			UDim2.new(0.5, -40, 0, 22)

		healthBackground.BackgroundColor3 =
			Color3.fromRGB(30, 15, 35)

		healthBackground.BorderSizePixel = 0

		local healthFill =
			Instance.new("Frame")

		healthFill.Parent = healthBackground
		healthFill.Size =
			UDim2.new(1, 0, 1, 0)

		healthFill.BackgroundColor3 =
			Color3.fromRGB(0, 255, 120)

		healthFill.BorderSizePixel = 0

		local boxFrame =
			Instance.new("Frame")

		boxFrame.Name =
			"DexiBox_" .. player.Name

		boxFrame.Parent = OverlayGui
		boxFrame.BackgroundTransparency = 1
		boxFrame.BorderSizePixel = 0
		boxFrame.Visible = false

		local boxStroke =
			Instance.new("UIStroke")

		boxStroke.Parent = boxFrame
		boxStroke.Color =
			Color3.fromRGB(140, 40, 255)

		boxStroke.Thickness = 1

		local lineFrame =
			Instance.new("Frame")

		lineFrame.Name =
			"DexiLine_" .. player.Name

		lineFrame.Parent = OverlayGui
		lineFrame.BackgroundColor3 =
			Color3.fromRGB(140, 40, 255)

		lineFrame.BorderSizePixel = 0
		lineFrame.AnchorPoint =
			Vector2.new(0.5, 0.5)

		lineFrame.Visible = false

		Db.EspCache[player.Name] = billboard
		Db.BoxCache[player.Name] = boxFrame
		Db.LinesCache[player.Name] = lineFrame

		local renderConnection

		renderConnection =
			RunService.RenderStepped:Connect(function()

				if not Db.States.EspCore then
					renderConnection:Disconnect()
					RemoveESP(player.Name)
					return
				end

				if not character.Parent then
					renderConnection:Disconnect()
					RemoveESP(player.Name)
					return
				end

				local currentHumanoid =
					character:FindFirstChildOfClass("Humanoid")

				local root =
					character:FindFirstChild("HumanoidRootPart")

				local localRoot =
					LocalPlayer.Character
					and LocalPlayer.Character:FindFirstChild(
						"HumanoidRootPart"
					)

				if not currentHumanoid
					or not root
					or not localRoot then

					boxFrame.Visible = false
					lineFrame.Visible = false
					return
				end

				local position, onScreen =
					Camera:WorldToViewportPoint(
						root.Position
					)

				local distance =
					math.floor(
						(root.Position - localRoot.Position)
							.Magnitude
					)

				label.Text =
					string.format(
						"%s (%dm)",
						player.Name,
						distance
					)

				local health =
					math.clamp(
						currentHumanoid.Health
							/ math.max(
								currentHumanoid.MaxHealth,
								1
							),
						0,
						1
					)

				healthFill.Size =
					UDim2.new(
						health,
						0,
						1,
						0
					)

				if onScreen
					and position.Z > 0
					and Db.States.EspBox then

					local sizeX =
						math.clamp(
							2000 / position.Z,
							20,
							500
						)

					local sizeY =
						math.clamp(
							3500 / position.Z,
							30,
							700
						)

					boxFrame.Size =
						UDim2.new(
							0,
							sizeX,
							0,
							sizeY
						)

					boxFrame.Position =
						UDim2.new(
							0,
							position.X - sizeX / 2,
							0,
							position.Y - sizeY / 2
						)

					boxFrame.Visible = true
				else
					boxFrame.Visible = false
				end

				if onScreen
					and position.Z > 0
					and Db.States.EspLines then

					local startX =
						Camera.ViewportSize.X / 2

					local startY =
						Camera.ViewportSize.Y

					local endX = position.X
					local endY = position.Y

					local dx = endX - startX
					local dy = endY - startY

					local length =
						math.sqrt(
							dx * dx + dy * dy
						)

					lineFrame.Size =
						UDim2.new(
							0,
							length,
							0,
							1
						)

					lineFrame.Position =
						UDim2.new(
							0,
							(startX + endX) / 2,
							0,
							(startY + endY) / 2
						)

					lineFrame.Rotation =
						math.deg(
							math.atan2(dy, dx)
						)

					lineFrame.Visible = true
				else
					lineFrame.Visible = false
				end
			end)
	end

	if player.Character then
		task.spawn(function()
			InitCharacter(player.Character)
		end)
	end

	characterConnection =
		player.CharacterAdded:Connect(function(character)
			task.wait(0.5)

			if Db.States.EspCore then
				InitCharacter(character)
			end
		end)

	return characterConnection
end

