    local terrain = Workspace.Terrain
    if Config.LowGraphics then
        if terrain:GetAttribute("DexiSavedDecoration") == nil then
            terrain:SetAttribute("DexiSavedDecoration", terrain.Decoration)
            terrain:SetAttribute("DexiSavedWaveSize", terrain.WaterWaveSize)
            terrain:SetAttribute("DexiSavedWaveSpeed", terrain.WaterWaveSpeed)
            terrain:SetAttribute("DexiSavedReflectance", terrain.WaterReflectance)
