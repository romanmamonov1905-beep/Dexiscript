NotificationOrder = 0

function Notify(title, message, duration)
	if not Config.Notifications or not UINotifications then
		return
	end

	-- Keep at most 4 notifications on screen.
	local existing = {}
	for _, child in ipairs(UINotifications:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(existing, child)
		end
	end
	table.sort(existing, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #existing >= 4 do
		table.remove(existing, 1):Destroy()
	end

	NotificationOrder += 1

	local box = Instance.new("Frame")
	box.Size = UDim2.fromOffset(270, 58)
	box.BackgroundColor3 = Theme.Card
	box.BorderSizePixel = 0
	box.LayoutOrder = NotificationOrder
	box.Parent = UINotifications

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = box

	local stroke = Instance.new("UIStroke")
