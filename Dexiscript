	button.Text = text
	button.TextColor3 = Color3.fromRGB(180, 180, 180)
	button.Font = Enum.Font.GothamMedium
	button.TextSize = 12
	button.AutoButtonColor = false

	local corner = Instance.new("UICorner")
	corner.Parent = button
	corner.CornerRadius = UDim.new(0, 6)

	local stroke = Instance.new("UIStroke")
	stroke.Parent = button
	stroke.Color = Color3.fromRGB(45, 35, 60)

	local bindButton = Instance.new("TextButton")
	bindButton.Name = "Bind"
	bindButton.Parent = row
	bindButton.Size = UDim2.new(0, 50, 1, 0)
	bindButton.Position = UDim2.new(1, -50, 0, 0)
	bindButton.BackgroundColor3 = Color3.fromRGB(20, 15, 28)
	bindButton.Text = "NONE"
	bindButton.TextColor3 = Color3.fromRGB(140, 120, 160)
	bindButton.Font = Enum.Font.GothamBold
	bindButton.TextSize = 10
	bindButton.AutoButtonColor = false

	local bindCorner = Instance.new("UICorner")
	bindCorner.Parent = bindButton
	bindCorner.CornerRadius = UDim.new(0, 6)

	local bindStroke = Instance.new("UIStroke")
	bindStroke.Parent = bindButton
	bindStroke.Color = Color3.fromRGB(45, 35, 60)

	local function TriggerAction()
		Db.States[key] = not Db.States[key]

		callback(Db.States[key])

		if Db.States[key] then
			button.TextColor3 = Color3.fromRGB(255, 255, 255)
			button.BackgroundColor3 = Color3.fromRGB(140, 40, 255)
			stroke.Color = Color3.fromRGB(200, 100, 255)

			Notify("Включено: " .. text)
		else
			button.TextColor3 = Color3.fromRGB(180, 180, 180)
			button.BackgroundColor3 = Color3.fromRGB(25, 19, 35)
			stroke.Color = Color3.fromRGB(45, 35, 60)

			Notify("Выключено: " .. text)
		end
	end

	button.MouseButton1Click:Connect(TriggerAction)

	Db.Keybinds[key] = {
		Button = bindButton,
		Action = TriggerAction,
		Key = nil
	}

	bindButton.MouseButton1Click:Connect(function()
		bindButton.Text = "..."
		BindingKey = key
		BindingButton = bindButton
	end)
end

