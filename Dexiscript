	)

	AddButton(
		"Automation Farm",
		"Instant One-Tap Tree Cut",
		"VW_OneTapChop",
		function(state)
			DisconnectConnection("OneTap")

			if not state then
				return
			end

			Db.Connections.OneTap =
				RunService.Heartbeat:Connect(function()
					local root = GetRoot()

					if not root then
						return
					end

					for _, tree in ipairs(workspace:GetDescendants()) do
						if tree:IsA("Model")
							and tree.Name:lower():find("tree") then

							local primary = tree.PrimaryPart

							if primary
								and (
									primary.Position - root.Position
								).Magnitude < 30 then

								tree:Destroy()
								break
							end
						end
					end
				end)
