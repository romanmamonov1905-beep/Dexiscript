function DoClickTeleport()
	local cam = getCamera()
	if not Root or not cam then
		return
	end

	local mousePosition = UIS:GetMouseLocation()
	local ray = cam:ViewportPointToRay(mousePosition.X, mousePosition.Y)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {Character}

	local result = Workspace:Raycast(ray.Origin, ray.Direction * 5000, params)

	if not result then
		-- Clicking the sky used to teleport the player thousands of studs away.
		if Config.TeleportSafety then
			return
		end
		TeleportCharacter(CFrame.new(ray.Origin + ray.Direction * 500))
		return
	end

	local destination = result.Position + Vector3.new(0, 4, 0)
	local flatLook = safeUnit(Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z))

	if flatLook.Magnitude > 0 then
		TeleportCharacter(CFrame.lookAt(destination, destination + flatLook))
	else
		TeleportCharacter(CFrame.new(destination))
	end
end

