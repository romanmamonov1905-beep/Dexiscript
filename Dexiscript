radarCenter.BackgroundColor3 = Theme.Accent2
radarCenter.BorderSizePixel = 0
radarCenter.Parent = Radar

local radarCenterCorner = Instance.new("UICorner")
radarCenterCorner.CornerRadius = UDim.new(1, 0)
radarCenterCorner.Parent = radarCenter

local RadarDots = {}

local function UpdateRadar()
	Radar.Visible = Config.Radar

	if not Config.Radar or not Root then
		for _, dot in pairs(RadarDots) do
			dot.Visible = false
		end

		return
	end

	local size =
		Radar.AbsoluteSize

	local center =
		Vector2.new(
			size.X / 2,
			size.Y / 2
		)

	for _, player in ipairs(
		Players:GetPlayers()
		) do
		if player ~= LocalPlayer then
			if not RadarDots[player] then
				local dot = Instance.new("Frame")
				dot.Name = "Dot"
				dot.AnchorPoint =
					Vector2.new(0.5, 0.5)
				dot.Size =
					UDim2.fromOffset(
						5,
						5
					)
				dot.BackgroundColor3 =
					Theme.Accent2
				dot.BorderSizePixel = 0
				dot.Parent = Radar

				local dotCorner =
					Instance.new("UICorner")

				dotCorner.CornerRadius =
					UDim.new(1, 0)

				dotCorner.Parent = dot

				RadarDots[player] = dot
			end

			local dot =
				RadarDots[player]

			local targetCharacter =
				player.Character

			local targetRoot =
				targetCharacter
				and targetCharacter:
				FindFirstChild(
					"HumanoidRootPart"
				)

			if targetRoot then
				local offset =
					targetRoot.Position -
					Root.Position

				local distance =
					offset.Magnitude

				if distance <= Config.RadarRange then
					local x =
						(
							offset.X /
							Config.RadarRange
						) *
						(size.X / 2)

					local y =
						(
							offset.Z /
							Config.RadarRange
						) *
						(size.Y / 2)

					dot.Position =
						UDim2.fromOffset(
							center.X + x,
							center.Y + y
						)

					dot.Visible = true
				else
					dot.Visible = false
				end
			else
				dot.Visible = false
			end
		end
	end
end

