function UpdateAntiVoid()
	if not Root or not Humanoid or not Config.AntiVoid then
		return
	end

	-- Only grounded positions are remembered, so the player is not returned
	-- to a point in mid-air above the void.
	if IsGrounded() and Root.Position.Y > Config.AntiVoidHeight + 12 then
		ExtraState.SafeCFrame = Root.CFrame
	elseif Root.Position.Y <= Config.AntiVoidHeight and ExtraState.SafeCFrame then
		TeleportCharacter(ExtraState.SafeCFrame + Vector3.new(0, 3, 0))
		Notify("Anti-Void", "Returned to the last safe position.", 2)
	end
end

