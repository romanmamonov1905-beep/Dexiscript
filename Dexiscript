	if not UIScale or not cam then
		return
	end

	local viewport = cam.ViewportSize
	local margin = (DeviceMode == "Mobile") and 14 or 24
	local fitScale = math.min(
		(viewport.X - margin) / 620,
		(viewport.Y - margin) / 390
	)

	if DeviceMode == "Mobile" then
		UIScale.Scale = math.clamp(math.min(Config.UIScale, fitScale), 0.52, 1)
	elseif DeviceMode == "Tablet" then
		UIScale.Scale = math.clamp(math.min(Config.UIScale, fitScale), 0.70, 1)
	else
		UIScale.Scale = Config.UIScale
	end
end

