function UpdateGlide()
    if not Config.Glide
        or not Root
        or not Humanoid
    then
        return
    end

    if Humanoid.FloorMaterial == Enum.Material.Air then
        local velocity = Root.AssemblyLinearVelocity

        if velocity.Y < -18 then
            Root.AssemblyLinearVelocity =
                Vector3.new(
                    velocity.X,
                    -18,
                    velocity.Z
                )
        end
    end
end

function UpdateHover()
    if not Config.Hover
        or not Root
        or not Humanoid
    then
        return
    end

    if Humanoid.FloorMaterial == Enum.Material.Air then
        local velocity =
            Root.AssemblyLinearVelocity

        Root.AssemblyLinearVelocity =
            Vector3.new(
                velocity.X,
                0,
                velocity.Z
            )
    end
end

function UpdateAirWalk()
    if not Config.AirWalk
        or not Root
        or not Humanoid
    then
        return
    end

    if Humanoid.FloorMaterial == Enum.Material.Air then
        local origin = Root.Position

        local params = RaycastParams.new()
        params.FilterType =
            Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances =
            {Character}

        local result =
            Workspace:Raycast(
                origin,
                Vector3.new(0, -8, 0),
                params
            )

        if not result then
            Root.AssemblyLinearVelocity =
                Vector3.new(
                    Root.AssemblyLinearVelocity.X,
                    0,
                    Root.AssemblyLinearVelocity.Z
                )
        end
    end
end

