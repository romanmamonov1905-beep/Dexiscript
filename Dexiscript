-- Slider bound to a Config field. Registered in ValueControllers so it is
-- redrawn when a config is loaded or settings are reset (it was not before).
function Slider(page, text, minValue, maxValue, configKey, callback, step)
	local holder = Instance.new("Frame")
	holder.Name = "Slider"
	holder.Size = UDim2.new(1, -6, 0, IsTouchDevice and 54 or 50)
	holder.BackgroundColor3 = Theme.Card
	holder.BorderSizePixel = 0
	holder.LayoutOrder = orderFor(page)
	holder.Parent = page

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 7)
	corner.Parent = holder

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Position = UDim2.fromOffset(11, 5)
	label.Size = UDim2.new(1, -22, 0, 16)
	label.BackgroundTransparency = 1
	label.TextColor3 = Theme.Text
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 9
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = holder

	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.Position = UDim2.new(0, 11, 0, IsTouchDevice and 34 or 32)
	bar.Size = UDim2.new(1, -22, 0, 5)
	bar.BackgroundColor3 = Theme.Background
	bar.BorderSizePixel = 0
	bar.Parent = holder

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(1, 0)
	barCorner.Parent = bar

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = Theme.Accent
	fill.BorderSizePixel = 0
	fill.Parent = bar

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	-- Bigger invisible hit area; the visible bar stays where it is.
	local touchTarget = Instance.new("TextButton")
	touchTarget.Name = "TouchTarget"
	touchTarget.BackgroundTransparency = 1
	touchTarget.BorderSizePixel = 0
	touchTarget.Text = ""
	touchTarget.AutoButtonColor = false
	touchTarget.Size = UDim2.new(1, -8, 0, IsTouchDevice and 34 or 18)
	touchTarget.Position = UDim2.new(0, 4, 0, IsTouchDevice and 23 or 25)
	touchTarget.ZIndex = bar.ZIndex + 1
	touchTarget.Parent = holder

	local function refresh(v)
		v = tonumber(v) or minValue
		local pct = math.clamp((v - minValue) / (maxValue - minValue), 0, 1)
		fill.Size = UDim2.new(pct, 0, 1, 0)
		label.Text = text .. ": " .. tostring(v)
	end

	refresh(Config[configKey])

	local sliderDragging = false
	local activeInput = nil

	local function setFromX(x)
		local pct = math.clamp(
			(x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1),
			0,
			1
		)

		local newValue = minValue + (maxValue - minValue) * pct

		if step then
			newValue = math.floor(newValue / step + 0.5) * step
		elseif maxValue - minValue <= 5 then
			newValue = math.floor(newValue * 100 + 0.5) / 100
		else
			newValue = math.floor(newValue + 0.5)
		end

		newValue = math.clamp(newValue, minValue, maxValue)

		if Config[configKey] == newValue then
			return
		end

		Config[configKey] = newValue
		refresh(newValue)
		if callback then
			callback(newValue)
		end
		MarkConfigDirty()
	end

	local function beginDrag(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			sliderDragging = true
			activeInput = input
			setFromX(input.Position.X)
		end
	end

	bar.InputBegan:Connect(beginDrag)
	touchTarget.InputBegan:Connect(beginDrag)

	UIS.InputChanged:Connect(function(input)
		if not sliderDragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or (input.UserInputType == Enum.UserInputType.Touch and input == activeInput)
		then
			setFromX(input.Position.X)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			sliderDragging = false
			activeInput = nil
		end
	end)

	table.insert(ValueControllers, function()
		refresh(Config[configKey])
	end)

	return holder
end

-- Cycling dropdown bound to a Config field.
function Dropdown(page, text, values, configKey, callback)
	local button = Instance.new("TextButton")
	button.Name = "Dropdown"
	button.Size = UDim2.new(1, -6, 0, IsTouchDevice and 43 or 35)
	button.BackgroundColor3 = Theme.Card
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.TextColor3 = Theme.Text
	button.Font = Enum.Font.GothamMedium
	button.TextSize = 9
	button.TextXAlignment = Enum.TextXAlignment.Left
	button.LayoutOrder = orderFor(page)
	button.Parent = page

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 11)
	padding.Parent = button

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 7)
	corner.Parent = button

	local function currentIndex()
		for i, value in ipairs(values) do
			if value == Config[configKey] then
				return i
			end
		end
		return 1
	end

	local function refresh()
		button.Text = text .. ": " .. tostring(values[currentIndex()])
	end

	button.MouseEnter:Connect(function()
		button.BackgroundColor3 = Theme.CardHover
	end)

	button.MouseLeave:Connect(function()
		button.BackgroundColor3 = Theme.Card
	end)

	button.MouseButton1Click:Connect(function()
		local index = currentIndex() % #values + 1
		Config[configKey] = values[index]
		if callback then
			callback(values[index])
		end
		MarkConfigDirty()
		refresh()
	end)

	table.insert(ValueControllers, refresh)
	refresh()
	return button
end

