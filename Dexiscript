				while Db.States.Fox_TurboFarm and not Destroyed do
					local root = GetRoot()

					if root then
						for _, object in ipairs(workspace:GetDescendants()) do
							if object:IsA("BasePart")
								and object.Name:lower():find("egg") then

								root.CFrame = object.CFrame
								task.wait(0.05)
