--------------------------------------------------------------------------------------
-- TARGET FINDER
--------------------------------------------------------------------------------------

local function GetClosestTarget()
	local closest = nil
	local shortest = Db.SliderValues.AimFov
	local mousePos = UserInputService:GetMouseLocation()

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")

			if humanoid and root and humanoid.Health > 0 then
				local position, onScreen = Camera:WorldToViewportPoint(root.Position)

				if onScreen then
					local screenPosition = Vector2.new(position.X, position.Y)
					local distance = (screenPosition - mousePos).Magnitude

					if distance < shortest then
						shortest = distance
						closest = player
					end
				end
			end
		end
	end

	return closest
end

