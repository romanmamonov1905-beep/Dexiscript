function UpdateTracers()
	local cam = getCamera()

	if not Config.ESP or not Config.ESPTracers or not cam then
		for _, line in pairs(Tracers) do
			line.Visible = false
		end
		return
	end

	local viewport = cam.ViewportSize
	local startPoint = Vector2.new(viewport.X / 2, viewport.Y)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local line = Tracers[player]
			if not line then
				line = Instance.new("Frame")
				line.Name = "Tracer"
				-- Frames rotate around their center, so the line is placed at
				-- the midpoint. (Before it was anchored at one end and drawn
				-- in the wrong place when rotated.)
				line.AnchorPoint = Vector2.new(0.5, 0.5)
				line.BackgroundColor3 = Theme.Accent2
				line.BorderSizePixel = 0
				line.Visible = false
				line.Parent = TracerGui
				Tracers[player] = line
			end

			local character = player.Character
			local targetRoot = character and character:FindFirstChild("HumanoidRootPart")
			local shown = false

			if targetRoot and Root and not IsTeamBlocked(player) then
				local distance = (Root.Position - targetRoot.Position).Magnitude
				local point, onScreen = cam:WorldToViewportPoint(targetRoot.Position)

				if onScreen and distance <= Config.ESPMaxDistance then
					local endPoint = Vector2.new(point.X, point.Y)
					local delta = endPoint - startPoint
					local mid = (startPoint + endPoint) / 2

					line.Position = UDim2.fromOffset(mid.X, mid.Y)
					line.Size = UDim2.fromOffset(delta.Magnitude, 2)
					line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
					line.BackgroundColor3 = Config.RainbowESP
						and Color3.fromHSV((os.clock() * 0.12) % 1, 0.8, 1)
						or Theme.Accent2
					shown = true
				end
			end

			line.Visible = shown
		end
	end
end

