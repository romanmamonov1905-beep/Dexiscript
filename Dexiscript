        visibleCount += 1
    elseif clock then
        clock.Visible = false
    end

    if Config.SessionTimer and session then
        local started = frame:GetAttribute("DexiSessionStart") or os.clock()
        local elapsed = math.max(0, math.floor(os.clock() - started))
        local hours = math.floor(elapsed / 3600)
        local minutes = math.floor((elapsed % 3600) / 60)
        local seconds = elapsed % 60
        session.Text = string.format("Session %02d:%02d:%02d", hours, minutes, seconds)
        session.Visible = true
        visibleCount += 1
    elseif session then
        session.Visible = false
    end

    if Config.PlayerCountOverlay and players then
        players.Text = "Players  " .. tostring(#Players:GetPlayers())
        players.Visible = true
        visibleCount += 1
    elseif players then
        players.Visible = false
    end

    if Config.ServerInfoOverlay and server then
        server.Text = "Place  " .. tostring(game.PlaceId) .. "  |  Job " .. string.sub(game.JobId, 1, 8)
        server.Visible = true
        visibleCount += 1
    elseif server then
        server.Visible = false
    end

    frame.Visible = visibleCount > 0
end

