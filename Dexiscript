local function SetPage(name)
	for pageName, page in pairs(Pages) do
		page.Visible = pageName == name
	end

	for pageName, tab in pairs(Tabs) do
		tab.BackgroundColor3 =
			pageName == name
			and Theme.CardActive
			or Theme.Card
	end
end

local function CreateTab(text, pageName)
	local tab = Instance.new("TextButton")
	tab.Name = "Tab_" .. pageName
	tab.Size = UDim2.fromOffset(116, 30)
	tab.BackgroundColor3 = Theme.Card
	tab.BorderSizePixel = 0
	tab.Text = text
	tab.TextColor3 = Theme.Text
	tab.Font = Enum.Font.GothamMedium
	tab.TextSize = 9
	tab.TextXAlignment = Enum.TextXAlignment.Left
	tab.LayoutOrder = orderFor(Sidebar)
	tab.Parent = Sidebar

	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.Parent = tab

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 7)
	corner.Parent = tab

	tab.MouseEnter:Connect(function()
		if not Pages[pageName].Visible then
			tab.BackgroundColor3 = Theme.CardHover
		end
	end)

	tab.MouseLeave:Connect(function()
		if not Pages[pageName].Visible then
			tab.BackgroundColor3 = Theme.Card
		end
	end)

	tab.MouseButton1Click:Connect(function()
		SetPage(pageName)
	end)

	Tabs[pageName] = tab
end

