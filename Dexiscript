local function GetPing()
    local ok, value = pcall(function()
        return LocalPlayer:GetNetworkPing()
    end)

    if ok and typeof(value) == "number" then
        return math.floor(value * 1000 + 0.5)
    end

    return 0
end

--============================================================
-- TOGGLE KEYBIND DISPATCHER
--============================================================

UIS.InputBegan:Connect(function(input, processed)
    if CapturingKeybind then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local featureId = CapturingKeybind
            local controller = ToggleControllers[featureId]

            if controller then
                if input.KeyCode == Enum.KeyCode.Backspace then
                    Keybinds[featureId] = nil
                elseif input.KeyCode == Enum.KeyCode.Escape then
                    -- Cancel capture.
                else
                    Keybinds[featureId] = input.KeyCode
                end

                controller.Refresh(false)
                MarkConfigDirty()
            end

            CapturingKeybind = nil
        end

        return
    end

    if processed then
        return
    end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        for featureId, keyCode in pairs(Keybinds) do
            if keyCode and input.KeyCode == keyCode then
                local controller = ToggleControllers[featureId]

                if controller then
                    controller.Setter(not controller.Getter())
                    controller.Refresh(true)
                end

                break
            end
        end
    end
end)

