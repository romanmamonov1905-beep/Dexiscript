local firstTab = true
local function RegisterTab(tabName, layoutOrder)
	local TabBtn = Instance.new("TextButton")
	TabBtn.Size = UDim2.new(0, 105, 0, 32)
	TabBtn.BackgroundColor3 = Color3.fromRGB(26, 20, 35)
	TabBtn.Text = tabName
	TabBtn.TextColor3 = Color3.fromRGB(160, 150, 180)
	TabBtn.Font = Enum.Font.GothamMedium
	TabBtn.TextSize = 12
	TabBtn.LayoutOrder = layoutOrder
	TabBtn.Parent = Sidebar
	Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)
	
	local ScrollContainer = Instance.new("ScrollingFrame")
	ScrollContainer.Size = UDim2.new(1, 0, 1, 0)
	ScrollContainer.BackgroundTransparency = 1
	ScrollContainer.BorderSizePixel = 0
	ScrollContainer.ScrollBarThickness = 3
	ScrollContainer.ScrollBarImageColor3 = Color3.fromRGB(130, 30, 240)
	ScrollContainer.Visible = firstTab
	ScrollContainer.Parent = TabContentFrame
	
	local List = Instance.new("UIListLayout")
	List.Padding = UDim.new(0, 6)
	List.SortOrder = Enum.SortOrder.LayoutOrder
	List.Parent = ScrollContainer
	
	List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		ScrollContainer.CanvasSize = UDim2.new(0, 0, 0, List.AbsoluteContentSize.Y + 10)
	end)
	
	if firstTab then
		TabBtn.BackgroundColor3 = Color3.fromRGB(110, 30, 200)
		TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		firstTab = false
	end
	
	Tabs[tabName] = ScrollContainer
	
	TabBtn.MouseButton1Click:Connect(function()
		for _, sc in pairs(Tabs) do sc.Visible = false end
		for _, b in ipairs(Sidebar:GetChildren()) do
			if b:IsA("TextButton") then
				b.BackgroundColor3 = Color3.fromRGB(26, 20, 35)
				b.TextColor3 = Color3.fromRGB(160, 150, 180)
			end
		end
		ScrollContainer.Visible = true
		TabBtn.BackgroundColor3 = Color3.fromRGB(110, 30, 200)
		TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)
end

local function AddButton(tabName, text, stateKey, callback)
	local targetContainer = Tabs[tabName]
	States[stateKey] = false
	local Btn = Instance.new("TextButton")
	Btn.Size = UDim2.new(1, -5, 0, 34)
	Btn.BackgroundColor3 = Color3.fromRGB(25, 20, 32)
	Btn.Text = text
	Btn.TextColor3 = Color3.fromRGB(190, 190, 190)
	Btn.Font = Enum.Font.GothamMedium
	Btn.TextSize = 12
	Btn.AutoButtonColor = false
	Btn.Parent = targetContainer
	Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
	local stroke = Instance.new("UIStroke", Btn)
	stroke.Color = Color3.fromRGB(45, 38, 55)
	
	Btn.MouseButton1Click:Connect(function()
		States[stateKey] = not States[stateKey]
		callback(States[stateKey])
		if States[stateKey] then
			Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			Btn.BackgroundColor3 = Color3.fromRGB(110, 30, 200)
			stroke.Color = Color3.fromRGB(180, 80, 255)
		else
			Btn.TextColor3 = Color3.fromRGB(190, 190, 190)
			Btn.BackgroundColor3 = Color3.fromRGB(25, 20, 32)
			stroke.Color = Color3.fromRGB(45, 38, 55)
		end
	end)
end

local function AddSlider(tabName, name, min, max, default, callback)
	local targetContainer = Tabs[tabName]
	local SliderBg = Instance.new("Frame")
	SliderBg.Size = UDim2.new(1, -5, 0, 42)
	SliderBg.BackgroundColor3 = Color3.fromRGB(25, 20, 32)
	SliderBg.Parent = targetContainer
	Instance.new("UICorner", SliderBg).CornerRadius = UDim.new(0, 6)
	
	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, -16, 0, 18)
	Label.Position = UDim2.new(0, 8, 0, 2)
	Label.BackgroundTransparency = 1
	Label.Text = name .. ": " .. tostring(default)
	Label.TextColor3 = Color3.fromRGB(170, 160, 180)
	Label.Font = Enum.Font.GothamSemibold
	Label.TextSize = 11
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = SliderBg
	
	local Track = Instance.new("Frame")
	Track.Size = UDim2.new(1, -16, 0, 4)




Track.Position = UDim2.new(0, 8, 0, 26)
Track.BackgroundColor3 = Color3.fromRGB(45, 35, 55)
Track.BorderSizePixel = 0
Track.Parent = SliderBg

local Fill = Instance.new("Frame")
Fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
Fill.BackgroundColor3 = Color3.fromRGB(130, 30, 240)
Fill.BorderSizePixel = 0
Fill.Parent = Track

local dragging = false
local function update(input)
local relX = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
Fill.Size = UDim2.new(relX, 0, 1, 0)
local val = math.floor(min + (max - min) * relX)
Label.Text = name .. ": " .. tostring(val)
callback(val)
end
Track.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true update(i) end end)
UserInputService.InputChanged:Connect(function(i) if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then update(i) end end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
end



