								player.Character:FindFirstChildOfClass(
									"Humanoid"
								)

							if targetRoot
								and humanoid
								and humanoid.Health > 0 then

								if (
									targetRoot.Position - root.Position
								).Magnitude < 18 then

									if not character:FindFirstChild("Knife") then
										if knife:IsA("Tool") then
											humanoid:EquipTool(knife)
										end
									end

									if knife:IsA("Tool") then
										knife:Activate()
									end
								end
							end
						end
					end
				end)
