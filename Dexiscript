		Config[definition.field] = false
	end
	Config.RespawnPoint = "Default"

	ClearAimTarget()
	CapturingKeybind = nil
	CapturingGlobalKeybind = nil

	if TargetMenu then
		TargetMenu.Visible = false
	end

	MarkConfigDirty()
	if RefreshConfigUI then
		RefreshConfigUI()
	end

	Gui.Enabled = false
end

--============================================================
-- INPUT (single handler so capture / open / panic / feature keys run in
-- a fixed order and never double-trigger on the same key press)
--============================================================

function HandleGlobalCapture(input)
	local target = CapturingGlobalKeybind
	local isKeyboard = input.UserInputType == Enum.UserInputType.Keyboard
	local isMouseKey = input.UserInputType == Enum.UserInputType.MouseButton2
		or input.UserInputType == Enum.UserInputType.MouseButton3

	if not isKeyboard and not (target == "AimKey" and isMouseKey) then
		return
	end

	CapturingGlobalKeybind = nil

	if isKeyboard and input.KeyCode == Enum.KeyCode.Escape then
		RefreshKeyButtons()
		return
	end

	if target == "AimKey" then
		if isKeyboard and input.KeyCode == Enum.KeyCode.Backspace then
			Config.AimKey = nil
		elseif isKeyboard then
			Config.AimKey = input.KeyCode
		else
			Config.AimKey = input.UserInputType
		end
	elseif target == "OpenKey" then
		if input.KeyCode == Config.PanicKey then
			Notify("Keybind", "That key is already the Panic Key.", 2)
		else
			Config.OpenKey = input.KeyCode
		end
	elseif target == "PanicKey" then
		if input.KeyCode == Config.OpenKey then
			Notify("Keybind", "That key is already the Open Key.", 2)
		else
			Config.PanicKey = input.KeyCode
		end
	end

	MarkConfigDirty()
	RefreshKeyButtons()
end

function HandleFeatureCapture(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	local featureId = CapturingKeybind
	CapturingKeybind = nil

	local controller = ToggleControllers[featureId]
	if not controller then
		return
	end

	local key = input.KeyCode

	if key == Enum.KeyCode.Backspace then
		Keybinds[featureId] = nil
		MarkConfigDirty()
	elseif key == Enum.KeyCode.Escape then
		-- cancelled
	elseif key == Config.OpenKey or key == Config.PanicKey then
		Notify("Keybind", "That key is reserved for Open/Panic.", 2)
	else
		Keybinds[featureId] = key
		MarkConfigDirty()
	end

	controller.Refresh(false)
end

UIS.InputBegan:Connect(function(input, processed)
	if CapturingGlobalKeybind then
		HandleGlobalCapture(input)
		return
	end

	if CapturingKeybind then
		HandleFeatureCapture(input)
		return
	end

	if processed then
		return
	end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == Config.OpenKey then
			ToggleMenu()
			return
		end

		if input.KeyCode == Config.PanicKey then
			Panic()
			return
		end

		if input.KeyCode == Enum.KeyCode.Q and Config.Dash and not Config.FreeCamera then
			DoDash()
		end

		for featureId, keyCode in pairs(Keybinds) do
			if keyCode == input.KeyCode then
				local controller = ToggleControllers[featureId]
				if controller then
					controller.Setter(not controller.Getter())
					controller.Refresh(true)
					MarkConfigDirty()
				end
			end
		end
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local ctrl = UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)

		if Config.ClickDelete and ctrl then
			DoClickDelete()
			return
		end

		if Config.ClickTeleport then
			DoClickTeleport()
		end
	end
end)

