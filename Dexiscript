--============================================================

local function SameTeam(a, b)
    return
        a.Team ~= nil
        and a.Team == b.Team
end

local function IsVisible(character, part)
    local origin =
        Camera.CFrame.Position

    local direction =
        part.Position - origin

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances =
        {Character}

    params.IgnoreWater = true

    local result =
        Workspace:Raycast(
            origin,
            direction,
            params
        )

    if not result then
        return true
    end

    return result.Instance:IsDescendantOf(
        character
    )
end

local function FindAimTarget()
    if not Root then
        return nil
    end

    local viewport =
        Camera.ViewportSize

    local center =
        Vector2.new(
            viewport.X / 2,
            viewport.Y / 2
        )

    local closest
    local closestDistance =
        Config.AimFOV

    for _, player in ipairs(
        Players:GetPlayers()
    ) do
        if player ~= LocalPlayer then
            if not (
                Config.AimTeamCheck
                and SameTeam(
                    LocalPlayer,
                    player
                )
            ) then
                local character =
                    player.Character

                local humanoid =
                    character
                    and character:
                        FindFirstChildOfClass(
                            "Humanoid"
                        )

                local root =
                    character
                    and character:
                        FindFirstChild(
                            "HumanoidRootPart"
                        )

                local part =
                    character
                    and character:
                        FindFirstChild(
                            Config.AimPart
                        )

                if humanoid
                    and humanoid.Health > 0
                    and root
                    and part
                then
                    local worldDistance =
                        (
                            Root.Position -
                            root.Position
                        ).Magnitude

                    if worldDistance <=
                        Config.AimMaxDistance
                    then
                        local point, onScreen =
                            Camera:
                                WorldToViewportPoint(
                                    part.Position
                                )

                        if onScreen then
                            local screenDistance =
                                (
                                    Vector2.new(
                                        point.X,
                                        point.Y
                                    ) -
                                    center
                                ).Magnitude

                            if screenDistance <=
                                closestDistance
                            then
                                if
                                    not Config.AimVisibleCheck
                                    or IsVisible(
                                        character,
                                        part
                                    )
                                then
                                    closest = {
                                        Player = player,
                                        Character = character,
                                        Part = part
                                    }

                                    closestDistance =
                                        screenDistance
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return closest
end

local function AimActive()
    if not Config.AimHold then
        return true
    end

    if not Config.AimKey then
        return false
    end

    return UIS:IsKeyDown(
        Config.AimKey
    )
end

local function UpdateAim()
    AimCircle.Visible =
        Config.AimAssist

    AimCircle.Size =
        UDim2.fromOffset(
            Config.AimFOV * 2,
            Config.AimFOV * 2
        )

    if not Config.AimAssist then
        CurrentTarget = nil
        return
    end

    if not AimActive() then
        if not Config.AimSticky then
            CurrentTarget = nil
        end

        return
    end

    if not Config.AimSticky
        or not CurrentTarget
    then
        CurrentTarget =
            FindAimTarget()
    end

    if not CurrentTarget then
        return
    end

    local character =
        CurrentTarget.Character

    local part =
        character
        and character:
            FindFirstChild(
                Config.AimPart
            )

    if not part then
        CurrentTarget = nil
        return
    end

    local desired =
        CFrame.lookAt(
            Camera.CFrame.Position,
            part.Position
        )

    Camera.CFrame =
        Camera.CFrame:Lerp(
            desired,
            Config.AimSmoothness
        )
end

