	task.delay(duration or 3, function()
		if box.Parent then
			box:Destroy()
		end
	end)
end

--============================================================
-- SIMPLE CONFIG MANAGER
-- NOTE: A LocalScript cannot write DataStores. Configs are session-only
-- until a server-side persistence layer is added.
--============================================================

Profiles = {}
CurrentProfileName = "Default"
ConfigDirty = false

ProfileNameBox = nil
ProfileDropdownButton = nil
ProfileDropdownList = nil
ProfileStatus = nil

function DeepCopy(value, seen)
	if typeof(value) ~= "table" then
		return value
	end

	seen = seen or {}
	if seen[value] then
		return seen[value]
	end

	local copy = {}
	seen[value] = copy

	for key, child in pairs(value) do
		copy[DeepCopy(key, seen)] = DeepCopy(child, seen)
	end

	return copy
end

function CleanConfigName(value)
	local name = tostring(value or "")
	name = name:gsub("^%s+", "")
	name = name:gsub("%s+$", "")
	name = name:gsub("%c", "")
	if name == "" then
		return nil
	end
	return string.sub(name, 1, 24)
end

function SnapshotConfig()
	return {
		Config = DeepCopy(Config),
		Keybinds = DeepCopy(Keybinds),
		Waypoints = DeepCopy(Waypoints),
	}
end

function ConfigNames()
	local names = {}
	for name in pairs(Profiles) do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

function ProfileNotify(message)
	if Config.NotifyProfileChanges then
		Notify("Config", message, 2)
	end
end

function MarkConfigDirty()
	ConfigDirty = true

	if Config.AutoSaveProfile and Profiles[CurrentProfileName] then
		Profiles[CurrentProfileName] = SnapshotConfig()
		ConfigDirty = false
	end

	-- Only the status text is refreshed here. Rebuilding the whole profile
	-- list on every slider frame was slow and wiped the typed config name.
	if RefreshProfileStatus then
		RefreshProfileStatus()
	end
end

function ApplySnapshot(snapshot)
	if not snapshot or not snapshot.Config then
		return false
	end

	for key, value in pairs(snapshot.Config) do
		Config[key] = DeepCopy(value)
	end

	for key in pairs(Keybinds) do
		Keybinds[key] = nil
	end
	for key, value in pairs(snapshot.Keybinds or {}) do
		Keybinds[key] = DeepCopy(value)
	end

	for key in pairs(Waypoints) do
		Waypoints[key] = nil
	end
	for key, value in pairs(snapshot.Waypoints or {}) do
		Waypoints[key] = DeepCopy(value)
	end

	ConfigDirty = false
	SkyboxForceRefresh = true

	if RefreshConfigUI then
		RefreshConfigUI()
	end
	if RefreshProfileUI then
		RefreshProfileUI()
	end
	return true
end

function SaveCurrentProfile()
	Profiles[CurrentProfileName] = SnapshotConfig()
	ConfigDirty = false
	if RefreshProfileUI then
		RefreshProfileUI()
	end
	ProfileNotify("Saved: " .. CurrentProfileName)
	return true
end

function CreateProfile(name)
	local clean = CleanConfigName(name)
	if not clean then
		Notify("Config", "Enter a config name.", 2)
		return false
	end
	if Profiles[clean] then
		Notify("Config", "That config already exists.", 2)
		return false
	end
	Profiles[clean] = SnapshotConfig()
	CurrentProfileName = clean
	ConfigDirty = false
	if RefreshProfileUI then
		RefreshProfileUI()
	end
	ProfileNotify("Created: " .. clean)
	return true
end

function LoadProfile(name)
	if not Profiles[name] then
		Notify("Config", "Config not found.", 2)
		return false
	end
	CurrentProfileName = name
	local ok = ApplySnapshot(Profiles[name])
	if ok then
		ProfileNotify("Loaded: " .. name)
	end
	return ok
end

function RenameCurrentProfile(name)
	local clean = CleanConfigName(name)
	if not clean then
		Notify("Config", "Enter a config name.", 2)
		return false
	end
	if clean ~= CurrentProfileName and Profiles[clean] then
		Notify("Config", "That config already exists.", 2)
		return false
	end
	if clean ~= CurrentProfileName then
		Profiles[clean] = Profiles[CurrentProfileName] or SnapshotConfig()
		Profiles[CurrentProfileName] = nil
		CurrentProfileName = clean
	end
	if RefreshProfileUI then
		RefreshProfileUI()
	end
	ProfileNotify("Renamed to: " .. clean)
	return true
end

function DeleteCurrentProfile()
	if #ConfigNames() <= 1 then
		Notify("Config", "Keep at least one config.", 2)
		return false
	end

	if Config.ConfirmDeleteProfile and os.clock() > DeleteConfirmUntil then
		DeleteConfirmUntil = os.clock() + 3
		Notify("Config", "Press DELETE again to remove '" .. CurrentProfileName .. "'.", 3)
		return false
	end
	DeleteConfirmUntil = 0

	local removed = CurrentProfileName
	Profiles[removed] = nil
	CurrentProfileName = ConfigNames()[1]
	ApplySnapshot(Profiles[CurrentProfileName])
	ProfileNotify("Deleted: " .. removed)
	return true
end

