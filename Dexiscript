function safeUnit(vector)
	if vector.Magnitude > 0.0001 then
		return vector.Unit
	end
	return Vector3.zero
end

function getCamera()
	return Workspace.CurrentCamera
end

function isAlive()
	return Humanoid ~= nil
		and Root ~= nil
		and Root.Parent ~= nil
		and Humanoid.Health > 0
end

function IsTyping()
	return UIS:GetFocusedTextBox() ~= nil
end

function SameTeam(a, b)
	return a.Team ~= nil and a.Team == b.Team
end

function KeyName(key)
	if typeof(key) == "EnumItem" then
		return key.Name
	end
	return "-"
end

-- Runs an update step in protected mode so one failing feature can no longer
-- abort every update after it in the same frame. Each error is reported once.
ErrorReported = {}

function SafeCall(name, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok and not ErrorReported[name] then
		ErrorReported[name] = true
		warn("[Dexi] " .. name .. " failed: " .. tostring(err))
	end
	return ok
end

-- Property overrides that remember the original value and restore it exactly
-- once when the feature is turned off. Without this the script overwrote the
-- game's own lighting / camera / humanoid values every single frame.
ManagedProps = setmetatable({}, {__mode = "k"})

function SetManaged(object, property, active, value)
	if not object then
		return
	end

	local store = ManagedProps[object]

	if active then
		if not store then
			store = {}
			ManagedProps[object] = store
		end

		if store[property] == nil then
			local ok, original = pcall(function()
				return object[property]
			end)
			if not ok then
				return
			end
			store[property] = {Value = original}
		end

		pcall(function()
			if object[property] ~= value then
				object[property] = value
			end
		end)
	elseif store and store[property] ~= nil then
		local original = store[property].Value
		store[property] = nil
		pcall(function()
			object[property] = original
		end)
	end
end

function GetOriginal(object, property)
	local store = ManagedProps[object]
	if store and store[property] ~= nil then
		return store[property].Value
	end

	local ok, value = pcall(function()
		return object[property]
	end)
	return ok and value or nil
end

function TeleportCharacter(cframe)
	if not Character or not Root or not cframe then
		return
	end

	Root.AssemblyLinearVelocity = Vector3.zero

	local ok = pcall(function()
		Character:PivotTo(cframe)
	end)

	if not ok then
		Root.CFrame = cframe
	end
end

function FindSpawnCFrame()
	local spawn = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawn then
		return spawn.CFrame + Vector3.new(0, 4, 0)
	end
	return nil
end

