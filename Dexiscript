function IsGrounded()
	return Humanoid ~= nil and Humanoid.FloorMaterial ~= Enum.Material.Air
end

function UpdateBunnyHop(dt)
	if not Config.BunnyHop or not Humanoid or not Root then
		return
	end

	local state = Humanoid:GetState()
	local grounded = IsGrounded()
		and state ~= Enum.HumanoidStateType.Freefall
		and state ~= Enum.HumanoidStateType.Jumping

	local moving = Humanoid.MoveDirection.Magnitude > 0.05

	if grounded and moving then
		Humanoid.Jump = true
		return
	end

	if grounded then
		return
	end

	-- CS-style air acceleration: keep momentum, accelerate toward input.
	local velocity = Root.AssemblyLinearVelocity
	local horizontal = Vector3.new(velocity.X, 0, velocity.Z)

	if moving and Config.BhopAirStrafe then
		local wishDir = Humanoid.MoveDirection.Unit
		local maxSpeed = math.max(Config.BhopMaxSpeed, Config.WalkSpeed)
		local addSpeed = maxSpeed - horizontal:Dot(wishDir)

		if addSpeed > 0 then
			local accel = Config.BhopAcceleration * maxSpeed * math.max(dt, 1 / 240)
			horizontal += wishDir * math.min(addSpeed, accel)
		end

		if horizontal.Magnitude > maxSpeed then
			horizontal = horizontal.Unit * maxSpeed
		end

		Root.AssemblyLinearVelocity = Vector3.new(horizontal.X, velocity.Y, horizontal.Z)
	end

	if Config.BhopJumpBuffer and IsGrounded() then
		Humanoid.Jump = true
	end
end

function UpdateGlide()
	if not Config.Glide or not Root or not Humanoid or IsGrounded() then
		return
	end

	local velocity = Root.AssemblyLinearVelocity
	if velocity.Y < -18 then
		Root.AssemblyLinearVelocity = Vector3.new(velocity.X, -18, velocity.Z)
	end
end

function UpdateHover()
	if not Config.Hover or not Root or not Humanoid or IsGrounded() then
		return
	end

	local velocity = Root.AssemblyLinearVelocity
	Root.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)
end

function UpdateEdgeJump()
	if not Config.EdgeJump or not Humanoid then
		ExtraState.PreviousOnGround = true
		return
	end

	local onGround = IsGrounded()

	if ExtraState.PreviousOnGround and not onGround
		and Humanoid:GetState() == Enum.HumanoidStateType.Freefall
	then
		-- Humanoid.Jump does nothing mid-air; force the jump state instead.
		Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end

	ExtraState.PreviousOnGround = onGround
end

function UpdateMovementExtras(dt)
	if not Humanoid or not Root then
		SetManaged(Workspace, "Gravity", Config.LocalGravity, Config.GravityValue)
		return
	end

	local ex = ExtraState.Extras
	local grounded = IsGrounded()

	if Config.FastFall and Humanoid:GetState() == Enum.HumanoidStateType.Freefall then
		local v = Root.AssemblyLinearVelocity
		if v.Y > -Config.FastFallSpeed then
			Root.AssemblyLinearVelocity = Vector3.new(v.X, -Config.FastFallSpeed, v.Z)
		end
	end

	if Config.LandBoost and grounded and not ex.LastOnGround then
		local dir = Humanoid.MoveDirection
		if dir.Magnitude > 0.05 then
			Root.AssemblyLinearVelocity += dir.Unit * Config.LandBoostPower
		end
	end
	ex.LastOnGround = grounded

	if Config.AirControl and not Config.BunnyHop and not grounded then
		local dir = Humanoid.MoveDirection
		if dir.Magnitude > 0.05 then
			local v = Root.AssemblyLinearVelocity
			local target = dir.Unit * math.max(Vector3.new(v.X, 0, v.Z).Magnitude, Config.WalkSpeed)
			local alpha = math.clamp(Config.AirControlStrength * dt * 8, 0, 1)
			Root.AssemblyLinearVelocity = Vector3.new(
				v.X + (target.X - v.X) * alpha,
				v.Y,
				v.Z + (target.Z - v.Z) * alpha
			)
		end
	end

	SetManaged(Workspace, "Gravity", Config.LocalGravity, Config.GravityValue)
end

