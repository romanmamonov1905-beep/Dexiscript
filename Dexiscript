local function UpdateActiveInfo()
    if not ActiveInfo then
        return
    end

    local active = {}

    for _, definition in ipairs(ActiveFeatureDefinitions) do
        if Config[definition.field] == true then
            table.insert(active, definition.label)
        end
    end

    if #active == 0 then
        ActiveInfo.Text = "No features currently active."
    else
        local rows = {}
        local currentRow = {}

        for index, name in ipairs(active) do
            table.insert(currentRow, name)

            if #currentRow >= 4 or index == #active then
                table.insert(
                    rows,
                    table.concat(currentRow, "  |  ")
                )
                currentRow = {}
            end
        end

        ActiveInfo.Text = table.concat(rows, "\n")
    end
end

