TargetMenu = nil
TargetButton = nil

function GetPlayerList()
	local list = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			table.insert(list, player)
		end
	end

	table.sort(list, function(left, right)
		local a = left.Name:lower()
		local b = right.Name:lower()
		if a == b then
			return left.UserId < right.UserId
		end
		return a < b
	end)

	return list
end

function IsValidTargetPlayer(player)
	if not player or player == LocalPlayer or player.Parent ~= Players then
		return false
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local targetRoot = character and character:FindFirstChild("HumanoidRootPart")

	return humanoid ~= nil and humanoid.Health > 0 and targetRoot ~= nil
end

function SelectedTargetText()
	if IsValidTargetPlayer(SelectedTarget) then
		return SelectedTarget.DisplayName .. " [" .. SelectedTarget.Name .. "]"
	end
	return "No target selected"
end

function LocalTargetFling()
	if not isAlive() then
		return
	end

	if not IsValidTargetPlayer(SelectedTarget) then
		Notify("Target Fling", "Select a valid player first.", 3)
		return
	end

	local targetRoot = SelectedTarget.Character:FindFirstChild("HumanoidRootPart")
	if not targetRoot then
		return
	end

	local direction = safeUnit(targetRoot.Position - Root.Position)
	if direction.Magnitude <= 0 then
		return
	end

	Root.AssemblyLinearVelocity =
		direction * Config.TargetFlingSpeed
		+ Vector3.new(0, Config.TargetFlingPower * 0.35, 0)

	Root.AssemblyAngularVelocity = Vector3.new(0, Config.TargetFlingPower, 0)

	pcall(function()
		targetRoot:ApplyImpulse(direction * targetRoot.AssemblyMass * Config.TargetFlingPower)
	end)
end

function LocalTouchFlingTarget(targetPlayer)
	if not Config.TouchFlingOther
		or TouchFlingDebounce
		or not IsValidTargetPlayer(targetPlayer)
		or not Root
	then
		return
	end

	local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not targetRoot then
		return
	end

	TouchFlingDebounce = true

	local direction = safeUnit(targetRoot.Position - Root.Position)

	pcall(function()
		Root.AssemblyLinearVelocity = direction * Config.TouchFlingPower
		targetRoot:ApplyImpulse(direction * targetRoot.AssemblyMass * Config.TouchFlingPower)
	end)

	task.delay(0.25, function()
		TouchFlingDebounce = false
	end)
end

function DoTouchBoost()
	if not Config.TouchBoost or not Root or TouchBoostDebounce then
		return
	end

	TouchBoostDebounce = true

	local cam = getCamera()
	local direction = cam and safeUnit(cam.CFrame.LookVector) or Vector3.zero

	Root.AssemblyLinearVelocity =
		direction * Config.TouchBoostPower
		+ Vector3.new(0, Config.TouchBoostPower * 0.35, 0)

	task.delay(0.25, function()
		TouchBoostDebounce = false
	end)
end

function OnCharacterTouched(hit)
	if not hit or not hit.Parent then
		return
	end
	if Character and hit:IsDescendantOf(Character) then
		return
	end

	if Config.TouchBoost then
		DoTouchBoost()
	end

	if Config.TouchFlingOther then
		local otherCharacter = hit:FindFirstAncestorOfClass("Model")
		local player = otherCharacter and Players:GetPlayerFromCharacter(otherCharacter)
		if player and player ~= LocalPlayer then
			LocalTouchFlingTarget(player)
		end
	end
end

-- Hooks both Touch Boost and Touch Fling to every character part, including
-- parts that load later (accessories). Previously Touch Boost was never
-- reconnected after respawning, so it silently stopped working.
function ConnectCharacterTouch(character)
	if not character then
		return
	end

	local function hook(object)
		if object:IsA("BasePart") then
			object.Touched:Connect(OnCharacterTouched)
		end
	end

	for _, object in ipairs(character:GetDescendants()) do
		hook(object)
	end

	character.DescendantAdded:Connect(hook)
end

