-- CONFIG PROFILE MANAGER
--============================================================

local Profiles = {}
local CurrentProfileName = "Default"
local ConfigDirty = false

local ProfileNameBox
local ProfileSelectorButton
local ProfileStatus
local RefreshProfileUI
local RefreshConfigUI

local function DeepCopy(value, seen)
    if typeof(value) ~= "table" then
        return value
    end

    seen = seen or {}

    if seen[value] then
        return seen[value]
    end

    local copy = {}
    seen[value] = copy

    for key, child in pairs(value) do
        copy[DeepCopy(key, seen)] = DeepCopy(child, seen)
    end

    return copy
end

local function CleanProfileName(value)
    local name = tostring(value or "")
    name = name:gsub("^%s+", "")
    name = name:gsub("%s+$", "")
    name = name:gsub("[%c]", "")

    if name == "" then
        return nil
    end

    return string.sub(name, 1, 24)
end

local function UniqueProfileName(value)
    local base = CleanProfileName(value) or "Config"

    if not Profiles[base] then
        return base
    end

    local number = 2

    while Profiles[base .. " " .. number] do
        number += 1
    end

    return base .. " " .. number
end

local function SnapshotConfig()
    return {
        Config = DeepCopy(Config),
        Keybinds = DeepCopy(Keybinds),
        Waypoints = DeepCopy(Waypoints),
    }
end

local function RefreshProfileCount()
    local count = 0

    for _ in pairs(Profiles) do
        count += 1
    end

    return count
end

local function MarkConfigDirty()
    ConfigDirty = true

    if Config.AutoSaveProfile
        and Profiles[CurrentProfileName]
    then
        Profiles[CurrentProfileName] =
            SnapshotConfig()

        ConfigDirty = false
    end

    if RefreshProfileUI then
        RefreshProfileUI()
    end
end

local function ApplySnapshot(snapshot)
    if not snapshot
        or not snapshot.Config
    then
        return false
    end

    for key, value in pairs(snapshot.Config) do
        Config[key] = DeepCopy(value)
    end

    for key in pairs(Keybinds) do
        Keybinds[key] = nil
    end

    if snapshot.Keybinds then
        for key, value in pairs(snapshot.Keybinds) do
            Keybinds[key] = DeepCopy(value)
        end
    end

    for key in pairs(Waypoints) do
        Waypoints[key] = nil
    end

    if snapshot.Waypoints then
        for key, value in pairs(snapshot.Waypoints) do
            Waypoints[key] = DeepCopy(value)
        end
    end

    ConfigDirty = false

    if RefreshConfigUI then
        RefreshConfigUI()
    end

    if RefreshProfileUI then
        RefreshProfileUI()
    end

    return true
end

local function SaveCurrentProfile(silent)
    Profiles[CurrentProfileName] =
        SnapshotConfig()

    ConfigDirty = false

    if not silent
        and Config.NotifyProfileChanges
    then
        Notify(
            "Config",
            "Saved: " .. CurrentProfileName,
            2
        )
    end

    if RefreshProfileUI then
        RefreshProfileUI()
    end
end

local function CreateProfile(name)
    local clean =
        UniqueProfileName(name)

    Profiles[clean] =
        SnapshotConfig()

    CurrentProfileName =
        clean

    ConfigDirty = false

    if Config.NotifyProfileChanges then
        Notify(
            "Config",
            "Created: " .. clean,
            2
        )
    end

    if RefreshProfileUI then
        RefreshProfileUI()
    end
end

local function LoadProfile(name)
    if not Profiles[name] then
        Notify(
            "Config",
            "Profile not found.",
            2
        )
        return false
    end

    CurrentProfileName = name

    return ApplySnapshot(
        Profiles[name]
    )
end

local function RenameCurrentProfile(name)
    local clean =
        CleanProfileName(name)

    if not clean then
        Notify(
            "Config",
            "Enter a valid name.",
            2
        )
        return
    end

    if clean == CurrentProfileName then
        return
    end

    if Profiles[clean] then
        Notify(
            "Config",
            "That profile already exists.",
            2
        )
        return
    end

    Profiles[clean] =
        Profiles[CurrentProfileName]

    Profiles[CurrentProfileName] = nil

    CurrentProfileName =
        clean

    if Config.NotifyProfileChanges then
        Notify(
            "Config",
            "Renamed to: " .. clean,
            2
        )
    end

    if RefreshProfileUI then
        RefreshProfileUI()
    end
end

local function DuplicateCurrentProfile(name)
    local clean =
        UniqueProfileName(
            name
            or (CurrentProfileName .. " Copy")
        )

    Profiles[clean] =
        SnapshotConfig()

    CurrentProfileName =
        clean

    ConfigDirty = false

    if Config.NotifyProfileChanges then
        Notify(
            "Config",
            "Duplicated as: " .. clean,
            2
        )
    end

    if RefreshProfileUI then
        RefreshProfileUI()
    end
end

local function DeleteCurrentProfile()
    if CurrentProfileName == "Default" then
        Notify(
            "Config",
            "Default cannot be deleted.",
            2
        )
        return
    end

    Profiles[CurrentProfileName] = nil

    local names = {}

    for name in pairs(Profiles) do
        table.insert(names, name)
    end

    table.sort(names)

    CurrentProfileName =
        names[1]
        or "Default"

    if Profiles[CurrentProfileName] then
        ApplySnapshot(
            Profiles[CurrentProfileName]
        )
    else
        Profiles.Default =
            SnapshotConfig()

        CurrentProfileName =
            "Default"
    end

    ConfigDirty = false

    if Config.NotifyProfileChanges then
        Notify(
            "Config",
            "Deleted profile.",
            2
        )
    end

    if RefreshProfileUI then
        RefreshProfileUI()
    end
end

local function ResetCurrentProfile()
    if not Profiles.Default then
        Profiles.Default =
            SnapshotConfig()
    end

    ApplySnapshot(
        Profiles.Default
    )

    Profiles[CurrentProfileName] =
        SnapshotConfig()

    ConfigDirty = false

    if Config.NotifyProfileChanges then
        Notify(
            "Config",
            "Reset current profile.",
            2
        )
    end

    if RefreshProfileUI then
        RefreshProfileUI()
    end
end

local function RestoreDefaultProfile()
    if not Profiles.Default then
        Profiles.Default =
            SnapshotConfig()
    end

    CurrentProfileName =
        "Default"

    ApplySnapshot(
        Profiles.Default
    )

    ConfigDirty = false

    if Config.NotifyProfileChanges then
        Notify(
            "Config",
            "Default restored.",
            2
        )
    end

    if RefreshProfileUI then
        RefreshProfileUI()
    end
end

