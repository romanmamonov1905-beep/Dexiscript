	if InitialTab then
		button.BackgroundColor3 = Color3.fromRGB(140, 40, 255)
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
		InitialTab = false
	end

	Db.Tabs[name] = scroll

	button.MouseButton1Click:Connect(function()
		for _, page in pairs(Db.Tabs) do
			page.Visible = false
		end

		for _, child in ipairs(Sidebar:GetChildren()) do
			if child:IsA("TextButton") then
				child.BackgroundColor3 = Color3.fromRGB(24, 18, 34)
				child.TextColor3 = Color3.fromRGB(150, 140, 170)
			end
		end

		scroll.Visible = true
		button.BackgroundColor3 = Color3.fromRGB(140, 40, 255)
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)
end

