local function Disconnect(name)
	local connection = Db.Connections[name]

	if connection then
		connection:Disconnect()
		Db.Connections[name] = nil
	end
end

local function DestroyInstance(instance)
	if instance and instance.Parent then
		instance:Destroy()
	end
end

