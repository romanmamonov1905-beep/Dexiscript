        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
        terrain.WaterReflectance = 0
    elseif terrain:GetAttribute("DexiSavedDecoration") ~= nil then
        terrain.Decoration = terrain:GetAttribute("DexiSavedDecoration")
        terrain.WaterWaveSize = terrain:GetAttribute("DexiSavedWaveSize") or terrain.WaterWaveSize
        terrain.WaterWaveSpeed = terrain:GetAttribute("DexiSavedWaveSpeed") or terrain.WaterWaveSpeed
        terrain.WaterReflectance = terrain:GetAttribute("DexiSavedReflectance") or terrain.WaterReflectance
        terrain:SetAttribute("DexiSavedDecoration", nil)
        terrain:SetAttribute("DexiSavedWaveSize", nil)
        terrain:SetAttribute("DexiSavedWaveSpeed", nil)
        terrain:SetAttribute("DexiSavedReflectance", nil)
    end
end

