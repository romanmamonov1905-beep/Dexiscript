function SetupCharacter(character)
	Character = character
	Humanoid = character:WaitForChild("Humanoid")
	Root = character:WaitForChild("HumanoidRootPart")

	if Character ~= character then
		return
	end

	local humanoid = Humanoid
	local root = Root
	humanoid.Died:Connect(function()
		ExtraState.DeathCount += 1
		-- Last grounded spot, so dying in the void does not respawn you there.
		ExtraState.DeathCFrame = ExtraState.LastGroundCFrame or (root and root.CFrame)

		if Config.AutoRespawn then
			task.delay(0.5, function()
				if LocalPlayer.Character ~= character then
					return
				end
				-- LoadCharacter is server-only in live games; it only works
				-- where the client is allowed to call it (e.g. some Studio
				-- setups). Report instead of erroring silently.
				local ok = pcall(function()
					LocalPlayer:LoadCharacter()
				end)
				if not ok then
					Notify("Auto Respawn", "This game only allows the server to respawn you.", 3)
				end
			end)
		end
	end)
end

function OnCharacterAdded(character)
	-- Fly constraints and caches belonged to the previous character.
	DestroyFly()
	SavedCollision = {}
	SavedTransparency = {}
	ExtraState.SelfChamCache = {}
	ExtraState.PreviousOnGround = true
	ExtraState.SafeCFrame = nil
	ExtraState.AnimSpeedApplied = false
	ExtraState.Extras.LastOnGround = true
	ExtraState.Extras.StateFlags = {}
	ClearAimTarget()

	SetupCharacter(character)

	if Character ~= character then
		return
	end

	ConnectCharacterTouch(character)

	if Config.ResetOnRespawnCamera
		and not Config.FreeCamera
		and not Config.OrbitCamera
		and not Config.SpectateTarget
	then
		local cam = getCamera()
		if cam then
			cam.CameraSubject = Humanoid
			cam.CameraType = Enum.CameraType.Custom
		end
	end

	local deathCFrame = ExtraState.DeathCFrame
	ExtraState.DeathCFrame = nil
	ExtraState.LastGroundCFrame = nil

	if Config.RespawnPoint == "Death Point" and deathCFrame then
		task.delay(0.2, function()
			if Character == character then
				TeleportCharacter(deathCFrame + Vector3.new(0, 3, 0))
			end
		end)
	elseif Config.RespawnPoint == "Spawn" then
		task.delay(0.15, function()
			local cframe = FindSpawnCFrame()
			if cframe and Character == character then
				TeleportCharacter(cframe)
			end
		end)
	end
end

LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)

if LocalPlayer.Character then
	task.spawn(OnCharacterAdded, LocalPlayer.Character)
end

