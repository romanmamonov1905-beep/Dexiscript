function UpdateRadar()
	Radar.Visible = Config.Radar

	local cam = getCamera()

	if not Config.Radar or not Root or not cam then
		for _, dot in pairs(RadarDots) do
			dot.Visible = false
		end
		return
	end

	local half = Radar.AbsoluteSize.X / 2
	local look = safeUnit(Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z))
	local right = safeUnit(Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z))

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local dot = RadarDots[player]
			if not dot then
				dot = Instance.new("Frame")
				dot.Name = "Dot"
				dot.AnchorPoint = Vector2.new(0.5, 0.5)
				dot.Size = UDim2.fromOffset(5, 5)
				dot.BackgroundColor3 = Theme.Accent2
				dot.BorderSizePixel = 0
				dot.Parent = Radar

				local dotCorner = Instance.new("UICorner")
				dotCorner.CornerRadius = UDim.new(1, 0)
				dotCorner.Parent = dot

				RadarDots[player] = dot
			end

			local targetRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local shown = false

			if targetRoot then
				local offset = targetRoot.Position - Root.Position
				offset = Vector3.new(offset.X, 0, offset.Z)

				if offset.Magnitude <= Config.RadarRange then
					local x = offset:Dot(right) / Config.RadarRange * half
					local y = -offset:Dot(look) / Config.RadarRange * half
					dot.Position = UDim2.fromOffset(half + x, half + y)
					dot.BackgroundColor3 = SameTeam(LocalPlayer, player) and Theme.Green or Theme.Accent2
					shown = true
				end
			end

			dot.Visible = shown
		end
	end
end

