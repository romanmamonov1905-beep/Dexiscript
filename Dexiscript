function DestroyFly()
    if FlyVelocity then
        FlyVelocity:Destroy()
        FlyVelocity = nil
    end

    if FlyOrientation then
        FlyOrientation:Destroy()
        FlyOrientation = nil
    end

    if FlyAttachment then
        FlyAttachment:Destroy()
        FlyAttachment = nil
    end
end

function StopFly()
    DestroyFly()

    if Humanoid then
        Humanoid.AutoRotate =
            Config.AutoRotate
    end

    if Root then
        Root.AssemblyLinearVelocity =
            Vector3.zero
    end
end

function StartFly()
    if not isAlive() then
        return
    end

    DestroyFly()

    FlyAttachment = Instance.new("Attachment")
    FlyAttachment.Name = "DexiFlyAttachment"
    FlyAttachment.Parent = Root

    FlyVelocity = Instance.new("LinearVelocity")
    FlyVelocity.Name = "DexiFlyVelocity"
    FlyVelocity.Attachment0 = FlyAttachment
    FlyVelocity.RelativeTo =
        Enum.ActuatorRelativeTo.World
    FlyVelocity.VelocityConstraintMode =
        Enum.VelocityConstraintMode.Vector
    FlyVelocity.ForceLimitsEnabled = false
    FlyVelocity.VectorVelocity = Vector3.zero
    FlyVelocity.Parent = Root

    FlyOrientation = Instance.new("AlignOrientation")
    FlyOrientation.Name = "DexiFlyOrientation"
    FlyOrientation.Mode =
        Enum.OrientationAlignmentMode.OneAttachment
    FlyOrientation.Attachment0 =
        FlyAttachment
    FlyOrientation.RigidityEnabled = false
    FlyOrientation.MaxTorque = math.huge
    FlyOrientation.Responsiveness = 20
    FlyOrientation.Parent = Root

    Humanoid.AutoRotate = false
end

function UpdateFly()
    if not Config.Fly then
        if FlyVelocity or FlyOrientation then
            StopFly()
        end

        return
    end

    if not isAlive() then
        return
    end

    if not FlyVelocity or not FlyOrientation then
        StartFly()
    end

    if not FlyVelocity or not FlyOrientation then
        return
    end

    local camera = Camera

    local look = camera.CFrame.LookVector
    local right = camera.CFrame.RightVector

    local forward =
        safeUnit(
            Vector3.new(
                look.X,
                0,
                look.Z
            )
        )

    local rightFlat =
        safeUnit(
            Vector3.new(
                right.X,
                0,
                right.Z
            )
        )

    local move = Vector3.zero

    if UIS:IsKeyDown(Enum.KeyCode.W) then
        move += forward
    end

    if UIS:IsKeyDown(Enum.KeyCode.S) then
        move -= forward
    end

    if UIS:IsKeyDown(Enum.KeyCode.D) then
        move += rightFlat
    end

    if UIS:IsKeyDown(Enum.KeyCode.A) then
        move -= rightFlat
    end

    move = safeUnit(move)

    local vertical = 0

    if UIS:IsKeyDown(Enum.KeyCode.Space) then
        vertical += 1
    end

    if UIS:IsKeyDown(Enum.KeyCode.LeftControl)
        or UIS:IsKeyDown(Enum.KeyCode.LeftShift)
    then
        vertical -= 1
    end

    FlyVelocity.VectorVelocity =
        (
            move * Config.FlySpeed
        )
        +
        Vector3.new(
            0,
            vertical *
                Config.FlyVerticalSpeed,
            0
        )

    if Config.FlyFaceCamera then
        local flatLook =
            safeUnit(
                Vector3.new(
                    look.X,
                    0,
                    look.Z
                )
            )

        if flatLook.Magnitude > 0 then
            FlyOrientation.CFrame =
                CFrame.lookAt(
                    Vector3.zero,
                    flatLook
                )
        end
    end
end

