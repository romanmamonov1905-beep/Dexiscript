local function AddSlider(tab, name, minimum, maximum, default, key, callback)
	local parent = Db.Tabs[tab]

	if not parent then
		warn("Dexi: tab not found:", tab)
		return
	end

	local background = Instance.new("Frame")
	background.Name = key .. "Slider"
	background.Parent = parent
	background.Size = UDim2.new(1, -5, 0, 44)
	background.BackgroundColor3 = Color3.fromRGB(25, 19, 35)
	background.BorderSizePixel = 0

	local corner = Instance.new("UICorner")
	corner.Parent = background
	corner.CornerRadius = UDim.new(0, 6)

	local label = Instance.new("TextLabel")
	label.Parent = background
	label.Size = UDim2.new(1, -16, 0, 18)
	label.Position = UDim2.new(0, 8, 0, 2)
	label.BackgroundTransparency = 1
	label.Text = name .. ": " .. tostring(default)
	label.TextColor3 = Color3.fromRGB(170, 160, 180)
	label.Font = Enum.Font.GothamSemibold
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Parent = background
	track.Size = UDim2.new(1, -16, 0, 4)
	track.Position = UDim2.new(0, 8, 0, 28)
	track.BackgroundColor3 = Color3.fromRGB(45, 35, 55)
	track.BorderSizePixel = 0

	local trackCorner = Instance.new("UICorner")
	trackCorner.Parent = track
	trackCorner.CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Parent = track
	fill.Size = UDim2.new(
		math.clamp(
			(default - minimum) / (maximum - minimum),
			0,
			1
		),
		0,
		1,
		0
	)
	fill.BackgroundColor3 = Color3.fromRGB(140, 40, 255)
	fill.BorderSizePixel = 0

	local fillCorner = Instance.new("UICorner")
	fillCorner.Parent = fill
	fillCorner.CornerRadius = UDim.new(1, 0)

	Db.SliderValues[key] = default

	local dragging = false

	local function Update(input)
		local width = track.AbsoluteSize.X

		if width <= 0 then
			return
		end

		local relativeX =
			(input.Position.X - track.AbsolutePosition.X) / width

		local ratio = math.clamp(relativeX, 0, 1)

		local value =
			math.floor(
				minimum + (maximum - minimum) * ratio
			)

		fill.Size = UDim2.new(ratio, 0, 1, 0)

		label.Text = name .. ": " .. tostring(value)

		Db.SliderValues[key] = value

		callback(value)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			Update(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging
			and input.UserInputType == Enum.UserInputType.MouseMovement then

			Update(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if dragging then
				dragging = false

				Notify(
					name
						.. " -> "
						.. tostring(Db.SliderValues[key])
				)
			end
		end
	end)
end

--==================================================================================--
-- KEYBINDS
--==================================================================================--

Db.Connections.Keybinds = UserInputService.InputBegan:Connect(
	function(input, processed)
		if processed then
			return
		end

		if BindingKey and BindingButton then
			local bindData = Db.Keybinds[BindingKey]

			if not bindData then
				BindingKey = nil
				BindingButton = nil
				return
			end

			if input.KeyCode == Enum.KeyCode.Backspace then
				bindData.Key = nil
				BindingButton.Text = "NONE"
				Notify("Бинд сброшен")
			elseif input.KeyCode ~= Enum.KeyCode.Unknown then
				bindData.Key = input.KeyCode

				local keyName = input.KeyCode.Name
				BindingButton.Text = string.sub(keyName, 1, 5)

				Notify("Назначена клавиша: " .. keyName)
			end

			BindingKey = nil
			BindingButton = nil

			return
		end

		for _, bindData in pairs(Db.Keybinds) do
			if bindData.Key
				and input.KeyCode == bindData.Key then

				bindData.Action()
			end
		end
	end
)

