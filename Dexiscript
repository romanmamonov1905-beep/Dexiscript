function SetPage(name)
    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    for pageName, tab in pairs(Tabs) do
        tab.BackgroundColor3 =
            pageName == name
            and Theme.CardActive
            or Theme.Card
    end
end

