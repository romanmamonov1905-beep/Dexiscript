	if not Config.AirWalk
		or not Root
		or not Humanoid
	then
		return
	end

	if Humanoid.FloorMaterial == Enum.Material.Air then
		local origin = Root.Position

		local params = RaycastParams.new()
		params.FilterType =
			Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances =
			{Character}

		local result =
			Workspace:Raycast(
